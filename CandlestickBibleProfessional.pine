//@version=6
indicator("Candlestick Bible Professional V6", "CB Pro", overlay = true, max_lines_count = 500, max_labels_count = 500)

// --- INPUTS ---
grp_trend = "Step 1: Trend Identification"
trend_ma_type = input.string("EMA", "Trend MA Type", options = ["EMA", "SMA"], group = grp_trend)
trend_ma_len = input.int(25, "Trend MA Length", minval = 20, maxval = 30, group = grp_trend, tooltip = "Lookback of 20-30 candles to identify preceding trend")
use_adx_filter = input.bool(true, "Use ADX Filter (Sideways Avoidance)", group = grp_trend)
adx_len = input.int(14, "ADX Length", minval = 7, maxval = 30, group = grp_trend)
adx_threshold = input.int(20, "ADX Trend Threshold", minval = 10, maxval = 50, group = grp_trend)

grp_sr = "Step 2: S&R Key Levels"
pivot_lookback = input.int(5, "S&R Pivot Lookback", minval = 2, maxval = 50, group = grp_sr)
sr_buffer = input.float(0.15, "S&R Proximity Buffer %", minval = 0.01, maxval = 1.0, step = 0.05, group = grp_sr, tooltip = "Percentage buffer for price alignment with S&R")
max_levels = input.int(10, "Max Levels to Retain", minval = 5, maxval = 20, group = grp_sr)

grp_patterns = "Step 3: Pattern Quality Settings"
doji_threshold = input.float(0.1, "Doji Body Max % of Range", minval = 0.01, maxval = 0.3, step = 0.02, group = grp_patterns, tooltip = "Max body size relative to total range for Doji")
wick_multiplier = input.float(2.0, "Reversal Wick Multiplier", minval = 1.5, maxval = 5.0, step = 0.5, group = grp_patterns, tooltip = "Wick must be at least this many times the body size")

grp_dash = "Step 4 & Visuals"
show_dashboard = input.bool(true, "Show Table Dashboard", group = grp_dash)
dash_pos = input.string("top_right", "Dashboard Position", options = ["top_right", "top_left", "bottom_right", "bottom_left"], group = grp_dash)
show_sr_lines = input.bool(true, "Draw S&R Lines", group = grp_dash)

// --- BASIC MATH & UTILS ---
body_size = math.abs(close - open)
total_range = high - low
upper_wick = high - math.max(open, close)
lower_wick = math.min(open, close) - low

average_body = ta.sma(body_size, 20)
average_range = ta.sma(total_range, 20)

// --- STEP 1: IDENTIFY TREND ---
trend_ma = trend_ma_type == "EMA" ? ta.ema(close, trend_ma_len) : ta.sma(close, trend_ma_len)
is_bullish_trend = close > trend_ma
is_bearish_trend = close < trend_ma

[plus_di, minus_di, adx_val] = ta.dmi(adx_len, adx_len)
is_trending = not use_adx_filter or adx_val > adx_threshold

// Plot Trend MA
plot(trend_ma, "Trend MA", color = is_bullish_trend ? color.new(color.green, 50) : color.new(color.red, 50), linewidth = 2)

// --- STEP 2: KEY LEVELS (SUPPORT & RESISTANCE) ---
var float[] res_levels = array.new_float()
var line[] res_lines = array.new_line()
var float[] sup_levels = array.new_float()
var line[] sup_lines = array.new_line()

ph = ta.pivothigh(pivot_lookback, pivot_lookback)
pl = ta.pivotlow(pivot_lookback, pivot_lookback)

if not na(ph)
    array.push(res_levels, ph)
    line ln = na
    if show_sr_lines
        ln := line.new(bar_index[pivot_lookback], ph, bar_index, ph, color = color.new(color.red, 60), style = line.style_dashed, extend = extend.right)
    array.push(res_lines, ln)
    if array.size(res_levels) > max_levels
        array.remove(res_levels, 0)
        line deleted_line = array.remove(res_lines, 0)
        if not na(deleted_line)
            line.delete(deleted_line)

if not na(pl)
    array.push(sup_levels, pl)
    line ln = na
    if show_sr_lines
        ln := line.new(bar_index[pivot_lookback], pl, bar_index, pl, color = color.new(color.green, 60), style = line.style_dashed, extend = extend.right)
    array.push(sup_lines, ln)
    if array.size(sup_levels) > max_levels
        array.remove(sup_levels, 0)
        line deleted_line = array.remove(sup_lines, 0)
        if not na(deleted_line)
            line.delete(deleted_line)

// S&R Proximity Verification
at_resistance = false
float nearest_res = float(na)
float min_res_dist = float(na)
if array.size(res_levels) > 0
    for i = 0 to array.size(res_levels) - 1
        level = array.get(res_levels, i)
        dist = math.abs(close - level)
        if na(min_res_dist) or dist < min_res_dist
            min_res_dist := dist
            nearest_res := level
        if high >= level * (1 - sr_buffer/100) and low <= level * (1 + sr_buffer/100)
            at_resistance := true

at_support = false
float nearest_sup = float(na)
float min_sup_dist = float(na)
if array.size(sup_levels) > 0
    for i = 0 to array.size(sup_levels) - 1
        level = array.get(sup_levels, i)
        dist = math.abs(close - level)
        if na(min_sup_dist) or dist < min_sup_dist
            min_sup_dist := dist
            nearest_sup := level
        if low <= level * (1 + sr_buffer/100) and high >= level * (1 - sr_buffer/100)
            at_support := true

// --- STEP 3: PATTERN QUALITY SPECS ---

// 1. REVERSALS
// Bullish Engulfing
is_bullish_engulfing = (close[1] < open[1]) and (close > open) and (open <= close[1]) and (close >= open[1]) and (body_size > body_size[1]) and (body_size >= average_body * 0.8)

// Bearish Engulfing
is_bearish_engulfing = (close[1] > open[1]) and (close < open) and (open >= close[1]) and (close <= open[1]) and (body_size > body_size[1]) and (body_size >= average_body * 0.8)

// Hammer
is_hammer = (total_range > 0) and (lower_wick >= body_size * wick_multiplier) and (upper_wick <= total_range * 0.15) and (body_size > 0) and (total_range >= average_range * 0.5)

// Shooting Star
is_shooting_star = (total_range > 0) and (upper_wick >= body_size * wick_multiplier) and (lower_wick <= total_range * 0.15) and (body_size > 0) and (total_range >= average_range * 0.5)

// Morning Star (3-candle sequence)
is_morning_star = (close[2] < open[2]) and (body_size[2] >= average_body * 0.7) and (body_size[1] <= average_body * 0.5) and (close > open) and (close >= open[2] - body_size[2] * 0.5)

// Evening Star (3-candle sequence)
is_evening_star = (close[2] > open[2]) and (body_size[2] >= average_body * 0.7) and (body_size[1] <= average_body * 0.5) and (close < open) and (close <= open[2] + body_size[2] * 0.5)


// 2. CONTINUATIONS
// Three White Soldiers
is_three_white_soldiers = (close > open) and (close[1] > open[1]) and (close[2] > open[2]) and (upper_wick <= total_range * 0.15) and (upper_wick[1] <= total_range[1] * 0.15) and (upper_wick[2] <= total_range[2] * 0.15) and (body_size >= average_body * 0.5) and (body_size[1] >= average_body * 0.5) and (body_size[2] >= average_body * 0.5)

// Three Black Crows
is_three_black_crows = (close < open) and (close[1] < open[1]) and (close[2] < open[2]) and (lower_wick <= total_range * 0.15) and (lower_wick[1] <= total_range[1] * 0.15) and (lower_wick[2] <= total_range[2] * 0.15) and (body_size >= average_body * 0.5) and (body_size[1] >= average_body * 0.5) and (body_size[2] >= average_body * 0.5)

// Momentum Candle (Marubozu)
is_marubozu = (body_size >= average_body * 2.0) and (upper_wick <= total_range * 0.05) and (lower_wick <= total_range * 0.05)
is_bull_marubozu = is_marubozu and close > open
is_bear_marubozu = is_marubozu and close < open

// Rising Three Methods (5-candle sequence)
is_rising_three_methods = (close[4] > open[4]) and (body_size[4] >= average_body * 1.3) and (high[3] < high[4] and low[3] > low[4]) and (high[2] < high[4] and low[2] > low[4]) and (high[1] < high[4] and low[1] > low[4]) and (body_size[3] < average_body and body_size[2] < average_body and body_size[1] < average_body) and (close > open) and (close > high[4])

// Falling Three Methods (5-candle sequence)
is_falling_three_methods = (close[4] < open[4]) and (body_size[4] >= average_body * 1.3) and (high[3] < high[4] and low[3] > low[4]) and (high[2] < high[4] and low[2] > low[4]) and (high[1] < high[4] and low[1] > low[4]) and (body_size[3] < average_body and body_size[2] < average_body and body_size[1] < average_body) and (close < open) and (close < low[4])


// 3. INDECISION
is_classic_doji = (total_range > 0) and (body_size <= total_range * doji_threshold)
is_long_legged_doji = is_classic_doji and (total_range >= average_range * 1.5) and (upper_wick >= total_range * 0.3) and (lower_wick >= total_range * 0.3)
is_spinning_top = (body_size > total_range * doji_threshold) and (body_size <= average_body * 0.6) and (upper_wick >= body_size) and (lower_wick >= body_size)


// Combined Classifications
potential_bullish_reversal = is_bullish_engulfing or is_hammer or is_morning_star
potential_bearish_reversal = is_bearish_engulfing or is_shooting_star or is_evening_star

potential_continuation_bullish = is_three_white_soldiers or is_bull_marubozu or is_rising_three_methods
potential_continuation_bearish = is_three_black_crows or is_bear_marubozu or is_falling_three_methods

potential_indecision = is_long_legged_doji or is_classic_doji or is_spinning_top


// --- STEP 4: WAIT FOR CLOSE & CONFIRMATION ---

// 1. Reversals: Candle-Over-Candle Confirmation on Completed Reversal at Key Level
// Bullish Reversal at Support
var bool rev_bull_pending = false
var float rev_bull_high = float(na)
if potential_bullish_reversal[1] and at_support[1] and is_trending[1]
    rev_bull_pending := true
    rev_bull_high := high[1]

buy_signal = rev_bull_pending and close > rev_bull_high
if buy_signal
    rev_bull_pending := false
    rev_bull_high := float(na)
// Reset pending after 3 candles to avoid outdated signals
if ta.change(time) != 0 and rev_bull_pending
    rev_bull_pending := false

// Bearish Reversal at Resistance
var bool rev_bear_pending = false
var float rev_bear_low = float(na)
if potential_bearish_reversal[1] and at_resistance[1] and is_trending[1]
    rev_bear_pending := true
    rev_bear_low := low[1]

sell_signal = rev_bear_pending and close < rev_bear_low
if sell_signal
    rev_bear_pending := false
    rev_bear_low := float(na)
if ta.change(time) != 0 and rev_bear_pending
    rev_bear_pending := false

// 2. Indecision breakout confirmation: Dojis / Spinning Tops at S&R
var float ind_high = float(na)
var float ind_low = float(na)
var int ind_age = 0

if potential_indecision[1] and (at_support[1] or at_resistance[1])
    ind_high := high[1]
    ind_low := low[1]
    ind_age := 1

ind_buy_signal = false
ind_sell_signal = false

if not na(ind_high)
    if close > ind_high
        ind_buy_signal := true
        ind_high := float(na)
        ind_low := float(na)
        ind_age := 0
    else if close < ind_low
        ind_sell_signal := true
        ind_high := float(na)
        ind_low := float(na)
        ind_age := 0
    else
        ind_age := ind_age + 1
        if ind_age > 3 // Reset if breakout doesn't happen within 3 candles
            ind_high := float(na)
            ind_low := float(na)
            ind_age := 0


// --- DASHBOARD TABLE ---
var table dash_table = table.new(position = dash_pos == "top_right" ? position.top_right : dash_pos == "top_left" ? position.top_left : dash_pos == "bottom_right" ? position.bottom_right : position.bottom_left, columns = 2, rows = 6, bgcolor = color.new(color.black, 15), border_color = color.gray, border_width = 1)

// Helper to determine last pattern text
var string last_pat_name = "None"
var string last_pat_type = "None"
var string last_pat_quality = "None"

if potential_bullish_reversal
    last_pat_name := is_bullish_engulfing ? "Bull Engulfing" : is_hammer ? "Hammer" : "Morning Star"
    last_pat_type := "Bull Reversal"
    last_pat_quality := "Excellent"
else if potential_bearish_reversal
    last_pat_name := is_bearish_engulfing ? "Bear Engulfing" : is_shooting_star ? "Shooting Star" : "Evening Star"
    last_pat_type := "Bear Reversal"
    last_pat_quality := "Excellent"
else if potential_continuation_bullish
    last_pat_name := is_three_white_soldiers ? "3 Soldiers" : is_bull_marubozu ? "Bull Marubozu" : "Rising 3 Methods"
    last_pat_type := "Bull Continuation"
    last_pat_quality := "Excellent"
else if potential_continuation_bearish
    last_pat_name := is_three_black_crows ? "3 Crows" : is_bear_marubozu ? "Bear Marubozu" : "Falling 3 Methods"
    last_pat_type := "Bear Continuation"
    last_pat_quality := "Excellent"
else if potential_indecision
    last_pat_name := is_long_legged_doji ? "Long-Leg Doji" : is_classic_doji ? "Classic Doji" : "Spinning Top"
    last_pat_type := "Indecision"
    last_pat_quality := "Standard"

if barstate.islast and show_dashboard
    table.cell(dash_table, 0, 0, "CB Pro Dashboard", text_color = color.white, bgcolor = color.gray, text_size = size.small)
    table.cell(dash_table, 1, 0, "Status", text_color = color.white, bgcolor = color.gray, text_size = size.small)

    // Trend status
    trend_txt = is_trending ? (is_bullish_trend ? "Bullish (Trending)" : "Bearish (Trending)") : "Sideways"
    color trend_color = is_trending ? (is_bullish_trend ? color.green : color.red) : color.orange
    table.cell(dash_table, 0, 1, "Market Trend", text_color = color.white, text_size = size.small)
    table.cell(dash_table, 1, 1, trend_txt, text_color = color.white, bgcolor = trend_color, text_size = size.small)

    // Nearest levels
    table.cell(dash_table, 0, 2, "Nearest Key Support", text_color = color.white, text_size = size.small)
    table.cell(dash_table, 1, 2, na(nearest_sup) ? "None" : str.tostring(nearest_sup, "#.##"), text_color = color.white, bgcolor = color.green, text_size = size.small)

    table.cell(dash_table, 0, 3, "Nearest Key Resistance", text_color = color.white, text_size = size.small)
    table.cell(dash_table, 1, 3, na(nearest_res) ? "None" : str.tostring(nearest_res, "#.##"), text_color = color.white, bgcolor = color.red, text_size = size.small)

    // Pattern Name
    table.cell(dash_table, 0, 4, "Last Candlestick Pattern", text_color = color.white, text_size = size.small)
    table.cell(dash_table, 1, 4, last_pat_name + " (" + last_pat_type + ")", text_color = color.white, text_size = size.small)

    // Quality check status
    table.cell(dash_table, 0, 5, "Pattern Quality", text_color = color.white, text_size = size.small)
    table.cell(dash_table, 1, 5, last_pat_quality, text_color = color.white, bgcolor = last_pat_quality == "Excellent" ? color.green : color.gray, text_size = size.small)

// --- VISUAL PLOTS ---

// Setup markers (smaller)
plotshape(potential_bullish_reversal and at_support, "Bull Reversal Setup", shape.triangleup, location.belowbar, color.new(color.green, 40), size=size.tiny)
plotshape(potential_bearish_reversal and at_resistance, "Bear Reversal Setup", shape.triangledown, location.abovebar, color.new(color.red, 40), size=size.tiny)

plotshape(potential_continuation_bullish and is_bullish_trend, "Bull Continuation Setup", shape.arrowup, location.belowbar, color.new(color.teal, 40), size=size.tiny)
plotshape(potential_continuation_bearish and is_bearish_trend, "Bear Continuation Setup", shape.arrowdown, location.abovebar, color.new(color.orange, 40), size=size.tiny)

plotshape(potential_indecision and (at_support or at_resistance), "Indecision Level Setup", shape.diamond, location.abovebar, color.new(color.yellow, 40), size=size.tiny)

// Confirmed entry signals (rendered as pure text directly on chart, with absolutely no background labels or shapes)
plotshape(buy_signal, "BUY Entry (Reversal Confirmed)", style = shape.none, location = location.belowbar, text = "BUY", textcolor = color.green, size = size.small)
plotshape(sell_signal, "SELL Entry (Reversal Confirmed)", style = shape.none, location = location.abovebar, text = "SELL", textcolor = color.red, size = size.small)

plotshape(ind_buy_signal, "BUY Entry (Indecision Breakout Confirmed)", style = shape.none, location = location.belowbar, text = "IND BUY", textcolor = color.green, size = size.small)
plotshape(ind_sell_signal, "SELL Entry (Indecision Breakout Confirmed)", style = shape.none, location = location.abovebar, text = "IND SELL", textcolor = color.red, size = size.small)

// --- ALERTS ---
alertcondition(buy_signal, "Confirmed Reversal Buy Signal", "Strong Candle-Over-Candle Bullish Reversal Confirmation Achieved!")
alertcondition(sell_signal, "Confirmed Reversal Sell Signal", "Strong Candle-Over-Candle Bearish Reversal Confirmation Achieved!")
alertcondition(ind_buy_signal, "Confirmed Indecision Buy Breakout", "Indecision Pattern Bullish Breakout Confirmed!")
alertcondition(ind_sell_signal, "Confirmed Indecision Sell Breakout", "Indecision Pattern Bearish Breakout Confirmed!")
