//@version=6
indicator("5pm Candle Strategy Signals", overlay=true)

// --- Inputs ---
i_timezone = input.string("UTC+3", "Timezone", tooltip="Kenyan Time (Nairobi / EAT)")
i_seasonality = input.bool(true, "Enable July-Sept Seasonality Filter", tooltip="The strategy is designed to work best during July through September")
i_wednesday_only = input.bool(false, "Wednesday Only Filter", tooltip="Wednesday is identified as a primary distribution day")
i_tp_rr = input.float(3.0, "Take Profit (Risk:Reward)", minval=0.1, step=0.1)

// --- Time Logic ---
is_july_sept = month(time, i_timezone) >= 7 and month(time, i_timezone) <= 9
is_wednesday = dayofweek(time, i_timezone) == dayofweek.wednesday

seasonality_ok = (not i_seasonality or is_july_sept)
wednesday_ok = (not i_wednesday_only or is_wednesday)
filter_ok = seasonality_ok and wednesday_ok

// Windows (Kenyan Time)
t_hour = hour(time, i_timezone)
t_min = minute(time, i_timezone)

// Pre-session clues: 4:30 PM - 4:40 PM
is_pre_session = timeframe.isintraday and t_hour == 16 and t_min >= 30 and t_min < 40
// The 5:00 PM 1-minute candle
is_five_pm_candle = timeframe.isintraday and timeframe.multiplier == 1 and t_hour == 17 and t_min == 0
// The 10-minute anchor window: 5:00 PM - 5:10 PM
is_ten_min_window = timeframe.isintraday and t_hour == 17 and t_min < 10

// --- State Variables ---
var float pre_high = na
var float pre_low = na
var float anchor_high = na
var float anchor_low = na
var bool setup_triggered = false
var int signal_dir = 0 // 1 for Buy, -1 for Sell
var float signal_sl = na
var float signal_tp = na

// Reset at start of pre-session
if t_hour == 16 and t_min == 0
    pre_high := na
    pre_low := na
    anchor_high := na
    anchor_low := na
    setup_triggered := false
    signal_dir := 0
    signal_sl := na
    signal_tp := na

// Capture Pre-Session High/Low (4:30 - 4:40) as "Banking Level" clues
if is_pre_session
    pre_high := na(pre_high) ? high : math.max(pre_high, high)
    pre_low := na(pre_low) ? low : math.min(pre_low, low)

// Capture 10-Min Window High/Low (5:00 - 5:10)
if is_ten_min_window
    anchor_high := na(anchor_high) ? high : math.max(anchor_high, high)
    anchor_low := na(anchor_low) ? low : math.min(anchor_low, low)

// --- Signal Generation ---
tapped_pre_high = not na(pre_high) and high >= pre_high
tapped_pre_low = not na(pre_low) and low <= pre_low

// Detect if 5:00 PM candle *closes*
is_five_pm_close = is_five_pm_candle

if filter_ok and not setup_triggered and is_ten_min_window
    // Immediate signal on the 5pm 1-min candle close if it tapped
    if is_five_pm_close
        if tapped_pre_high
            signal_dir := -1
            signal_sl := anchor_high
            signal_tp := close - (math.abs(close - anchor_high) * i_tp_rr)
            setup_triggered := true
        else if tapped_pre_low
            signal_dir := 1
            signal_sl := anchor_low
            signal_tp := close + (math.abs(close - anchor_low) * i_tp_rr)
            setup_triggered := true

    // Delayed signal within the 10-min window
    if not setup_triggered
        if tapped_pre_high
            signal_dir := -1
            signal_sl := anchor_high
            signal_tp := close - (math.abs(close - anchor_high) * i_tp_rr)
            setup_triggered := true
        else if tapped_pre_low
            signal_dir := 1
            signal_sl := anchor_low
            signal_tp := close + (math.abs(close - anchor_low) * i_tp_rr)
            setup_triggered := true

// --- Visualizations ---
bgcolor(is_pre_session ? color.new(color.blue, 90) : na, title="Pre-Session Window (4:30-4:40)")
bgcolor(is_ten_min_window ? color.new(color.yellow, 90) : na, title="10-Min Anchor Window (5:00-5:10)")
barcolor(is_five_pm_candle ? color.fuchsia : na, title="5PM Critical Candle")

// Plot targets
plot(pre_high, "Banking Level High", color.red, style=plot.style_linebr, linewidth=1)
plot(pre_low, "Banking Level Low", color.green, style=plot.style_linebr, linewidth=1)

// Signals and Levels
plotshape(ta.change(setup_triggered) and setup_triggered and signal_dir == 1, "Buy Signal", shape.triangleup, location.belowbar, color.green, size=size.small, text="BUY")
plotshape(ta.change(setup_triggered) and setup_triggered and signal_dir == -1, "Sell Signal", shape.triangledown, location.abovebar, color.red, size=size.small, text="SELL")

plot(signal_sl, "Stop Loss", color.maroon, style=plot.style_linebr, linewidth=2)
plot(signal_tp, "Take Profit", color.teal, style=plot.style_linebr, linewidth=2)

// Dashboard
var table dash = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 50), border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "5PM Signals", text_color=color.white)
    table.cell(dash, 1, 0, "Status", text_color=color.white)
    table.cell(dash, 0, 1, "Seasonality", text_color=color.white)
    table.cell(dash, 1, 1, seasonality_ok ? "Active" : "Off", text_color=seasonality_ok ? color.green : color.red)
    table.cell(dash, 0, 2, "Wednesday", text_color=color.white)
    table.cell(dash, 1, 2, is_wednesday ? "Yes" : "No", text_color=is_wednesday ? color.green : color.yellow)
    table.cell(dash, 0, 3, "Setup Today", text_color=color.white)
    table.cell(dash, 1, 3, setup_triggered ? "Generated" : "Waiting", text_color=setup_triggered ? color.green : color.white)
