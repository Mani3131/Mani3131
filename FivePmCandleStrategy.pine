//@version=6
strategy("5pm Candle Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.fixed, currency=currency.USD)

// --- Inputs ---
i_timezone = input.string("UTC+3", "Timezone", tooltip="Kenyan Time (Nairobi / EAT)")
i_seasonality = input.bool(true, "Enable July-Sept Seasonality Filter", tooltip="The strategy is designed to work best during July through September")
i_wednesday_only = input.bool(false, "Wednesday Only Filter", tooltip="Wednesday is identified as a primary distribution day")
i_risk_pct = input.float(1.0, "Risk Per Trade (%)", minval=0.1, maxval=10.0) / 100

// --- Time Logic ---
is_july_sept = month(time, i_timezone) >= 7 and month(time, i_timezone) <= 9
is_wednesday = dayofweek(time, i_timezone) == dayofweek.wednesday

seasonality_ok = (not i_seasonality or is_july_sept)
wednesday_ok = (not i_wednesday_only or is_wednesday)
filter_ok = seasonality_ok and wednesday_ok

// Windows (Kenyan Time)
t_hour = hour(time, i_timezone)
t_min = minute(time, i_timezone)

// Pre-session clues: 4:30 PM - 4:40 PM
is_pre_session = timeframe.isintraday and t_hour == 16 and t_min >= 30 and t_min < 40
// The 5:00 PM 1-minute candle
is_five_pm_candle = timeframe.isintraday and timeframe.multiplier == 1 and t_hour == 17 and t_min == 0
// The 10-minute anchor window: 5:00 PM - 5:10 PM
is_ten_min_window = timeframe.isintraday and t_hour == 17 and t_min < 10

// --- State Variables ---
var float pre_high = na
var float pre_low = na
var float anchor_high = na
var float anchor_low = na
var bool setup_triggered = false

// Reset at start of pre-session
if t_hour == 16 and t_min == 0
    pre_high := na
    pre_low := na
    anchor_high := na
    anchor_low := na
    setup_triggered := false

// Capture Pre-Session High/Low (4:30 - 4:40) as "Banking Level" clues
if is_pre_session
    pre_high := na(pre_high) ? high : math.max(pre_high, high)
    pre_low := na(pre_low) ? low : math.min(pre_low, low)

// Capture 10-Min Window High/Low (5:00 - 5:10)
if is_ten_min_window
    anchor_high := na(anchor_high) ? high : math.max(anchor_high, high)
    anchor_low := na(anchor_low) ? low : math.min(anchor_low, low)

// --- Strategy Entry ---
// Entry Clue: "If the market does not immediately hit the banking level on the very first minute,
// it typically completes the run within the first 10 minutes of the hour."
// Target: High or Low of the pre-session (4:30-4:40)

tapped_pre_high = not na(pre_high) and high >= pre_high
tapped_pre_low = not na(pre_low) and low <= pre_low

// Entry Condition: Close of the 5:00 PM candle if it tapped the level
// OR anytime within the first 10 mins if it taps.
// Big Boss says: "Positions are typically opened immediately after the first 1-minute candle of 5:00 PM closes"

// Detect if 5:00 PM candle *closes*
is_five_pm_close = is_five_pm_candle

if filter_ok and not setup_triggered and is_ten_min_window
    // Immediate entry on the 5pm 1-min candle close if it tapped
    if is_five_pm_close
        if tapped_pre_high
            float risk = math.abs(close - anchor_high)
            float qty = risk > 0 ? (strategy.equity * i_risk_pct) / risk : na
            strategy.entry("5PM Sell", strategy.short, qty=qty, comment="5PM Close Sell")
            setup_triggered := true
        else if tapped_pre_low
            float risk = math.abs(close - anchor_low)
            float qty = risk > 0 ? (strategy.equity * i_risk_pct) / risk : na
            strategy.entry("5PM Buy", strategy.long, qty=qty, comment="5PM Close Buy")
            setup_triggered := true

    // Delayed entry within the 10-min window if 5pm candle didn't tap but subsequent bars did
    if not setup_triggered
        if tapped_pre_high
            float risk = math.abs(close - anchor_high)
            float qty = risk > 0 ? (strategy.equity * i_risk_pct) / risk : na
            strategy.entry("5PM Sell", strategy.short, qty=qty, comment="10min Window Sell")
            setup_triggered := true
        else if tapped_pre_low
            float risk = math.abs(close - anchor_low)
            float qty = risk > 0 ? (strategy.equity * i_risk_pct) / risk : na
            strategy.entry("5PM Buy", strategy.long, qty=qty, comment="10min Window Buy")
            setup_triggered := true

// --- Risk Management ---
// Stop Loss: Above/Below the 10-minute window (5:00 - 5:10)
// Must be set AFTER the 10-minute window is complete or updated dynamically
if strategy.position_size != 0
    if strategy.position_size > 0
        strategy.exit("SL Buy", "5PM Buy", stop=anchor_low, comment_loss="SL 10min Low")
    else if strategy.position_size < 0
        strategy.exit("SL Sell", "5PM Sell", stop=anchor_high, comment_loss="SL 10min High")

// Long term hold (2-24 hours) - for now just leave it open, user can close manually or set a TP.
// The prompt says "hold as intraday swing positions for anywhere from 2 to 24 hours"
// Let's add an optional exit after 4 hours as a default.
i_hold_time = input.int(4, "Default Hold Time (Hours)", minval=1, maxval=24)
if strategy.position_size != 0
    if time - strategy.opentrades.entry_time(strategy.opentrades - 1) >= i_hold_time * 3600000
        strategy.close_all(comment="Hold Time Met")

// --- Visualizations ---
bgcolor(is_pre_session ? color.new(color.blue, 90) : na, title="Pre-Session Window (4:30-4:40)")
bgcolor(is_ten_min_window ? color.new(color.yellow, 90) : na, title="10-Min Anchor Window (5:00-5:10)")
barcolor(is_five_pm_candle ? color.fuchsia : na, title="5PM Critical Candle")

// Plot targets
plot(pre_high, "Banking Level High (Target)", color.red, style=plot.style_linebr, linewidth=2)
plot(pre_low, "Banking Level Low (Target)", color.green, style=plot.style_linebr, linewidth=2)

// Plot Anchor SL
plot(is_ten_min_window or strategy.position_size != 0 ? anchor_high : na, "Anchor Window High (SL)", color.maroon, style=plot.style_linebr, linewidth=1)
plot(is_ten_min_window or strategy.position_size != 0 ? anchor_low : na, "Anchor Window Low (SL)", color.green, style=plot.style_linebr, linewidth=1)

// Entry Labels
if ta.change(setup_triggered) and setup_triggered
    label.new(bar_index, strategy.position_size > 0 ? low : high,
              text=strategy.position_size > 0 ? "5PM BUY" : "5PM SELL",
              color=strategy.position_size > 0 ? color.green : color.red,
              textcolor=color.white,
              style=strategy.position_size > 0 ? label.style_label_up : label.style_label_down)

// Dashboard
var table dash = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 50), border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "5PM Strategy", text_color=color.white)
    table.cell(dash, 1, 0, "Status", text_color=color.white)
    table.cell(dash, 0, 1, "Seasonality", text_color=color.white)
    table.cell(dash, 1, 1, seasonality_ok ? "Active" : "Off", text_color=seasonality_ok ? color.green : color.red)
    table.cell(dash, 0, 2, "Wednesday", text_color=color.white)
    table.cell(dash, 1, 2, is_wednesday ? "Yes" : "No", text_color=is_wednesday ? color.green : color.yellow)
    table.cell(dash, 0, 3, "Setup Today", text_color=color.white)
    table.cell(dash, 1, 3, setup_triggered ? "Executed" : "Waiting", text_color=setup_triggered ? color.green : color.white)
