//@version=6
strategy("Supply and Demand Four Core Formations", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=1)

// --- Inputs ---
group_viz = "Visualization Settings"
supply_color_input = input.color(color.new(color.red, 90), "Supply Zone Color", group=group_viz)
demand_color_input = input.color(color.new(color.blue, 90), "Demand Zone Color", group=group_viz)
max_ltf_boxes = input.int(20, "Max Historical LTF Boxes", minval=1, group=group_viz)
max_htf_boxes = input.int(10, "Max Historical HTF Boxes", minval=1, group=group_viz)

group_trend = "Trend Filtering"
use_trend_filter = input.bool(true, "Enable Trend Filter", group=group_trend)
trend_ema_length = input.int(200, "Trend EMA Length", minval=1, group=group_trend)
htf_tf = input.timeframe("240", "Higher Timeframe", group=group_trend)
use_htf_invalidation = input.bool(true, "Use 50% HTF Zone Invalidation", group=group_trend)

group_risk = "Risk Management"
rr_ratio = input.float(3.0, "Reward-to-Risk Ratio", minval=0.1, step=0.1, group=group_risk)

// --- Candle Classification Functions ---
is_base() =>
    body_size = math.abs(close - open)
    candle_range = high - low
    candle_range > 0 and body_size <= 0.5 * candle_range

is_decisive() =>
    body_size = math.abs(close - open)
    candle_range = high - low
    candle_range > 0 and body_size > 0.5 * candle_range

is_rally() =>
    is_decisive() and close > open

is_drop() =>
    is_decisive() and close < open

is_explosive(avg_body) =>
    body_size = math.abs(close - open)
    is_decisive() and body_size > 1.5 * avg_body

// --- Global Variables ---
var box[] ltf_boxes = array.new_box()
var box[] htf_s_boxes = array.new_box()
var box[] htf_d_boxes = array.new_box()

// HTF Zone Data (Arrays)
var float[] htf_s_highs = array.new_float()
var float[] htf_s_lows = array.new_float()
var float[] htf_d_highs = array.new_float()
var float[] htf_d_lows = array.new_float()

// --- HTF Data Extraction ---
get_htf_zones(avg_body) =>
    _is_base = is_base()
    _is_rally = is_rally()
    _is_drop = is_drop()
    _is_explosive = is_explosive(avg_body)

    _is_rbd = _is_rally[2] and _is_base[1] and _is_drop and _is_explosive
    _is_dbd = _is_drop[2] and _is_base[1] and _is_drop and _is_explosive
    _is_rbr = _is_rally[2] and _is_base[1] and _is_rally and _is_explosive
    _is_dbr = _is_drop[2] and _is_base[1] and _is_rally and _is_explosive

    [ _is_rbd or _is_dbd, _is_rbr or _is_dbr, high[1], low[1] ]

htf_avg_body = request.security(syminfo.tickerid, htf_tf, ta.sma(math.abs(close - open), 10))
[htf_s_found, htf_d_found, htf_zh, htf_zl] = request.security(syminfo.tickerid, htf_tf, get_htf_zones(htf_avg_body))

// Detect New HTF Bar to prevent duplication
is_new_htf_bar = ta.change(time(htf_tf)) != 0

if is_new_htf_bar
    if htf_s_found
        array.push(htf_s_highs, htf_zh)
        array.push(htf_s_lows, htf_zl)
        nb = box.new(bar_index, htf_zh, bar_index + 10, htf_zl,
                      bgcolor=color.new(color.red, 95), border_color=color.new(color.red, 70),
                      extend=extend.right, text="HTF SUPPLY", text_color=color.red, text_size=size.tiny)
        array.push(htf_s_boxes, nb)

    if htf_d_found
        array.push(htf_d_highs, htf_zh)
        array.push(htf_d_lows, htf_zl)
        nb = box.new(bar_index, htf_zh, bar_index + 10, htf_zl,
                      bgcolor=color.new(color.blue, 95), border_color=color.new(color.blue, 70),
                      extend=extend.right, text="HTF DEMAND", text_color=color.blue, text_size=size.tiny)
        array.push(htf_d_boxes, nb)

// Prune HTF
if array.size(htf_s_boxes) > max_htf_boxes
    box.delete(array.shift(htf_s_boxes))
    array.shift(htf_s_highs)
    array.shift(htf_s_lows)

if array.size(htf_d_boxes) > max_htf_boxes
    box.delete(array.shift(htf_d_boxes))
    array.shift(htf_d_highs)
    array.shift(htf_d_lows)

// HTF Invalidation Logic
if use_htf_invalidation
    if array.size(htf_s_highs) > 0
        for i = array.size(htf_s_highs) - 1 to 0
            sh = array.get(htf_s_highs, i)
            sl = array.get(htf_s_lows, i)
            if high > sl + (sh - sl) * 0.5
                box.delete(array.get(htf_s_boxes, i))
                array.remove(htf_s_boxes, i)
                array.remove(htf_s_highs, i)
                array.remove(htf_s_lows, i)

    if array.size(htf_d_highs) > 0
        for i = array.size(htf_d_highs) - 1 to 0
            dh = array.get(htf_d_highs, i)
            dl = array.get(htf_d_lows, i)
            if low < dl + (dh - dl) * 0.5
                box.delete(array.get(htf_d_boxes, i))
                array.remove(htf_d_boxes, i)
                array.remove(htf_d_highs, i)
                array.remove(htf_d_lows, i)

// --- Main Logic ---
ltf_avg_body = ta.sma(math.abs(close - open), 10)
trend_ema = ta.ema(close, trend_ema_length)
is_uptrend = not use_trend_filter or close > trend_ema
is_downtrend = not use_trend_filter or close < trend_ema

plot(trend_ema, "Trend EMA", color.gray)

// Alignment Check
check_s_align(lh, ll) =>
    aligned = false
    if array.size(htf_s_highs) > 0
        for i = 0 to array.size(htf_s_highs) - 1
            sh = array.get(htf_s_highs, i)
            sl = array.get(htf_s_lows, i)
            if lh <= sh + (sh-sl)*0.05 and ll >= sl - (sh-sl)*0.05
                aligned := true
                break
    aligned

check_d_align(lh, ll) =>
    aligned = false
    if array.size(htf_d_highs) > 0
        for i = 0 to array.size(htf_d_highs) - 1
            dh = array.get(htf_d_highs, i)
            dl = array.get(htf_d_lows, i)
            if lh <= dh + (dh-dl)*0.05 and ll >= dl - (dh-dl)*0.05
                aligned := true
                break
    aligned

// LTF Detection
is_rbd = is_rally()[2] and is_base()[1] and is_drop() and is_explosive(ltf_avg_body)
is_dbd = is_drop()[2] and is_base()[1] and is_drop() and is_explosive(ltf_avg_body)
is_rbr = is_rally()[2] and is_base()[1] and is_rally() and is_explosive(ltf_avg_body)
is_dbr = is_drop()[2] and is_base()[1] and is_rally() and is_explosive(ltf_avg_body)

var float active_sh = na
var float active_sl = na
var float active_dh = na
var float active_dl = na

// Refine to the specific 'Base' candle body/wick as per user tactics
refine_high = high[1]
refine_low = low[1]

if (is_rbd or is_dbd) and is_downtrend and check_s_align(high[1], low[1])
    active_sh := refine_high
    active_sl := refine_low
    nb = box.new(bar_index[1], active_sh, bar_index + 5, active_sl,
                 bgcolor=supply_color_input, border_color=color.new(supply_color_input, 40),
                 extend=extend.right, text="ALIGNED SUPPLY", text_color=color.red, text_size=size.tiny)
    array.push(ltf_boxes, nb)

if (is_rbr or is_dbr) and is_uptrend and check_d_align(high[1], low[1])
    active_dh := refine_high
    active_dl := refine_low
    nb = box.new(bar_index[1], active_dh, bar_index + 5, active_dl,
                 bgcolor=demand_color_input, border_color=color.new(demand_color_input, 40),
                 extend=extend.right, text="ALIGNED DEMAND", text_color=color.blue, text_size=size.tiny)
    array.push(ltf_boxes, nb)

// Prune LTF
if array.size(ltf_boxes) > max_ltf_boxes
    box.delete(array.shift(ltf_boxes))

// Re-test Entry
retest_s = not na(active_sh) and high >= active_sl
retest_d = not na(active_dh) and low <= active_dh

can_enter = not (is_rbd or is_dbd or is_rbr or is_dbr)

if retest_d and can_enter and is_uptrend and check_d_align(active_dh, active_dl) and strategy.position_size == 0
    sl = active_dl
    tp = close + (close - sl) * rr_ratio
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit Long", "Long", stop=sl, limit=tp)
    active_dh := na

if retest_s and can_enter and is_downtrend and check_s_align(active_sh, active_sl) and strategy.position_size == 0
    sl = active_sh
    tp = close - (sl - close) * rr_ratio
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit Short", "Short", stop=sl, limit=tp)
    active_sh := na

// LTF Invalidation
if not na(active_sh) and high > active_sl + (active_sh - active_sl) * 0.5
    active_sh := na
if not na(active_dh) and low < active_dl + (active_dh - active_dl) * 0.5
    active_dh := na

plotshape((is_rbd or is_dbd) and check_s_align(high[1], low[1]), "Supply", shape.triangledown, location.abovebar, color.red, size=size.small)
plotshape((is_rbr or is_dbr) and check_d_align(high[1], low[1]), "Demand", shape.triangleup, location.belowbar, color.blue, size=size.small)
