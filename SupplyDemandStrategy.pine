//@version=6
strategy("Supply and Demand Four Core Formations", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=1)

// --- Inputs ---
group_viz = "Visualization Settings"
supply_color = input.color(color.new(color.red, 90), "Supply Zone Color", group=group_viz)
demand_color = input.color(color.new(color.blue, 90), "Demand Zone Color", group=group_viz)
max_boxes = input.int(20, "Max Historical Zones", minval=1, group=group_viz)

group_trend = "Trend Filtering"
use_trend_filter = input.bool(true, "Enable Trend Filter", group=group_trend)
trend_ema_length = input.int(200, "Trend EMA Length", minval=1, group=group_trend)

group_risk = "Risk Management"
rr_ratio = input.float(3.0, "Reward-to-Risk Ratio", minval=0.1, step=0.1, group=group_risk)

// --- Candle Classification Functions ---
is_base() =>
    body_size = math.abs(close - open)
    candle_range = high - low
    candle_range > 0 and body_size <= 0.5 * candle_range

is_decisive() =>
    body_size = math.abs(close - open)
    candle_range = high - low
    candle_range > 0 and body_size > 0.5 * candle_range

is_rally() =>
    is_decisive() and close > open

is_drop() =>
    is_decisive() and close < open

is_explosive() =>
    body_size = math.abs(close - open)
    avg_body = ta.sma(body_size, 10)
    is_decisive() and body_size > 1.5 * avg_body

// --- Global Variables ---
var box[] all_boxes = array.new_box()
var float active_s_high = na
var float active_s_low = na
var float active_d_high = na
var float active_d_low = na

// --- Main Logic ---
trend_ema = ta.ema(close, trend_ema_length)
is_uptrend = not use_trend_filter or close > trend_ema
is_downtrend = not use_trend_filter or close < trend_ema

plot(trend_ema, "Trend EMA", color.gray)

// --- Formation Detection ---
// RBD: Rally -> Base -> Drop (Explosive)
is_rbd = is_rally()[2] and is_base()[1] and is_drop() and is_explosive()
// DBD: Drop -> Base -> Drop (Explosive)
is_dbd = is_drop()[2] and is_base()[1] and is_drop() and is_explosive()
// RBR: Rally -> Base -> Rally (Explosive)
is_rbr = is_rally()[2] and is_base()[1] and is_rally() and is_explosive()
// DBR: Drop -> Base -> Rally (Explosive)
is_dbr = is_drop()[2] and is_base()[1] and is_rally() and is_explosive()

// --- Zone Refinement ---
if (is_rbd or is_dbd) and is_downtrend
    active_s_high := high[1]
    active_s_low := low[1]
    nb = box.new(bar_index[1], active_s_high, bar_index + 5, active_s_low,
                 bgcolor=supply_color, border_color=color.new(color.red, 40),
                 extend=extend.right, text="SUPPLY", text_color=color.red, text_size=size.tiny)
    array.push(all_boxes, nb)

if (is_rbr or is_dbr) and is_uptrend
    active_d_high := high[1]
    active_d_low := low[1]
    nb = box.new(bar_index[1], active_d_high, bar_index + 5, active_d_low,
                 bgcolor=demand_color, border_color=color.new(color.blue, 40),
                 extend=extend.right, text="DEMAND", text_color=color.blue, text_size=size.tiny)
    array.push(all_boxes, nb)

// Prune boxes
if array.size(all_boxes) > max_boxes
    box.delete(array.shift(all_boxes))

// --- Entry Logic (Re-test) ---
retest_s = not na(active_s_high) and high >= active_s_low
retest_d = not na(active_d_high) and low <= active_d_high

can_enter = not (is_rbd or is_dbd or is_rbr or is_dbr)

if retest_d and can_enter and is_uptrend and strategy.position_size == 0
    sl = active_d_low
    tp = close + (close - sl) * rr_ratio
    strategy.entry("Long", strategy.long, comment="Demand Re-test")
    strategy.exit("Exit Long", "Long", stop=sl, limit=tp)
    active_d_high := na

if retest_s and can_enter and is_downtrend and strategy.position_size == 0
    sl = active_s_high
    tp = close - (sl - close) * rr_ratio
    strategy.entry("Short", strategy.short, comment="Supply Re-test")
    strategy.exit("Exit Short", "Short", stop=sl, limit=tp)
    active_s_high := na

// Invalidate zones
if not na(active_s_high) and high > active_s_low + (active_s_high - active_s_low) * 0.5
    active_s_high := na
if not na(active_d_high) and low < active_d_low + (active_d_high - active_d_low) * 0.5
    active_d_high := na

// Debug signals
plotshape(is_rbd or is_dbd, "Supply Formation", shape.triangledown, location.abovebar, color.red, size=size.small)
plotshape(is_rbr or is_dbr, "Demand Formation", shape.triangleup, location.belowbar, color.blue, size=size.small)
