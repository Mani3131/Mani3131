//@version=6
strategy("Ultimate GOLD Trading Strategy", overlay=true, margin_long=100, margin_short=100, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// --- Inputs ---
ema_len = input.int(200, "Trend EMA Length")
pivot_len = input.int(10, "Pivot Length for S&R")
momentum_mult = input.float(1.5, "Momentum Candle Multiplier", tooltip="Candle body must be X times larger than the average body size")
avg_body_len = input.int(20, "Average Body Size Length")
sl_buffer = input.int(50, "SL Buffer (Ticks)", tooltip="Ticks to add/subtract from the sweep wick for SL")

// --- Indicators ---
ema200 = ta.ema(close, ema_len)
plot(ema200, "200 EMA", color=color.blue, linewidth=2)

// --- Support & Resistance Zones ---
ph = ta.pivothigh(high, pivot_len, pivot_len)
pl = ta.pivotlow(low, pivot_len, pivot_len)

var float resistance_level = na
var float support_level = na
var float sweep_wick_sl = na

// Arrays to store boxes for visualization
var box[] res_boxes = array.new_box()
var box[] sup_boxes = array.new_box()

if not na(ph)
    resistance_level := ph
    box_id = box.new(left=bar_index - pivot_len, top=ph, right=bar_index, bottom=ph, border_color=color.red, bgcolor=color.new(color.red, 80))
    array.push(res_boxes, box_id)
    if array.size(res_boxes) > 5
        box.delete(array.shift(res_boxes))

if not na(pl)
    support_level := pl
    box_id = box.new(left=bar_index - pivot_len, top=pl, right=bar_index, bottom=pl, border_color=color.green, bgcolor=color.new(color.green, 80))
    array.push(sup_boxes, box_id)
    if array.size(sup_boxes) > 5
        box.delete(array.shift(sup_boxes))

// Extend boxes to current bar
if array.size(res_boxes) > 0
    for i = 0 to array.size(res_boxes) - 1
        box.set_right(array.get(res_boxes, i), bar_index)
if array.size(sup_boxes) > 0
    for i = 0 to array.size(sup_boxes) - 1
        box.set_right(array.get(sup_boxes, i), bar_index)

// Visualization of S&R levels
plot(resistance_level, "Major Resistance", color=color.new(color.red, 50), style=plot.style_linebr)
plot(support_level, "Major Support", color=color.new(color.green, 50), style=plot.style_linebr)

// --- Trend Filter ---
is_uptrend = close > ema200
is_downtrend = close < ema200

// --- Liquidity Sweep Detection ---
// For a Long: Price must be in uptrend, sweep support, then reverse.
// For a Short: Price must be in downtrend, sweep resistance, then reverse.

var bool support_swept = false
var bool resistance_swept = false
var float sweep_high = na
var float sweep_low = na

if is_uptrend and not na(support_level)
    if low < support_level
        sweep_low := na(sweep_low) ? low : math.min(sweep_low, low)

    if low < support_level and close > support_level
        support_swept := true
        resistance_swept := false
    else if low < support_level and close < support_level
        // Price staying below support, reset sweep status but keep track of low
        support_swept := false
else
    sweep_low := na
    support_swept := false

if is_downtrend and not na(resistance_level)
    if high > resistance_level
        sweep_high := na(sweep_high) ? high : math.max(sweep_high, high)

    if high > resistance_level and close < resistance_level
        resistance_swept := true
        support_swept := false
    else if high > resistance_level and close > resistance_level
        resistance_swept := false
else
    sweep_high := na
    resistance_swept := false

// --- Trend Line Break (Pullback) ---
// We track the highs of the pullback for a long entry, and lows for a short entry.
var int bars_since_support_sweep = 0
if support_swept
    bars_since_support_sweep += 1
else
    bars_since_support_sweep := 0

var int bars_since_resistance_sweep = 0
if resistance_swept
    bars_since_resistance_sweep += 1
else
    bars_since_resistance_sweep := 0

// Momentum Candle Detection
body_size = math.abs(close - open)
avg_body = ta.sma(body_size, avg_body_len)
is_momentum_candle = body_size > (avg_body * momentum_mult)

// Entry Conditions: Breakout of the recent pullback high/low
pullback_high = bars_since_support_sweep > 1 ? ta.highest(high, bars_since_support_sweep)[1] : high[1]
pullback_low = bars_since_resistance_sweep > 1 ? ta.lowest(low, bars_since_resistance_sweep)[1] : low[1]

long_condition = support_swept and is_uptrend and close > pullback_high and is_momentum_candle
short_condition = resistance_swept and is_downtrend and close < pullback_low and is_momentum_candle

// --- Strategy Execution ---
if long_condition and strategy.position_size == 0
    float sl = sweep_low - syminfo.mintick * sl_buffer // Tight SL outside the sweep wick
    float tp = resistance_level // Target opposing level
    if not na(tp) and tp > close
        strategy.entry("Long", strategy.long)
        strategy.exit("Exit Long", "Long", stop=sl, limit=tp)
        support_swept := false // Reset after entry

if short_condition and strategy.position_size == 0
    float sl = sweep_high + syminfo.mintick * sl_buffer
    float tp = support_level
    if not na(tp) and tp < close
        strategy.entry("Short", strategy.short)
        strategy.exit("Exit Short", "Short", stop=sl, limit=tp)
        resistance_swept := false // Reset after entry

// --- Visuals ---
plotshape(long_condition, "Long Signal", shape.triangleup, location.belowbar, color.green, size=size.small, text="BUY")
plotshape(short_condition, "Short Signal", shape.triangledown, location.abovebar, color.red, size=size.small, text="SELL")

// Highlight sweeps
plotshape(support_swept and not long_condition, "Support Swept", shape.circle, location.belowbar, color.green, size=size.tiny)
plotshape(resistance_swept and not short_condition, "Resistance Swept", shape.circle, location.abovebar, color.red, size=size.tiny)

plot(support_swept ? pullback_high : na, "Pullback High", color=color.new(color.green, 70), style=plot.style_linebr)
plot(resistance_swept ? pullback_low : na, "Pullback Low", color=color.new(color.red, 70), style=plot.style_linebr)

// --- Dashboard ---
var table dashboard = table.new(position.top_right, 2, 2, border_width=1, border_color=color.gray)
if barstate.islast
    table.cell(dashboard, 0, 0, "Trend", bgcolor=is_uptrend ? color.new(color.green, 20) : color.new(color.red, 20), text_color=color.white)
    table.cell(dashboard, 1, 0, is_uptrend ? "BULLISH" : "BEARISH", text_color=color.white)
    table.cell(dashboard, 0, 1, "Strategy Status", bgcolor=color.new(color.gray, 20), text_color=color.white)
    table.cell(dashboard, 1, 1, support_swept ? "Support Swept - Looking for Long" : resistance_swept ? "Resistance Swept - Looking for Short" : "Waiting for Sweep", text_color=color.white)
