//@version=6
indicator("Ultimate Institutional Combo", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=5000)

// ==========================================
// GLOBAL SETTINGS & SHARED INPUTS
// ==========================================
show_oma = input.bool(true, "Show Opening Impulse Axiom", group="Global Toggles")
show_ibp = input.bool(true, "Show Institutional Bank Point", group="Global Toggles")
show_s_r_engine = input.bool(true, "Show S&R + Fibonacci Engine", group="Global Toggles")

// ==========================================
// 1. OPENING IMPULSE AXIOM (OMA)
// ==========================================
grp_oma = "Opening Impulse Axiom"
oma_anchor_color = input.color(color.new(color.blue, 90), "Anchor Box Color", group=grp_oma)
oma_high_color   = input.color(color.new(color.green, 50), "Zone High Color", group=grp_oma)
oma_low_color    = input.color(color.new(color.red, 50), "Zone Low Color", group=grp_oma)

var float oma_zone_high = float(na)
var float oma_zone_low = float(na)
var float oma_post_zone_high = float(na)
var float oma_post_zone_low = float(na)
// oma_status: Idle, Searching for Expansion, Waiting for Retracement
var string oma_status = "Idle"
var bool oma_trade_taken = false
var float oma_sl_level = na

bool oma_buy_condition = false
bool oma_sell_condition = false

// Reset logic
oma_is_new_hour = ta.change(time("60")) != 0
oma_is_purge_min = minute(time) == 59

if show_oma
    if oma_is_new_hour or oma_is_purge_min
        oma_zone_high := float(na)
        oma_zone_low := float(na)
        oma_post_zone_high := float(na)
        oma_post_zone_low := float(na)
        oma_status := "Idle"
        oma_trade_taken := false

    oma_curr_min = minute(time)

    // Phase A: The Anchor Window (Minutes 00 to 09)
    if oma_curr_min >= 0 and oma_curr_min <= 9
        if oma_is_new_hour or na(oma_zone_high)
            oma_zone_high := high
            oma_zone_low := low
        else
            oma_zone_high := math.max(oma_zone_high, high)
            oma_zone_low := math.min(oma_zone_low, low)
        oma_status := "Searching for Expansion"

    // Phase B: The Expansion Window (Minutes 10 to 58)
    if oma_curr_min >= 10 and oma_curr_min <= 58
        if na(oma_post_zone_high)
            oma_post_zone_high := high
            oma_post_zone_low := low
        else
            oma_post_zone_high := math.max(oma_post_zone_high, high)
            oma_post_zone_low := math.min(oma_post_zone_low, low)

        if oma_status == "Searching for Expansion"
            oma_status := "Waiting for Retracement"

    // Triggers
    oma_price_touches_low = low <= oma_zone_low and high >= oma_zone_low
    oma_buy_condition := oma_status == "Waiting for Retracement" and oma_post_zone_low < oma_zone_low and oma_price_touches_low and not oma_trade_taken

    oma_price_touches_high = high >= oma_zone_high and low <= oma_zone_high
    oma_sell_condition := oma_status == "Waiting for Retracement" and oma_post_zone_high > oma_zone_high and oma_price_touches_high and not oma_trade_taken

    if oma_buy_condition
        oma_trade_taken := true
        oma_sl_level := oma_post_zone_low
    if oma_sell_condition
        oma_trade_taken := true
        oma_sl_level := oma_post_zone_high

    // Visuals
    var box oma_anchor_box = box(na)
    if oma_is_new_hour
        oma_anchor_box := box.new(bar_index, na, bar_index + 9, na, border_color=color.blue, bgcolor=oma_anchor_color)

    if not na(oma_anchor_box) and oma_curr_min <= 58
        box.set_top(oma_anchor_box, oma_zone_high)
        box.set_bottom(oma_anchor_box, oma_zone_low)
        box.set_right(oma_anchor_box, bar_index)

plot(show_oma ? oma_zone_high : na, "OMA Zone High", color=oma_high_color, style=plot.style_stepline, linewidth=2)
plot(show_oma ? oma_zone_low : na, "OMA Zone Low", color=oma_low_color, style=plot.style_stepline, linewidth=2)
plot(show_oma ? oma_sl_level : na, "OMA SL Level", color=color.new(color.red, 70), style=plot.style_linebr, linewidth=1)

plotshape(show_oma and oma_buy_condition, "OMA Buy", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(show_oma and oma_sell_condition, "OMA Sell", shape.triangledown, location.abovebar, color.red, size=size.small)

if show_oma and barstate.islast
    label.new(bar_index, high, "OMA Status: " + oma_status, color=color.white, style=label.style_label_down)

// ==========================================
// 2. INSTITUTIONAL BANK POINT (IBP)
// ==========================================
grp_ibp = "IBP - Institutional Bank Point"
ibp_use_london = input.bool(true, "Focus on London Open (08:00 GMT)", group=grp_ibp)
ibp_use_ny = input.bool(true, "Focus on NY Open (12:00 GMT)", group=grp_ibp)
ibp_only_focus_sessions = input.bool(false, "Only Trade Focused Sessions", group=grp_ibp)

var float ibp_bank_point = na
var float ibp_prev_4h_high = na
var float ibp_prev_4h_low = na
var float ibp_impulse_high = na
var float ibp_impulse_low = na
var bool ibp_session_eligible = false
var int ibp_bars_since_cycle_start = 0
var bool ibp_has_broken_above = false
var bool ibp_trade_taken_this_cycle = false

bool ibp_buy_trigger = false
bool ibp_sell_trigger = false
bool ibp_is_cycle_start = false
bool ibp_is_after_impulse = false

// Helper function for Bank Point calculation
f_ibp_get_anchor_midpoint() =>
    float min_prange = 1e10
    float a_h = na
    float a_l = na
    for i = 0 to 15
        float r = high[i] - low[i]
        if r < min_prange
            min_prange := r
            a_h := high[i]
            a_l := low[i]
    (a_h + a_l) / 2.0

if show_ibp
    ibp_hour_tz = hour(time, "GMT+3")
    ibp_minute_tz = minute(time, "GMT+3")
    ibp_is_cycle_hour = ibp_hour_tz == 7 or ibp_hour_tz == 11 or ibp_hour_tz == 15 or ibp_hour_tz == 19 or ibp_hour_tz == 23 or ibp_hour_tz == 3
    ibp_is_cycle_start := ibp_is_cycle_hour and ibp_minute_tz == 0 and ta.change(time) != 0

    if ibp_is_cycle_start
        ibp_session_eligible := not ibp_only_focus_sessions or (ibp_use_london and ibp_hour_tz == 11) or (ibp_use_ny and ibp_hour_tz == 15)

    // Get Bank Point from 15M timeframe
    ibp_bp_from_15m = request.security(syminfo.tickerid, "15", f_ibp_get_anchor_midpoint()[1])
    [ibp_p4h_h, ibp_p4h_l] = request.security(syminfo.tickerid, "240", [high[1], low[1]])

    if ibp_is_cycle_start
        ibp_bank_point := ibp_bp_from_15m
        ibp_prev_4h_high := ibp_p4h_h
        ibp_prev_4h_low := ibp_p4h_l
        ibp_impulse_high := na
        ibp_impulse_low := na
        ibp_bars_since_cycle_start := 0
        ibp_has_broken_above := false
        ibp_trade_taken_this_cycle := false
    else
        ibp_bars_since_cycle_start += 1

    ibp_is_impulse_window = ibp_bars_since_cycle_start < 10
    ibp_is_after_impulse := ibp_bars_since_cycle_start >= 10

    if ibp_is_impulse_window
        ibp_impulse_high := na(ibp_impulse_high) ? high : math.max(ibp_impulse_high, high)
        ibp_impulse_low := na(ibp_impulse_low) ? low : math.min(ibp_impulse_low, low)

    if ibp_is_after_impulse and close[1] > ibp_bank_point
        ibp_has_broken_above := true

    ibp_is_bearish_rejection = close[1] < open[1] and high[1] >= ibp_bank_point and close[1] < ibp_bank_point
    ibp_is_bullish_rejection = close[1] > open[1] and low[1] <= ibp_bank_point and close[1] > ibp_bank_point

    ibp_can_trigger = ibp_is_after_impulse and ibp_session_eligible and not ibp_trade_taken_this_cycle and not na(ibp_bank_point)
    ibp_sell_trigger := ibp_can_trigger and not ibp_has_broken_above and ibp_is_bearish_rejection
    ibp_buy_trigger := ibp_can_trigger and ibp_has_broken_above and ibp_is_bullish_rejection

    if ibp_sell_trigger or ibp_buy_trigger
        ibp_trade_taken_this_cycle := true

    // Visuals for IBP
    var line ibp_bp_line = na
    var line ibp_p4h_h_line = na
    var line ibp_p4h_l_line = na
    var line ibp_imp_h_line = na
    var line ibp_imp_l_line = na

    if ibp_is_cycle_start
        ibp_bp_line := line.new(bar_index, ibp_bank_point, bar_index, ibp_bank_point, color=color.yellow, width=2)
        ibp_p4h_h_line := line.new(bar_index, ibp_prev_4h_high, bar_index, ibp_prev_4h_high, color=color.green, width=1)
        ibp_p4h_l_line := line.new(bar_index, ibp_prev_4h_low, bar_index, ibp_prev_4h_low, color=color.red, width=1)
        ibp_imp_h_line := na
        ibp_imp_l_line := na

    if not na(ibp_bp_line)
        line.set_x2(ibp_bp_line, bar_index)
        line.set_x2(ibp_p4h_h_line, bar_index)
        line.set_x2(ibp_p4h_l_line, bar_index)

    if ibp_is_after_impulse
        if na(ibp_imp_h_line)
            ibp_imp_h_line := line.new(bar_index - 1, ibp_impulse_high, bar_index, ibp_impulse_high, color=color.gray, width=1)
            ibp_imp_l_line := line.new(bar_index - 1, ibp_impulse_low, bar_index, ibp_impulse_low, color=color.gray, width=1)
        else
            line.set_x2(ibp_imp_h_line, bar_index)
            line.set_x2(ibp_imp_l_line, bar_index)

    var box ibp_imp_box = na
    if ibp_is_cycle_start
        ibp_imp_box := box.new(bar_index, high, bar_index + 9, low, bgcolor=color.new(color.gray, 80), border_color=color.gray, text="Impulse Window", text_color=color.white, text_size=size.tiny)

    if not na(ibp_imp_box) and ibp_bars_since_cycle_start < 10
        box.set_top(ibp_imp_box, ibp_impulse_high)
        box.set_bottom(ibp_imp_box, ibp_impulse_low)
        box.set_right(ibp_imp_box, bar_index)

    if ibp_is_cycle_start
        label.new(bar_index, ibp_bank_point, "Bank Point", color=color.yellow, textcolor=color.black, style=label.style_label_down, size=size.small)
        label.new(bar_index, ibp_prev_4h_high, "4H High", color=color.green, textcolor=color.white, style=label.style_label_down, size=size.small)
        label.new(bar_index, ibp_prev_4h_low, "4H Low", color=color.red, textcolor=color.white, style=label.style_label_up, size=size.small)

plotshape(show_ibp and ibp_buy_trigger, "IBP Buy Signal", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(show_ibp and ibp_sell_trigger, "IBP Sell Signal", shape.triangledown, location.abovebar, color.red, size=size.small)
plotshape(show_ibp and ibp_is_cycle_start, "New 4H Cycle", shape.triangleup, location.top, color.blue, size=size.tiny)

// ==========================================
// 3. S&R + FIBONACCI (S&R + ENGINE)
// ==========================================
type uis_Pivot
    float price
    int   bar
    float vol
    float wick

type uis_Zone
    float top
    float bot
    float center
    float strength
    float volSum
    int   touches
    int   firstBar
    int   lastTouch
    int   diedBar
    bool  isResistance
    bool  wasBroken
    bool  isLiveBreak

// --- S&R Inputs ---
grp_s_r = "S&R - S&R Zones"
s_r_preset      = input.string("Swing", "Strength preset", options = ["Scalp", "Local", "Swing", "Major", "Custom"], group = grp_s_r)
s_r_pivLeftIn    = input.int(15, "Custom Left bars",  minval = 2, maxval = 100, group = grp_s_r)
s_r_pivRightIn   = input.int(8,  "Custom Right bars", minval = 2, maxval = 50, group = grp_s_r)
s_r_clusterTolIn = input.float(0.9, "Cluster tolerance (× ATR)", minval = 0.2, maxval = 3.0, step = 0.1, group = grp_s_r)
s_r_minSpacingIn = input.int(20, "Min bars between touches", minval = 0, maxval = 200, group = grp_s_r)
s_r_pivBuffer    = input.int(80, "Pivot memory", minval = 20, maxval = 200, group = grp_s_r)
s_r_zoneCount  = input.int(6, "Active zones per side", minval = 1, maxval = 8, group = grp_s_r)
s_r_minTouches = input.int(2, "Minimum touches", minval = 2, maxval = 10, group = grp_s_r)
s_r_fadeAge    = input.int(120, "Fade after (bars)", minval = 0, maxval = 500, group = grp_s_r)
s_r_hideFar    = input.float(60.0, "Hide zones farther than (%)", minval = 0.0, maxval = 200.0, step = 5.0, group = grp_s_r)
s_r_showBroken   = input.bool(false, "Show broken zones", group = grp_s_r)
s_r_resColor    = input.color(color.rgb(244, 67, 79),  "Resistance Color", group = grp_s_r)
s_r_supColor    = input.color(color.rgb(38, 166, 154), "Support Color",    group = grp_s_r)
s_r_useVolColor = input.bool(true,  "Color zones by volume",  group = grp_s_r)
s_r_showLabels  = input.bool(true,  "Show zone strength label", group = grp_s_r)

// --- S&R logic and functions ---
s_r_pivLeft    = s_r_preset == "Scalp" ?  4  : s_r_preset == "Local" ?  6  : s_r_preset == "Swing" ? 15  : s_r_preset == "Major" ? 35  : s_r_pivLeftIn
s_r_pivRight   = s_r_preset == "Scalp" ?  2  : s_r_preset == "Local" ?  4  : s_r_preset == "Swing" ?  8  : s_r_preset == "Major" ? 15  : s_r_pivRightIn
s_r_clusterTol = s_r_preset == "Scalp" ? 0.4 : s_r_preset == "Local" ? 0.5 : s_r_preset == "Swing" ? 0.9 : s_r_preset == "Major" ? 1.4 : s_r_clusterTolIn
s_r_minSpacing = s_r_preset == "Scalp" ?  4  : s_r_preset == "Local" ?  8  : s_r_preset == "Swing" ? 20  : s_r_preset == "Major" ? 50  : s_r_minSpacingIn

s_r_atr50   = ta.atr(50)
s_r_volMa50 = ta.sma(volume, 50)
s_r_phPx = ta.pivothigh(high, s_r_pivLeft, s_r_pivRight)
s_r_plPx = ta.pivotlow(low,   s_r_pivLeft, s_r_pivRight)

f_s_r_upperWick(int idx) => high[idx] - math.max(open[idx], close[idx])
f_s_r_lowerWick(int idx) => math.min(open[idx], close[idx]) - low[idx]
f_s_r_safeVolume(int idx) =>
    v = volume[idx]
    na(v) or v <= 0 ? 1.0 : v

var array<uis_Pivot> s_r_highPivots = array.new<uis_Pivot>()
var array<uis_Pivot> s_r_lowPivots  = array.new<uis_Pivot>()

s_r_dataReady = not na(s_r_atr50) and s_r_atr50 > 0
s_r_newHighPivot = false
s_r_newLowPivot  = false

if show_s_r_engine and not na(s_r_phPx) and s_r_phPx > 0 and s_r_dataReady
    s_r_highPivots.push(uis_Pivot.new(s_r_phPx, bar_index - s_r_pivRight, f_s_r_safeVolume(s_r_pivRight), f_s_r_upperWick(s_r_pivRight)))
    if s_r_highPivots.size() > s_r_pivBuffer
        s_r_highPivots.shift()
    s_r_newHighPivot := true

if show_s_r_engine and not na(s_r_plPx) and s_r_plPx > 0 and s_r_dataReady
    s_r_lowPivots.push(uis_Pivot.new(s_r_plPx, bar_index - s_r_pivRight, f_s_r_safeVolume(s_r_pivRight), f_s_r_lowerWick(s_r_pivRight)))
    if s_r_lowPivots.size() > s_r_pivBuffer
        s_r_lowPivots.shift()
    s_r_newLowPivot := true

f_s_r_pivotWeight(uis_Pivot p, float a, float vAvg) =>
    safeVol  = na(p.vol)  or p.vol  <= 0 ? 0.0 : p.vol
    safeWick = na(p.wick) or p.wick <  0 ? 0.0 : p.wick
    age      = math.max(1, bar_index - p.bar)
    decay    = 1.0 / (1.0 + age / 200.0)
    volNorm  = vAvg > 0 ? safeVol / vAvg : 1.0
    wickNorm = a > 0 ? safeWick / a : 0.0
    (1.0 + volNorm * 0.5 + wickNorm * 0.5) * decay

f_s_r_buildZones(array<uis_Pivot> src, bool resistance, float a, float vAvg) =>
    out = array.new<uis_Zone>()
    if src.size() >= s_r_minTouches and a > 0
        used = array.new<bool>()
        for i = 0 to src.size() - 1
            used.push(false)
        tol = a * s_r_clusterTol
        for i = 0 to src.size() - 1
            if not used.get(i)
                seed    = src.get(i)
                members = array.new<uis_Pivot>()
                members.push(seed)
                used.set(i, true)
                if i + 1 <= src.size() - 1
                    for j = i + 1 to src.size() - 1
                        if not used.get(j)
                            cand = src.get(j)
                            if math.abs(cand.price - seed.price) <= tol
                                farEnough = true
                                if s_r_minSpacing > 0
                                    for k = 0 to members.size() - 1
                                        if math.abs(cand.bar - members.get(k).bar) < s_r_minSpacing
                                            farEnough := false
                                            break
                                if farEnough
                                    members.push(cand)
                                    used.set(j, true)
                if members.size() >= s_r_minTouches
                    priceSum  = 0.0
                    weightSum = 0.0
                    volSum    = 0.0
                    earliest  = members.get(0).bar
                    latest    = members.get(0).bar
                    for k = 0 to members.size() - 1
                        m = members.get(k)
                        w = f_s_r_pivotWeight(m, a, vAvg)
                        priceSum  += m.price * w
                        weightSum += w
                        volSum    += na(m.vol) ? 0.0 : m.vol
                        earliest  := math.min(earliest, m.bar)
                        latest    := math.max(latest,   m.bar)
                    if weightSum > 0
                        center = priceSum / weightSum
                        pad    = a * 0.25
                        out.push(uis_Zone.new(center + pad, center - pad, center, weightSum, volSum, members.size(), earliest, latest, na, resistance, false, false))
    out

f_s_r_trimToTopN(array<uis_Zone> zones, int keep) =>
    result = array.new<uis_Zone>()
    if zones.size() > 0
        copy = zones.copy()
        limit = math.min(keep, copy.size())
        for i = 0 to limit - 1
            if copy.size() == 0
                break
            bestIdx = 0
            bestVal = copy.get(0).strength
            if copy.size() > 1
                for j = 1 to copy.size() - 1
                    if copy.get(j).strength > bestVal
                        bestVal := copy.get(j).strength
                        bestIdx := j
            result.push(copy.get(bestIdx))
            copy.remove(bestIdx)
    result

var array<uis_Zone> s_r_resZones    = array.new<uis_Zone>()
var array<uis_Zone> s_r_supZones    = array.new<uis_Zone>()
var array<uis_Zone> s_r_brokenZones = array.new<uis_Zone>()

f_s_r_archiveIfNew(uis_Zone z, float a) =>
    duplicate = false
    if s_r_brokenZones.size() > 0
        tol = a * s_r_clusterTol * 0.7
        for i = 0 to s_r_brokenZones.size() - 1
            existing = s_r_brokenZones.get(i)
            if existing.isResistance == z.isResistance and math.abs(existing.center - z.center) <= tol
                duplicate := true
                if z.wasBroken and not existing.wasBroken
                    existing.wasBroken   := true
                    existing.diedBar     := z.diedBar
                    existing.isLiveBreak := z.isLiveBreak
                    s_r_brokenZones.set(i, existing)
                break
    if not duplicate
        s_r_brokenZones.push(z)
        if s_r_brokenZones.size() > 100
            s_r_brokenZones.shift()
    duplicate

if show_s_r_engine
    // Live-break and touch tracking
    if s_r_resZones.size() > 0
        for i = 0 to s_r_resZones.size() - 1
            z = s_r_resZones.get(i)
            if na(z.diedBar) and close > z.top
                z.diedBar     := bar_index
                z.wasBroken   := true
                z.isLiveBreak := close[1] <= z.top
                s_r_resZones.set(i, z)
                f_s_r_archiveIfNew(z, s_r_atr50)
            else if na(z.diedBar) and high >= z.bot and low <= z.top
                z.lastTouch := bar_index
                s_r_resZones.set(i, z)

    if s_r_supZones.size() > 0
        for i = 0 to s_r_supZones.size() - 1
            z = s_r_supZones.get(i)
            if na(z.diedBar) and close < z.bot
                z.diedBar     := bar_index
                z.wasBroken   := true
                z.isLiveBreak := close[1] >= z.bot
                s_r_supZones.set(i, z)
                f_s_r_archiveIfNew(z, s_r_atr50)
            else if na(z.diedBar) and high >= z.bot and low <= z.top
                z.lastTouch := bar_index
                s_r_supZones.set(i, z)

f_s_r_zoneSurvives(uis_Zone old, array<uis_Zone> newSet, float a) =>
    survived = false
    if newSet.size() > 0
        tol = a * s_r_clusterTol
        for i = 0 to newSet.size() - 1
            nz = newSet.get(i)
            if math.abs(nz.center - old.center) <= tol
                survived := true
                break
    survived

f_s_r_isAlreadyBroken(uis_Zone z, float a) =>
    broken = false
    if s_r_brokenZones.size() > 0
        tol = a * s_r_clusterTol * 0.7
        for i = 0 to s_r_brokenZones.size() - 1
            bz = s_r_brokenZones.get(i)
            if bz.isResistance == z.isResistance and bz.wasBroken and math.abs(bz.center - z.center) <= tol
                broken := true
                break
    broken

f_s_r_inheritState(uis_Zone newZ, array<uis_Zone> oldZones, float a) =>
    inherited = newZ
    if oldZones.size() > 0
        tol = a * s_r_clusterTol
        for i = 0 to oldZones.size() - 1
            oldZ = oldZones.get(i)
            if math.abs(oldZ.center - newZ.center) <= tol
                inherited.lastTouch := oldZ.lastTouch
                break
    inherited

if show_s_r_engine and (s_r_newHighPivot or s_r_newLowPivot)
    newRes = f_s_r_trimToTopN(f_s_r_buildZones(s_r_highPivots, true,  s_r_atr50, s_r_volMa50), s_r_zoneCount)
    newSup = f_s_r_trimToTopN(f_s_r_buildZones(s_r_lowPivots,  false, s_r_atr50, s_r_volMa50), s_r_zoneCount)

    if s_r_resZones.size() > 0
        for i = 0 to s_r_resZones.size() - 1
            old = s_r_resZones.get(i)
            if na(old.diedBar) and old.touches >= s_r_minTouches and not f_s_r_zoneSurvives(old, newRes, s_r_atr50)
                old.diedBar   := bar_index
                old.wasBroken := false
                f_s_r_archiveIfNew(old, s_r_atr50)

    if s_r_supZones.size() > 0
        for i = 0 to s_r_supZones.size() - 1
            old = s_r_supZones.get(i)
            if na(old.diedBar) and old.touches >= s_r_minTouches and not f_s_r_zoneSurvives(old, newSup, s_r_atr50)
                old.diedBar   := bar_index
                old.wasBroken := false
                f_s_r_archiveIfNew(old, s_r_atr50)

    oldResCopy = s_r_resZones.copy()
    oldSupCopy = s_r_supZones.copy()
    s_r_resZones.clear()
    if newRes.size() > 0
        for i = 0 to newRes.size() - 1
            nz = newRes.get(i)
            if not f_s_r_isAlreadyBroken(nz, s_r_atr50)
                s_r_resZones.push(f_s_r_inheritState(nz, oldResCopy, s_r_atr50))

    s_r_supZones.clear()
    if newSup.size() > 0
        for i = 0 to newSup.size() - 1
            nz = newSup.get(i)
            if not f_s_r_isAlreadyBroken(nz, s_r_atr50)
                s_r_supZones.push(f_s_r_inheritState(nz, oldSupCopy, s_r_atr50))

// --- Structure Inputs ---
grp_engine = "Structure - Structure & Fib"
struct_showDash = input.bool(true, "Show Dashboard", group = grp_engine)
struct_swingLen = input.int(10, "Swing Length", minval = 3, group = grp_engine)
struct_atrMult = input.float(0.5, "ATR Filter Mult", minval = 0.1, group = grp_engine)
struct_showFib = input.bool(true, "Show Fibonacci", group = grp_engine)
struct_showStruct = input.bool(true, "Show BOS/CHoCH", group = grp_engine)
struct_showSwings = input.bool(true, "Show HH/LL Labels", group = grp_engine)
struct_showSweeps = input.bool(true, "Show Liquidity Sweeps", group = grp_engine)
struct_showEngulf = input.bool(true, "Show Engulfing Signals", group = grp_engine)
struct_bullColor = input.color(#00E676, "Bull Color", group = grp_engine)
struct_bearColor = input.color(#FF5252, "Bear Color", group = grp_engine)

// --- Visual Buffers for S&R + Structure ---
var array<box>   uis_box_buffer   = array.new<box>()
var array<line>  uis_line_buffer  = array.new<line>()
var array<label> uis_label_buffer = array.new<label>()

f_uis_clear_buffers() =>
    if uis_box_buffer.size() > 0
        for i = 0 to uis_box_buffer.size() - 1
            box.delete(uis_box_buffer.get(i))
    uis_box_buffer.clear()
    if uis_line_buffer.size() > 0
        for i = 0 to uis_line_buffer.size() - 1
            line.delete(uis_line_buffer.get(i))
    uis_line_buffer.clear()
    if uis_label_buffer.size() > 0
        for i = 0 to uis_label_buffer.size() - 1
            label.delete(uis_label_buffer.get(i))
    uis_label_buffer.clear()

// --- Structure Logic ---
var float struct_swHigh1 = na
var int   struct_swHigh1Idx = na
var float struct_swHigh2 = na
var float struct_swLow1 = na
var int   struct_swLow1Idx = na
var float struct_swLow2 = na

var float struct_fibSwingHigh = na
var int   struct_fibSwingHighIdx = na
var float struct_fibSwingLow  = na
var int   struct_fibSwingLowIdx  = na
var int   struct_fibDirection = 0

struct_atr14 = nz(ta.atr(14), 0.0)
struct_pivotHigh = ta.pivothigh(high, struct_swingLen, struct_swingLen)
struct_pivotLow  = ta.pivotlow(low,   struct_swingLen, struct_swingLen)

struct_newSwingHigh = false
struct_newSwingLow  = false
struct_atrMinSize = struct_atr14 * struct_atrMult

// Liquidity Sweeps tracking
var int struct_lastSweptHighIdx = na
var int struct_lastSweptLowIdx  = na
bool struct_sweepHigh = false
bool struct_sweepLow  = false

if show_s_r_engine
    if not na(struct_swHigh1) and struct_swHigh1Idx != struct_lastSweptHighIdx
        if high > struct_swHigh1 and close < struct_swHigh1 and open < struct_swHigh1
            struct_sweepHigh := true
            struct_lastSweptHighIdx := struct_swHigh1Idx

    if not na(struct_swLow1) and struct_swLow1Idx != struct_lastSweptLowIdx
        if low < struct_swLow1 and close > struct_swLow1 and open > struct_swLow1
            struct_sweepLow := true
            struct_lastSweptLowIdx := struct_swLow1Idx

if show_s_r_engine and struct_showSweeps
    if struct_sweepHigh
        label.new(bar_index, high, "✗", color = color.new(color.orange, 100), textcolor = color.orange, style = label.style_label_down, size = size.small)
    if struct_sweepLow
        label.new(bar_index, low, "✗", color = color.new(color.orange, 100), textcolor = color.orange, style = label.style_label_up, size = size.small)

// Engulfing Patterns
struct_bodyHi = math.max(close, open)
struct_bodyLo = math.min(close, open)
struct_body = struct_bodyHi - struct_bodyLo
struct_bodyAvg = ta.ema(struct_body, 14)
struct_isLongBody = struct_body > struct_bodyAvg

struct_bearishEngulf = close < open and struct_isLongBody and struct_body > struct_body[1] and close[1] > open[1] and open > close[1] and close < open[1]
struct_bullishEngulf = close > open and struct_isLongBody and struct_body > struct_body[1] and close[1] < open[1] and open < close[1] and close > open[1]

if show_s_r_engine and struct_showEngulf
    if struct_bearishEngulf
        label.new(bar_index, high, "▼", color = color.new(struct_bearColor, 100), textcolor = struct_bearColor, style = label.style_label_down, size = size.small)
    if struct_bullishEngulf
        label.new(bar_index, low, "▲", color = color.new(struct_bullColor, 100), textcolor = struct_bullColor, style = label.style_label_up, size = size.small)

if show_s_r_engine
    if not na(struct_pivotHigh)
        if na(struct_swLow1) or (struct_pivotHigh - struct_swLow1) >= struct_atrMinSize
            struct_swHigh2 := struct_swHigh1
            struct_swHigh1 := struct_pivotHigh
            struct_swHigh1Idx := bar_index - struct_swingLen
            struct_newSwingHigh := true

    if not na(struct_pivotLow)
        if na(struct_swHigh1) or (struct_swHigh1 - struct_pivotLow) >= struct_atrMinSize
            struct_swLow2 := struct_swLow1
            struct_swLow1 := struct_pivotLow
            struct_swLow1Idx := bar_index - struct_swingLen
            struct_newSwingLow := true

    if struct_newSwingHigh and not na(struct_swHigh2) and struct_showSwings
        label.new(struct_swHigh1Idx, struct_swHigh1, struct_swHigh1 > struct_swHigh2 ? "HH" : "LH", color = color.new(color.white, 100), textcolor = struct_swHigh1 > struct_swHigh2 ? struct_bullColor : struct_bearColor, style = label.style_label_down, size = size.tiny)
    if struct_newSwingLow and not na(struct_swLow2) and struct_showSwings
        label.new(struct_swLow1Idx, struct_swLow1, struct_swLow1 > struct_swLow2 ? "HL" : "LL", color = color.new(color.white, 100), textcolor = struct_swLow1 > struct_swLow2 ? struct_bullColor : struct_bearColor, style = label.style_label_up, size = size.tiny)

var int struct_structureBias = 0
var int struct_lastBrokenHighIdx = na
var int struct_lastBrokenLowIdx  = na
bool struct_isBOS = false
bool struct_isCHoCH = false

if show_s_r_engine
    if not na(struct_swHigh1) and close > struct_swHigh1 and struct_swHigh1Idx != struct_lastBrokenHighIdx
        if struct_structureBias <= 0
            struct_isCHoCH := true
            struct_fibDirection := 1
            struct_fibSwingHigh := high
            struct_fibSwingHighIdx := bar_index
            struct_fibSwingLow := struct_swLow1
            struct_fibSwingLowIdx := struct_swLow1Idx
        else
            struct_isBOS := true
            struct_fibSwingHigh := high
            struct_fibSwingHighIdx := bar_index
            struct_fibSwingLow := struct_swLow1
            struct_fibSwingLowIdx := struct_swLow1Idx
        struct_structureBias := 1
        struct_lastBrokenHighIdx := struct_swHigh1Idx
        if struct_showStruct
            line.new(struct_swHigh1Idx, struct_swHigh1, bar_index, struct_swHigh1, color = struct_bullColor, style = line.style_dashed)
            label.new(math.round(math.avg(struct_swHigh1Idx, bar_index)), struct_swHigh1, struct_isCHoCH ? "CHoCH" : "BOS", color = color.new(struct_bullColor, 100), textcolor = struct_bullColor, style = label.style_label_down, size = size.small)

    if not na(struct_swLow1) and close < struct_swLow1 and struct_swLow1Idx != struct_lastBrokenLowIdx
        if struct_structureBias >= 0
            struct_isCHoCH := true
            struct_fibDirection := -1
            struct_fibSwingLow := low
            struct_fibSwingLowIdx := bar_index
            struct_fibSwingHigh := struct_swHigh1
            struct_fibSwingHighIdx := struct_swHigh1Idx
        else
            struct_isBOS := true
            struct_fibSwingLow := low
            struct_fibSwingLowIdx := bar_index
            struct_fibSwingHigh := struct_swHigh1
            struct_fibSwingHighIdx := struct_swHigh1Idx
        struct_structureBias := -1
        struct_lastBrokenLowIdx := struct_swLow1Idx
        if struct_showStruct
            line.new(struct_swLow1Idx, struct_swLow1, bar_index, struct_swLow1, color = struct_bearColor, style = line.style_dashed)
            label.new(math.round(math.avg(struct_swLow1Idx, bar_index)), struct_swLow1, struct_isCHoCH ? "CHoCH" : "BOS", color = color.new(struct_bearColor, 100), textcolor = struct_bearColor, style = label.style_label_up, size = size.small)

    // Update live Fib extremes
    if struct_fibDirection == 1 and high > struct_fibSwingHigh
        struct_fibSwingHigh := high
        struct_fibSwingHighIdx := bar_index
    if struct_fibDirection == -1 and low < struct_fibSwingLow
        struct_fibSwingLow := low
        struct_fibSwingLowIdx := bar_index

f_draw_zone(uis_Zone z, color baseCol, float maxS, float maxV) =>
    if not na(z.top) and not na(z.bot)
        fillOp = 85
        fill = color.new(baseCol, fillOp)
        uis_box_buffer.push(box.new(z.firstBar, z.top, bar_index + 10, z.bot, border_color = na, bgcolor = fill))

// Fib logic and Visuals drawing
if show_s_r_engine and barstate.islast
    f_uis_clear_buffers()

    mxS = 0.0
    mvV = 0.0
    for i = 0 to (s_r_resZones.size() > 0 ? s_r_resZones.size() - 1 : -1)
        if i >= 0
            mxS := math.max(mxS, s_r_resZones.get(i).strength)
            mvV := math.max(mvV, s_r_resZones.get(i).volSum)
    for i = 0 to (s_r_supZones.size() > 0 ? s_r_supZones.size() - 1 : -1)
        if i >= 0
            mxS := math.max(mxS, s_r_supZones.get(i).strength)
            mvV := math.max(mvV, s_r_supZones.get(i).volSum)

    if s_r_resZones.size() > 0
        for i = 0 to s_r_resZones.size() - 1
            z = s_r_resZones.get(i)
            if na(z.diedBar)
                f_draw_zone(z, s_r_resColor, mxS, mvV)
    if s_r_supZones.size() > 0
        for i = 0 to s_r_supZones.size() - 1
            z = s_r_supZones.get(i)
            if na(z.diedBar)
                f_draw_zone(z, s_r_supColor, mxS, mvV)

    // Structure Fibonacci Drawing
    if struct_showFib and not na(struct_fibSwingHigh) and not na(struct_fibSwingLow)
        float fib0 = struct_fibDirection == 1 ? struct_fibSwingLow : struct_fibSwingHigh
        float fib1 = struct_fibDirection == 1 ? struct_fibSwingHigh : struct_fibSwingLow
        float price_range = math.abs(fib1 - fib0)

        if price_range > 0
            uis_line_buffer.push(line.new(bar_index, fib0 + price_range * 0.382 * (struct_fibDirection == 1 ? 1 : -1), bar_index + 10, fib0 + price_range * 0.382 * (struct_fibDirection == 1 ? 1 : -1), color=color.new(color.gray, 50), style=line.style_dotted))
            uis_label_buffer.push(label.new(bar_index + 10, fib0 + price_range * 0.382 * (struct_fibDirection == 1 ? 1 : -1), "0.382", style=label.style_label_left, size=size.tiny, color=color.new(color.white, 100), textcolor=color.gray))

            uis_line_buffer.push(line.new(bar_index, fib0 + price_range * 0.5 * (struct_fibDirection == 1 ? 1 : -1), bar_index + 10, fib0 + price_range * 0.5 * (struct_fibDirection == 1 ? 1 : -1), color=color.new(color.gray, 50), style=line.style_dotted))
            uis_label_buffer.push(label.new(bar_index + 10, fib0 + price_range * 0.5 * (struct_fibDirection == 1 ? 1 : -1), "0.5", style=label.style_label_left, size=size.tiny, color=color.new(color.white, 100), textcolor=color.gray))

            uis_line_buffer.push(line.new(bar_index, fib0 + price_range * 0.618 * (struct_fibDirection == 1 ? 1 : -1), bar_index + 10, fib0 + price_range * 0.618 * (struct_fibDirection == 1 ? 1 : -1), color=color.new(color.gray, 50), style=line.style_dotted))
            uis_label_buffer.push(label.new(bar_index + 10, fib0 + price_range * 0.618 * (struct_fibDirection == 1 ? 1 : -1), "0.618", style=label.style_label_left, size=size.tiny, color=color.new(color.white, 100), textcolor=color.gray))

// ==========================================
// ALERTS
// ==========================================
// OMA Alerts
if show_oma
    if oma_buy_condition
        alert("OMA Buy Signal: Price touched low of the hour", alert.freq_once_per_bar)
    if oma_sell_condition
        alert("OMA Sell Signal: Price touched high of the hour", alert.freq_once_per_bar)

// IBP Alerts
if show_ibp
    if ibp_buy_trigger
        alert("IBP Buy Signal: Bullish rejection at Bank Point", alert.freq_once_per_bar)
    if ibp_sell_trigger
        alert("IBP Sell Signal: Bearish rejection at Bank Point", alert.freq_once_per_bar)

// S&R Alerts
f_s_r_priceTouchesAlive(array<uis_Zone> zs) =>
    hit = false
    if zs.size() > 0
        for i = 0 to zs.size() - 1
            z = zs.get(i)
            if na(z.diedBar) and z.touches >= s_r_minTouches and high >= z.bot and low <= z.top
                hit := true
                break
    hit

if show_s_r_engine
    if f_s_r_priceTouchesAlive(s_r_resZones)
        alert("S&R: Price reached an active resistance zone", alert.freq_once_per_bar)
    if f_s_r_priceTouchesAlive(s_r_supZones)
        alert("S&R: Price reached an active support zone", alert.freq_once_per_bar)

// Structure Alerts
if show_s_r_engine
    if struct_isBOS
        alert("Structure: Break of Structure (" + (struct_structureBias > 0 ? "Bull" : "Bear") + ")", alert.freq_once_per_bar_close)
    if struct_isCHoCH
        alert("Structure: Change of Character (" + (struct_structureBias > 0 ? "Bull" : "Bear") + ")", alert.freq_once_per_bar_close)

// Dashboard
if show_s_r_engine and struct_showDash and barstate.islast
    var table uis_dash = table.new(position.top_right, 2, 5, color.new(color.black, 10), color.gray, 1, color.gray, 1)
    table.cell(uis_dash, 0, 0, "Trend", text_color=color.white)
    table.cell(uis_dash, 1, 0, struct_structureBias > 0 ? "Bullish" : struct_structureBias < 0 ? "Bearish" : "Neutral", text_color=struct_structureBias > 0 ? struct_bullColor : struct_structureBias < 0 ? struct_bearColor : color.gray)
    table.cell(uis_dash, 0, 1, "OMA Status", text_color=color.white)
    table.cell(uis_dash, 1, 1, oma_status, text_color=color.white)
    table.cell(uis_dash, 0, 2, "IBP Eligible", text_color=color.white)
    table.cell(uis_dash, 1, 2, ibp_session_eligible ? "Yes" : "No", text_color=ibp_session_eligible ? color.green : color.red)
    table.cell(uis_dash, 0, 3, "ATR", text_color=color.white)
    table.cell(uis_dash, 1, 3, str.tostring(struct_atr14, format.mintick), text_color=color.white)

// Cleanup
if array.size(label.all) > 450
    label.delete(array.shift(label.all))
if array.size(line.all) > 450
    line.delete(array.shift(line.all))
if array.size(box.all) > 450
    box.delete(array.shift(box.all))
