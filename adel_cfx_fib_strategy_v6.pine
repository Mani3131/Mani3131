//@version=6
indicator("Adel CFX Fibonacci + Big Boss Strategy", overlay = true, max_labels_count = 500, max_boxes_count = 500, max_lines_count = 500)

// --- Inputs ---
grp_sd = "Supply & Demand"
displacement_threshold = input.float(2.0, "Displacement Threshold (ATR Mult)", minval = 1.0, group = grp_sd)
atr_length = input.int(14, "ATR Length", minval = 1, group = grp_sd)
max_zones = input.int(10, "Max Active Zones (per type)", minval = 1, maxval = 50, group = grp_sd)

grp_fib = "Fibonacci OTE Levels"
show_fib = input.bool(true, "Show Auto Fibonacci", group = grp_fib)
fib_lookback = input.int(20, "Fib Pivot Lookback", minval = 5, group = grp_fib)

grp_bb = "Big Boss Mathematical Algorithm"
show_sd_projections = input.bool(true, "Show SD Projections", group = grp_bb)
qt_enabled = input.bool(true, "Enable Quarterly Theory", group = grp_bb)
qt_tz = input.string("UTC+3", "QT Timezone", group = grp_bb)
qt_anchor = input.string("0300", "QT Anchor (HHMM)", group = grp_bb)

grp_vis = "Visuals"
supply_color = input.color(color.new(color.red, 80), "Supply Color", group = grp_vis)
demand_color = input.color(color.new(color.teal, 80), "Demand Color", group = grp_vis)
fib_color = input.color(color.new(color.gray, 50), "Fibonacci Color", group = grp_vis)

// --- UDTs ---
type Zone
    box b
    float top
    float bottom
    bool is_supply
    bool active
    line l10
    line l20
    line l25
    line l40

type Fib
    line l0
    line l618
    line l705
    line l786
    line l886
    line l100

// --- Variables & Historical Buffer ---
max_bars_back(close, 500)
max_bars_back(high, 500)
max_bars_back(low, 500)

var Zone[] supply_zones = array.new<Zone>()
var Zone[] demand_zones = array.new<Zone>()
var float atr = na
atr := ta.atr(atr_length)

// --- S&D Zone Logic ---
delete_zone(Zone z) =>
    box.delete(z.b)
    line.delete(z.l10)
    line.delete(z.l20)
    line.delete(z.l25)
    line.delete(z.l40)

manage_zones(Zone[] zones) =>
    if zones.size() > 0
        for i = 0 to zones.size() - 1
            Zone z = zones.get(i)
            if z.active
                mitigated = z.is_supply ? high > z.top : low < z.bottom
                if mitigated
                    z.active := false
                    box.set_bgcolor(z.b, color.new(color.gray, 95))
                    box.set_border_color(z.b, color.new(color.gray, 80))
                    line.set_color(z.l10, color.new(color.gray, 80))
                    line.set_color(z.l20, color.new(color.gray, 80))
                    line.set_color(z.l25, color.new(color.gray, 80))
                    line.set_color(z.l40, color.new(color.gray, 80))
                else
                    box.set_right(z.b, bar_index)
                    if not na(z.l10)
                        line.set_x2(z.l10, bar_index)
                        line.set_x2(z.l20, bar_index)
                        line.set_x2(z.l25, bar_index)
                        line.set_x2(z.l40, bar_index)

body_size = math.abs(close - open)
is_disp_up = close > open and body_size > atr * displacement_threshold
is_disp_down = close < open and body_size > atr * displacement_threshold

if is_disp_up
    float top = high[1]
    float bottom = low[1]
    float h = top - bottom
    box b = box.new(bar_index - 1, top, bar_index, bottom, bgcolor = demand_color, border_color = demand_color)
    line l10 = show_sd_projections ? line.new(bar_index - 1, top + h * 1.0, bar_index, top + h * 1.0, color = demand_color, style = line.style_dashed) : line(na)
    line l20 = show_sd_projections ? line.new(bar_index - 1, top + h * 2.0, bar_index, top + h * 2.0, color = demand_color, style = line.style_dashed) : line(na)
    line l25 = show_sd_projections ? line.new(bar_index - 1, top + h * 2.5, bar_index, top + h * 2.5, color = demand_color, style = line.style_dotted) : line(na)
    line l40 = show_sd_projections ? line.new(bar_index - 1, top + h * 4.0, bar_index, top + h * 4.0, color = demand_color, style = line.style_solid) : line(na)
    demand_zones.push(Zone.new(b, top, bottom, false, true, l10, l20, l25, l40))
    if demand_zones.size() > max_zones
        delete_zone(demand_zones.shift())

if is_disp_down
    float top = high[1]
    float bottom = low[1]
    float h = top - bottom
    box b = box.new(bar_index - 1, top, bar_index, bottom, bgcolor = supply_color, border_color = supply_color)
    line l10 = show_sd_projections ? line.new(bar_index - 1, bottom - h * 1.0, bar_index, bottom - h * 1.0, color = supply_color, style = line.style_dashed) : line(na)
    line l20 = show_sd_projections ? line.new(bar_index - 1, bottom - h * 2.0, bar_index, bottom - h * 2.0, color = supply_color, style = line.style_dashed) : line(na)
    line l25 = show_sd_projections ? line.new(bar_index - 1, bottom - h * 2.5, bar_index, bottom - h * 2.5, color = supply_color, style = line.style_dotted) : line(na)
    line l40 = show_sd_projections ? line.new(bar_index - 1, bottom - h * 4.0, bar_index, bottom - h * 4.0, color = supply_color, style = line.style_solid) : line(na)
    supply_zones.push(Zone.new(b, top, bottom, true, true, l10, l20, l25, l40))
    if supply_zones.size() > max_zones
        delete_zone(supply_zones.shift())

manage_zones(supply_zones)
manage_zones(demand_zones)

// --- Auto Fibonacci OTE Logic ---
var fib_tool = Fib.new(line(na), line(na), line(na), line(na), line(na), line(na))

if show_fib
    float ph = ta.highest(high, fib_lookback)
    float pl = ta.lowest(low, fib_lookback)
    int ph_idx = int(ta.highestbars(high, fib_lookback))
    int pl_idx = int(ta.lowestbars(low, fib_lookback))

    // We want the most recent move
    bool is_bullish_move = pl_idx < ph_idx // pl happened before ph
    float start_price = is_bullish_move ? pl : ph
    float end_price = is_bullish_move ? ph : pl
    int start_idx = bar_index + (is_bullish_move ? pl_idx : ph_idx)
    int end_idx = bar_index + (is_bullish_move ? ph_idx : pl_idx)

    float diff = end_price - start_price

    if na(fib_tool.l0)
        fib_tool.l0 := line.new(start_idx, start_price, bar_index, start_price, color = fib_color)
        fib_tool.l618 := line.new(start_idx, start_price + diff * 0.618, bar_index, start_price + diff * 0.618, color = fib_color, style = line.style_dashed)
        fib_tool.l705 := line.new(start_idx, start_price + diff * 0.705, bar_index, start_price + diff * 0.705, color = color.yellow, width = 2)
        fib_tool.l786 := line.new(start_idx, start_price + diff * 0.786, bar_index, start_price + diff * 0.786, color = fib_color, style = line.style_dashed)
        fib_tool.l886 := line.new(start_idx, start_price + diff * 0.886, bar_index, start_price + diff * 0.886, color = fib_color, style = line.style_dotted)
        fib_tool.l100 := line.new(start_idx, end_price, bar_index, end_price, color = fib_color)
    else
        line.set_xy1(fib_tool.l0, start_idx, start_price)
        line.set_xy2(fib_tool.l0, bar_index, start_price)
        line.set_xy1(fib_tool.l618, start_idx, start_price + diff * 0.618)
        line.set_xy2(fib_tool.l618, bar_index, start_price + diff * 0.618)
        line.set_xy1(fib_tool.l705, start_idx, start_price + diff * 0.705)
        line.set_xy2(fib_tool.l705, bar_index, start_price + diff * 0.705)
        line.set_xy1(fib_tool.l786, start_idx, start_price + diff * 0.786)
        line.set_xy2(fib_tool.l786, bar_index, start_price + diff * 0.786)
        line.set_xy1(fib_tool.l886, start_idx, start_price + diff * 0.886)
        line.set_xy2(fib_tool.l886, bar_index, start_price + diff * 0.886)
        line.set_xy1(fib_tool.l100, start_idx, end_price)
        line.set_xy2(fib_tool.l100, bar_index, end_price)

// --- Quarterly Theory ---
t = time(timeframe.period, "0000-2359", qt_tz)
hr = hour(t, qt_tz)
mn = minute(t, qt_tz)
total_mn = hr * 60 + mn

hr_anchor = str.tonumber(str.substring(qt_anchor, 0, 2))
mn_anchor = str.tonumber(str.substring(qt_anchor, 2, 4))
anchor_mn = hr_anchor * 60 + mn_anchor

offset_mn = (total_mn - anchor_mn + 1440) % 1440
quarter_num = math.floor(offset_mn / 90) % 4 + 1

qt_phase = quarter_num == 1 ? "Accumulation" :
           quarter_num == 2 ? "Manipulation" :
           quarter_num == 3 ? "Distribution" :
           quarter_num == 4 ? "Reversal" : "None"

qt_color = not qt_enabled or na(t) ? color(na) :
           quarter_num == 1 ? color.new(color.blue, 90) :
           quarter_num == 2 ? color.new(color.red, 90) :
           quarter_num == 3 ? color.new(color.green, 90) :
           quarter_num == 4 ? color.new(color.orange, 90) : color(na)

bgcolor(qt_color, title = "QT Phase Highlight")

// --- Entry Confluence ---
is_in_demand = false
if demand_zones.size() > 0
    for i = 0 to demand_zones.size() - 1
        Zone z = demand_zones.get(i)
        if z.active and low <= z.top and high >= z.bottom
            is_in_demand := true
            break

is_in_supply = false
if supply_zones.size() > 0
    for i = 0 to supply_zones.size() - 1
        Zone z = supply_zones.get(i)
        if z.active and high >= z.bottom and low <= z.top
            is_in_supply := true
            break

// PA Confirmation: Rejection Wick
rejection_ratio = 1.5
is_rejection_long = (math.min(open, close) - low) > math.abs(close - open) * rejection_ratio
is_rejection_short = (high - math.max(open, close)) > math.abs(close - open) * rejection_ratio

long_signal = is_in_demand and is_rejection_long
short_signal = is_in_supply and is_rejection_short

plotshape(long_signal, title = "Buy Signal", style = shape.labelup, location = location.belowbar, color = color.teal, text = "BUY", textcolor = color.white, size = size.small)
plotshape(short_signal, title = "Sell Signal", style = shape.labeldown, location = location.abovebar, color = color.red, text = "SELL", textcolor = color.white, size = size.small)

if long_signal
    alert("Adel CFX Buy Signal", alert.freq_once_per_bar_close)
if short_signal
    alert("Adel CFX Sell Signal", alert.freq_once_per_bar_close)

// --- Dashboard ---
var table dashboard = table.new(position.top_right, 2, 6, border_width = 1, frame_color = color.gray, frame_width = 1)

if barstate.islast
    table.cell(dashboard, 0, 0, "Adel CFX Dashboard", text_color = color.white, bgcolor = color.new(color.gray, 50), text_halign = text.align_center)
    table.cell(dashboard, 1, 0, "Value", text_color = color.white, bgcolor = color.new(color.gray, 50), text_halign = text.align_center)

    table.cell(dashboard, 0, 1, "QT Phase", text_color = color.white, text_halign = text.align_left)
    table.cell(dashboard, 1, 1, qt_phase, text_color = color.yellow, text_halign = text.align_center)

    table.cell(dashboard, 0, 2, "Market Bias", text_color = color.white, text_halign = text.align_left)
    bias_str = is_in_demand ? "BULLISH (In Demand)" : is_in_supply ? "BEARISH (In Supply)" : "NEUTRAL"
    table.cell(dashboard, 1, 2, bias_str, text_color = is_in_demand ? color.teal : is_in_supply ? color.red : color.white, text_halign = text.align_center)

    table.cell(dashboard, 0, 3, "Active Supply", text_color = color.white, text_halign = text.align_left)
    table.cell(dashboard, 1, 3, str.tostring(supply_zones.size()), text_color = color.red, text_halign = text.align_center)

    table.cell(dashboard, 0, 4, "Active Demand", text_color = color.white, text_halign = text.align_left)
    table.cell(dashboard, 1, 4, str.tostring(demand_zones.size()), text_color = color.teal, text_halign = text.align_center)

    table.cell(dashboard, 0, 5, "Status", text_color = color.white, text_halign = text.align_left)
    table.cell(dashboard, 1, 5, "Monitoring...", text_color = color.gray, text_halign = text.align_center)
