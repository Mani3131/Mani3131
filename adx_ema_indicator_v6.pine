//@version=6
indicator("Trading with ADX & EMAs", overlay=true)

// --- Strategy Description ---
// This indicator strictly follows the Fingrad ADX & EMA strategy depicted in the provided image.
// It uses two EMAs (20 and 50) and the ADX (Average Directional Index) for entry and exit signals.
// Note: The strategy uses unconventional ADX logic for Short positions (entering when ADX crosses below threshold).

// --- Inputs ---
short_ema_len = input.int(20, "Short EMA Length", minval=1)
long_ema_len = input.int(50, "Long EMA Length", minval=1)
adx_len = input.int(14, "ADX Length", minval=1)
adx_threshold = input.int(25, "ADX Threshold", minval=1)

// Colors based on image
color_ema20 = color.new(#00bcd4, 0) // Cyan
color_ema50 = color.new(#3f51b5, 0) // Purple

// --- Calculations ---
ema_short = ta.ema(close, short_ema_len)
ema_long = ta.ema(close, long_ema_len)

// ADX calculation (using built-in DMI function)
[diplus, diminus, adx] = ta.dmi(adx_len, adx_len)

// --- Logic ---
// Rules from Image:
// LONG POSITION:
// ENTRY: 20 EMA Crosses above 50 EMA AND When ADX crosses above 25.
// EXIT: 20 EMA Crosses below 50 EMA AND When ADX crosses below 25.
// SHORT POSITION:
// ENTRY: 20 EMA Crosses below 50 EMA AND When ADX crosses below 25.
// EXIT: 20 EMA Crosses above 50 EMA AND When ADX crosses above 25.

// Confluence triggers (fires when both conditions are met, triggered by the latter crossing)
long_entry_signal = (ta.crossover(ema_short, ema_long) and adx > adx_threshold) or (ta.crossover(adx, adx_threshold) and ema_short > ema_long)
long_exit_signal  = (ta.crossunder(ema_short, ema_long) and adx < adx_threshold) or (ta.crossunder(adx, adx_threshold) and ema_short < ema_long)

short_entry_signal = (ta.crossunder(ema_short, ema_long) and adx < adx_threshold) or (ta.crossunder(adx, adx_threshold) and ema_short < ema_long)
short_exit_signal  = (ta.crossover(ema_short, ema_long) and adx > adx_threshold) or (ta.crossover(adx, adx_threshold) and ema_short > ema_long)

// --- Plotting ---
plot(ema_short, "Short EMA", color_ema20, 2)
plot(ema_long, "Long EMA", color_ema50, 2)

// Long Signals
plotshape(long_entry_signal, "Long Entry", shape.labelup, location.belowbar, color.green, size=size.small, text="LONG ENTRY", textcolor=color.white)
plotshape(long_exit_signal, "Long Exit", shape.labeldown, location.abovebar, color.red, size=size.small, text="LONG EXIT", textcolor=color.white)

// Short Signals
plotshape(short_entry_signal, "Short Entry", shape.labeldown, location.abovebar, color.red, size=size.small, text="SHORT ENTRY", textcolor=color.white)
plotshape(short_exit_signal, "Short Exit", shape.labelup, location.belowbar, color.green, size=size.small, text="SHORT EXIT", textcolor=color.white)

// --- Alerts ---
alertcondition(long_entry_signal, "Long Entry", "Go Long!")
alertcondition(long_exit_signal, "Long Exit", "Exit Long!")
alertcondition(short_entry_signal, "Short Entry", "Go Short!")
alertcondition(short_exit_signal, "Short Exit", "Exit Short!")
