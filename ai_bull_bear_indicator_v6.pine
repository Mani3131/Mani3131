//@version=6
indicator("AI Bull/Bear Indicator [Cole]", overlay=true)

// ==========================================
// Settings
// ==========================================

// --- MA Ribbon Settings ---
grp_ribbon = "MA Ribbon Settings"
ma_type    = input.string("EMA", "MA Type", options=["EMA", "SMA", "WMA"], group=grp_ribbon)
ma_len1    = input.int(8, "MA 1 Length", minval=1, group=grp_ribbon)
ma_len2    = input.int(11, "MA 2 Length", minval=1, group=grp_ribbon)
ma_len3    = input.int(14, "MA 3 Length", minval=1, group=grp_ribbon)
ma_len4    = input.int(17, "MA 4 Length", minval=1, group=grp_ribbon)
ma_len5    = input.int(21, "MA 5 Length", minval=1, group=grp_ribbon)
ma_len6    = input.int(26, "MA 6 Length", minval=1, group=grp_ribbon)
ma_len7    = input.int(31, "MA 7 Length", minval=1, group=grp_ribbon)
ma_len8    = input.int(36, "MA 8 Length", minval=1, group=grp_ribbon)

color_bull = input.color(color.new(#00ffbb, 0), "Bullish Color", group=grp_ribbon)
color_bear = input.color(color.new(#ff0055, 0), "Bearish Color", group=grp_ribbon)
ribbon_transp = input.int(80, "Ribbon Transparency", minval=0, maxval=100, group=grp_ribbon)

// --- Confidence Scoring Settings ---
grp_ai = "AI Scoring Settings"
rsi_len = input.int(14, "RSI Length", minval=1, group=grp_ai)
rsi_upper = input.int(70, "RSI Overbought", minval=50, maxval=100, group=grp_ai)
rsi_lower = input.int(30, "RSI Oversold", minval=0, maxval=50, group=grp_ai)

// Weights for confluence
w_trend    = input.float(0.4, "Trend Weight (EMA Alignment)", minval=0.0, maxval=1.0, step=0.1, group=grp_ai)
w_momentum = input.float(0.3, "Momentum Weight (RSI)", minval=0.0, maxval=1.0, step=0.1, group=grp_ai)
w_position = input.float(0.3, "Price Position Weight", minval=0.0, maxval=1.0, step=0.1, group=grp_ai)

// --- Signal & Label Settings ---
grp_labels = "Signal & Label Settings"
show_labels = input.bool(true, "Show Signal Labels", group=grp_labels)
label_size  = input.string(size.normal, "Label Size", options=[size.small, size.normal, size.large, size.huge], group=grp_labels)
label_offset = input.int(2, "Label Offset (bars)", minval=0, group=grp_labels)

// --- Dashboard Settings ---
grp_dash = "Dashboard Settings"
show_dash = input.bool(true, "Show Dashboard", group=grp_dash)
dash_pos  = input.string(position.top_right, "Dashboard Position", options=[position.top_right, position.bottom_right, position.top_left, position.bottom_left], group=grp_dash)
dash_size = input.string(size.normal, "Dashboard Size", options=[size.small, size.normal, size.large], group=grp_dash)

// ==========================================
// Calculations
// ==========================================

// --- MA Calculation Function ---
get_ma(type, src, len) =>
    switch type
        "EMA" => ta.ema(src, len)
        "SMA" => ta.sma(src, len)
        "WMA" => ta.wma(src, len)
        => ta.ema(src, len)

ma1 = get_ma(ma_type, close, ma_len1)
ma2 = get_ma(ma_type, close, ma_len2)
ma3 = get_ma(ma_type, close, ma_len3)
ma4 = get_ma(ma_type, close, ma_len4)
ma5 = get_ma(ma_type, close, ma_len5)
ma6 = get_ma(ma_type, close, ma_len6)
ma7 = get_ma(ma_type, close, ma_len7)
ma8 = get_ma(ma_type, close, ma_len8)

// --- Trend Identification ---
// A simple trend logic for the ribbon coloring:
// Bullish if fastest MA is above slowest MA and price is above slowest MA
is_bullish = ma1 > ma8 and close > ma8
is_bearish = ma1 < ma8 and close < ma8

// --- Confidence Scoring ---
// 1. Trend Factor (0.0 - 1.0): EMA Alignment
count_aligned_bull = (ma1 > ma2 ? 1 : 0) + (ma2 > ma3 ? 1 : 0) + (ma3 > ma4 ? 1 : 0) + (ma4 > ma5 ? 1 : 0) + (ma5 > ma6 ? 1 : 0) + (ma6 > ma7 ? 1 : 0) + (ma7 > ma8 ? 1 : 0)
count_aligned_bear = (ma1 < ma2 ? 1 : 0) + (ma2 < ma3 ? 1 : 0) + (ma3 < ma4 ? 1 : 0) + (ma4 < ma5 ? 1 : 0) + (ma5 < ma6 ? 1 : 0) + (ma6 < ma7 ? 1 : 0) + (ma7 < ma8 ? 1 : 0)
ema_factor = is_bullish ? count_aligned_bull / 7.0 : is_bearish ? count_aligned_bear / 7.0 : 0.0

// 2. Momentum Factor (0.0 - 1.0): RSI Relative position
rsi_val = ta.rsi(close, rsi_len)
rsi_factor = is_bullish ? (rsi_val - 50) / 50.0 : is_bearish ? (50 - rsi_val) / 50.0 : 0.0
rsi_factor := math.max(0, math.min(1.0, rsi_factor))

// 3. Price Position Factor (0.0 - 1.0): Distance from ribbon
// Bullish: close above ma1; Bearish: close below ma1
pos_factor = is_bullish ? (close > ma1 ? 1.0 : (close - ma8) / (ma1 - ma8)) : is_bearish ? (close < ma1 ? 1.0 : (ma8 - close) / (ma8 - ma1)) : 0.0
pos_factor := math.max(0, math.min(1.0, pos_factor))

// Total Confidence Score (%)
// We normalize to a range of 50% - 100% when a signal is active
raw_score = (ema_factor * w_trend + rsi_factor * w_momentum + pos_factor * w_position) / (w_trend + w_momentum + w_position)
confidence_score = 50 + (raw_score * 50)

// Determine ribbon color with transparency
dynamic_ribbon_color = is_bullish ? color.new(color_bull, ribbon_transp) :
                       is_bearish ? color.new(color_bear, ribbon_transp) :
                       color.new(color.gray, ribbon_transp)

// ==========================================
// Plotting
// ==========================================

p1 = plot(ma1, "MA 1", color=dynamic_ribbon_color, linewidth=1)
p2 = plot(ma2, "MA 2", color=dynamic_ribbon_color, linewidth=1)
p3 = plot(ma3, "MA 3", color=dynamic_ribbon_color, linewidth=1)
p4 = plot(ma4, "MA 4", color=dynamic_ribbon_color, linewidth=1)
p5 = plot(ma5, "MA 5", color=dynamic_ribbon_color, linewidth=1)
p6 = plot(ma6, "MA 6", color=dynamic_ribbon_color, linewidth=1)
p7 = plot(ma7, "MA 7", color=dynamic_ribbon_color, linewidth=1)
p8 = plot(ma8, "MA 8", color=dynamic_ribbon_color, linewidth=1)

fill(p1, p8, color=dynamic_ribbon_color, title="Ribbon Fill")

// ==========================================
// Signals & Labels
// ==========================================

// Trend change detection
trend_flip_bull = is_bullish and not is_bullish[1]
trend_flip_bear = is_bearish and not is_bearish[1]

// Vertical offset for labels based on ATR
v_offset = ta.atr(14) * label_offset

if show_labels
    if trend_flip_bull
        label.new(bar_index, low - v_offset, "Bull " + str.tostring(math.round(confidence_score)) + "%",
                  color=color.new(color_bull, 0), textcolor=color.white, style=label.style_label_up, size=label_size)

    if trend_flip_bear
        label.new(bar_index, high + v_offset, "Bear " + str.tostring(math.round(confidence_score)) + "%",
                  color=color.new(color_bear, 0), textcolor=color.white, style=label.style_label_down, size=label_size)

// ==========================================
// Dashboard
// ==========================================

var table dash_table = table.new(dash_pos, 2, 4, border_width=1, border_color=color.new(color.gray, 50), frame_color=color.new(color.gray, 50), frame_width=1)

if show_dash and barstate.islast
    // Header
    table.cell(dash_table, 0, 0, "Metric", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=dash_size)
    table.cell(dash_table, 1, 0, "Value", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=dash_size)

    // Trend Status
    table.cell(dash_table, 0, 1, "Market Status", text_color=color.white, text_size=dash_size)
    status_text = is_bullish ? "BULLISH" : is_bearish ? "BEARISH" : "NEUTRAL"
    status_color = is_bullish ? color_bull : is_bearish ? color_bear : color.gray
    table.cell(dash_table, 1, 1, status_text, bgcolor=color.new(status_color, 20), text_color=status_color, text_size=dash_size)

    // Confidence
    table.cell(dash_table, 0, 2, "AI Confidence", text_color=color.white, text_size=dash_size)
    table.cell(dash_table, 1, 2, str.tostring(math.round(confidence_score)) + "%", text_color=color.white, text_size=dash_size)

    // RSI
    table.cell(dash_table, 0, 3, "RSI (" + str.tostring(rsi_len) + ")", text_color=color.white, text_size=dash_size)
    rsi_color = rsi_val > rsi_upper ? color.red : rsi_val < rsi_lower ? color.green : color.white
    table.cell(dash_table, 1, 3, str.tostring(math.round(rsi_val, 2)), text_color=rsi_color, text_size=dash_size)
