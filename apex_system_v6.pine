//@version=6
indicator("Apex System V6", overlay = true, max_labels_count = 500, max_boxes_count = 500)

// --- Inputs ---
lookback = input.int(100, "Lookback Period", minval = 10, group = "Quadratic Regression")
mult1    = input.float(1.0, "Inner Band Multiplier", group = "Quadratic Regression")
mult2    = input.float(2.0, "Middle Band Multiplier", group = "Quadratic Regression")
mult3    = input.float(3.0, "Outer Band Multiplier", group = "Quadratic Regression")

sig_cooldown = input.int(5, "Signal Cooldown (bars)", minval = 1, group = "Signals")

pivot_len = input.int(20, "Pivot Lookback for Zones", minval = 1, group = "Zones")
zone_transp = input.int(85, "Zone Transparency", minval = 0, maxval = 100, group = "Zones")

// --- Quadratic Regression Calculation ---
// y = ax^2 + bx + c
f_quad_reg(src, length) =>
    float sumX  = 0.0
    float sumX2 = 0.0
    float sumX3 = 0.0
    float sumX4 = 0.0
    float sumY  = 0.0
    float sumXY = 0.0
    float sumX2Y = 0.0

    for i = 0 to length - 1
        float x = float(i)
        float y = src[length - 1 - i]
        float x2 = x * x
        float x3 = x2 * x
        float x4 = x3 * x

        sumX   += x
        sumX2  += x2
        sumX3  += x3
        sumX4  += x4
        sumY   += y
        sumXY  += x * y
        sumX2Y += x2 * y

    float n = float(length)

    // Matrix for the system
    // [ sumX4  sumX3  sumX2 ] [ a ]   [ sumX2Y ]
    // [ sumX3  sumX2  sumX  ] [ b ] = [ sumXY  ]
    // [ sumX2  sumX   n     ] [ c ]   [ sumY   ]

    float det = sumX4 * (sumX2 * n - sumX * sumX) -
                sumX3 * (sumX3 * n - sumX * sumX2) +
                sumX2 * (sumX3 * sumX - sumX2 * sumX2)

    float a = (sumX2Y * (sumX2 * n - sumX * sumX) -
               sumX3  * (sumXY  * n - sumX * sumY) +
               sumX2  * (sumXY  * sumX - sumX2 * sumY)) / det

    float b = (sumX4  * (sumXY  * n - sumX * sumY) -
               sumX2Y * (sumX3  * n - sumX * sumX2) +
               sumX2  * (sumX3  * sumY - sumXY * sumX2)) / det

    float c = (sumX4  * (sumX2  * sumY - sumXY * sumX) -
               sumX3  * (sumX3  * sumY - sumXY * sumX2) +
               sumX2Y * (sumX3  * sumX - sumX2 * sumX2)) / det

    // Predicted value at current bar (x = length - 1)
    float x_curr = float(length - 1)
    float val = a * x_curr * x_curr + b * x_curr + c
    [val, a, b, c]

[basis, a_coef, b_coef, c_coef] = f_quad_reg(close, lookback)

// Standard Deviation for bands
var float sumSqErr = 0.0
sumSqErr := 0.0
for i = 0 to lookback - 1
    float x = float(i)
    float y_pred = a_coef * x * x + b_coef * x + c_coef
    sumSqErr += math.pow(close[lookback - 1 - i] - y_pred, 2)
float stdev = math.sqrt(sumSqErr / lookback)

float upper1 = basis + stdev * mult1
float lower1 = basis - stdev * mult1
float upper2 = basis + stdev * mult2
float lower2 = basis - stdev * mult2
float upper3 = basis + stdev * mult3
float lower3 = basis - stdev * mult3

// --- Plotting ---
plot(basis, "Basis", color.new(color.gray, 20), 2)
p_u1 = plot(upper1, "Upper 1", color.new(color.gray, 40))
p_u2 = plot(upper2, "Upper 2", color.new(color.gray, 40))
p_u3 = plot(upper3, "Upper 3", color.new(color.gray, 40))
p_l1 = plot(lower1, "Lower 1", color.new(color.gray, 40))
p_l2 = plot(lower2, "Lower 2", color.new(color.gray, 40))
p_l3 = plot(lower3, "Lower 3", color.new(color.gray, 40))

fill(p_u2, p_u3, color.new(color.purple, 85), "Upper Band Fill")
fill(p_l2, p_l3, color.new(color.green, 85), "Lower Band Fill")

// --- Signal Logic ---
buy_signal  = ta.crossunder(low, lower3) or (low < lower3 and close > open)
sell_signal = ta.crossover(high, upper3) or (high > upper3 and close < open)

// Prevent multiple signals on consecutive bars
var int last_signal_bar = 0
can_signal = bar_index - last_signal_bar > sig_cooldown

bool is_buy  = buy_signal and can_signal
bool is_sell = sell_signal and can_signal

if is_buy
    last_signal_bar := bar_index
    label.new(bar_index, low, "BUY", color = color.green, textcolor = color.white, style = label.style_label_up, size = size.normal)
    // Add the cyan circle highlight mentioned in plan
    label.new(bar_index, low, "●", color = color.new(color.cyan, 100), textcolor = color.cyan, style = label.style_label_up, size = size.small)

if is_sell
    last_signal_bar := bar_index
    label.new(bar_index, high, "SELL", color = color.red, textcolor = color.white, style = label.style_label_down, size = size.normal)

// --- Support and Resistance Zones ---
ph = ta.pivothigh(high, pivot_len, pivot_len)
pl = ta.pivotlow(low, pivot_len, pivot_len)

if not na(ph)
    // Create a zone from high to the higher of open/close
    float ph_bottom = math.max(open[pivot_len], close[pivot_len])
    box.new(bar_index[pivot_len], ph, bar_index, ph_bottom, color.new(color.purple, 50), 1, line.style_solid, extend.right, bgcolor = color.new(color.purple, zone_transp))

if not na(pl)
    // Create a zone from low to the lower of open/close
    float pl_top = math.min(open[pivot_len], close[pivot_len])
    box.new(bar_index[pivot_len], pl_top, bar_index, pl, color.new(color.green, 50), 1, line.style_solid, extend.right, bgcolor = color.new(color.green, zone_transp))
