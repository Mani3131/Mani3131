//@version=6
indicator("Asian Range Structural Matrix [V6]", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// --- Inputs ---
timezone = input.string("UTC+3", "Timezone (EAT)", tooltip = "The algorithm uses EAT (UTC+3) for its calculations.")

// --- Colors ---
color_asian = input.color(color.new(color.blue, 80), "Asian Range Color")
color_midpoint = input.color(color.blue, "Midpoint Color")
color_4h = input.color(color.gray, "4H Benchmark Color")
color_expansion = input.color(color.new(color.yellow, 85), "Expansion Phase Color")

// --- Asian Session Logic (02:00 - 08:00 EAT) ---
asian_session_input = input.session("0200-0800", "Asian Session Time")
t_asian = time(timeframe.period, asian_session_input, timezone)
is_asian = not na(t_asian)
is_new_asian = is_asian and not is_asian[1]

var float asian_high = na
var float asian_low = na
var box asian_box = na
var line asian_mid_line = na
var label asian_mid_label = na

if is_new_asian
    asian_high := high
    asian_low := low
    asian_box := box.new(left = bar_index, top = asian_high, right = bar_index, bottom = asian_low, border_color = color.blue, bgcolor = color_asian)
    mid = (asian_high + asian_low) / 2
    asian_mid_line := line.new(x1 = bar_index, y1 = mid, x2 = bar_index, y2 = mid, color = color_midpoint, style = line.style_dashed)
    asian_mid_label := label.new(x = bar_index, y = mid, text = "EQ", color = color.new(color.black, 100), textcolor = color_midpoint, style = label.style_label_left, size = size.small)
else if is_asian
    asian_high := math.max(asian_high, high)
    asian_low := math.min(asian_low, low)
    box.set_top(asian_box, asian_high)
    box.set_bottom(asian_box, asian_low)
    box.set_right(asian_box, bar_index)

    mid = (asian_high + asian_low) / 2
    line.set_y1(asian_mid_line, mid)
    line.set_y2(asian_mid_line, mid)
    line.set_x2(asian_mid_line, bar_index)
    label.set_xy(asian_mid_label, bar_index, mid)

// Extend Asian Midpoint after session ends
if not is_asian and not na(asian_mid_line)
    line.set_x2(asian_mid_line, bar_index)
    label.set_x(asian_mid_label, bar_index)

// --- 4H Structural Matrix Logic ---
// Boundaries: 00, 04, 08, 12, 16, 20 EAT
t_4h = time("240", "0000-0000:1234567", timezone)
is_new_4h = ta.change(t_4h)

var float p4h_high = na
var float p4h_low = na
var float p4h_mid = na
var float c4h_high = na
var float c4h_low = na
var int start_time_4h = 0

if is_new_4h
    p4h_high := c4h_high
    p4h_low := c4h_low
    p4h_mid := (p4h_high + p4h_low) / 2
    c4h_high := high
    c4h_low := low
    start_time_4h := time
else
    c4h_high := math.max(c4h_high, high)
    c4h_low := math.min(c4h_low, low)

// Benchmark Plots
plot(p4h_high, "Prev 4H High", color = color_4h, style = plot.style_linebr, linewidth = 2)
plot(p4h_low, "Prev 4H Low", color = color_4h, style = plot.style_linebr, linewidth = 2)
plot(p4h_mid, "Prev 4H EQ", color = color_4h, style = plot.style_linebr, linewidth = 1)

// --- 4H Expansion Phase (100 minutes) ---
is_expansion = (time - start_time_4h) < (100 * 60 * 1000) and not na(t_4h)
bgcolor(is_expansion ? color_expansion : na, title = "4H Expansion Phase")

// --- 15-Minute Fractal Rule (First 3 minutes) ---
t_15m = time("15", "0000-0000:1234567", timezone)
is_new_15m = ta.change(t_15m)
var int start_time_15m = 0
var float f15_high = na
var float f15_low = na
var box f15_box = na

if is_new_15m
    start_time_15m := time
    f15_high := high
    f15_low := low
    f15_box := box.new(left = bar_index, top = f15_high, right = bar_index, bottom = f15_low, border_color = color.new(color.orange, 50), bgcolor = color.new(color.orange, 90))
else if (time - start_time_15m) < (3 * 60 * 1000)
    f15_high := math.max(f15_high, high)
    f15_low := math.min(f15_low, low)
    box.set_top(f15_box, f15_high)
    box.set_bottom(f15_box, f15_low)
    box.set_right(f15_box, bar_index)

// --- Monday Gap Rule ---
var float friday_close = na
is_monday = dayofweek(time, timezone) == dayofweek.monday
is_friday = dayofweek(time, timezone) == dayofweek.friday
is_new_day = ta.change(dayofmonth(time, timezone))

if is_friday
    friday_close := close

var float monday_open = na
var line monday_gap_line = na

if is_monday and is_new_day
    monday_open := open
    if not na(friday_close) and math.abs(monday_open - friday_close) > syminfo.mintick * 10 // Significant gap
        monday_gap_line := line.new(x1 = bar_index, y1 = friday_close, x2 = bar_index + 10, y2 = friday_close, color = color.gray, style = line.style_dotted)
        label.new(bar_index, friday_close, "Monday Gap", color = color.new(color.black, 100), textcolor = color.gray, style = label.style_label_down, size = size.small)

if not na(monday_gap_line)
    line.set_x2(monday_gap_line, bar_index)

// --- Dashboard ---
var table dashboard = table.new(position.top_right, 2, 6, bgcolor = color.new(color.black, 70), border_width = 1, border_color = color.gray)

if barstate.islast
    table.cell(dashboard, 0, 0, "Metric", text_color = color.white, text_halign = text.align_left)
    table.cell(dashboard, 1, 0, "Value", text_color = color.white, text_halign = text.align_left)

    table.cell(dashboard, 0, 1, "Asian EQ", text_color = color.white, text_halign = text.align_left)
    table.cell(dashboard, 1, 1, str.tostring((asian_high + asian_low) / 2, format.mintick), text_color = color_midpoint, text_halign = text.align_left)

    table.cell(dashboard, 0, 2, "Prev 4H High", text_color = color.white, text_halign = text.align_left)
    table.cell(dashboard, 1, 2, str.tostring(p4h_high, format.mintick), text_color = color_4h, text_halign = text.align_left)

    table.cell(dashboard, 0, 3, "Prev 4H Low", text_color = color.white, text_halign = text.align_left)
    table.cell(dashboard, 1, 3, str.tostring(p4h_low, format.mintick), text_color = color_4h, text_halign = text.align_left)

    table.cell(dashboard, 0, 4, "Prev 4H EQ", text_color = color.white, text_halign = text.align_left)
    table.cell(dashboard, 1, 4, str.tostring(p4h_mid, format.mintick), text_color = color_4h, text_halign = text.align_left)

    table.cell(dashboard, 0, 5, "Expansion Phase", text_color = color.white, text_halign = text.align_left)
    table.cell(dashboard, 1, 5, is_expansion ? "ACTIVE" : "INACTIVE", text_color = is_expansion ? color.green : color.red, text_halign = text.align_left)
