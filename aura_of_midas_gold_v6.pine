//@version=6
strategy("Aura of Midas: Quantum Institutional Flow [V6]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, max_labels_count=500, max_boxes_count=500)

// --- Volatility-Decoupled Momentum (VDM) ---
vdm_length = input.int(20, "VDM Length", minval=1)
vdm_smooth = input.int(5, "VDM Smoothing", minval=1)
z_threshold = input.float(2.0, "Z-Score Threshold", step=0.1)

f_vdm() =>
    mom = ta.change(close, vdm_length)
    avg_mom = ta.sma(mom, vdm_length)
    std_mom = ta.stdev(mom, vdm_length)
    z_score = (mom - avg_mom) / (std_mom == 0 ? 1e-10 : std_mom)
    ta.ema(z_score, vdm_smooth)

vdm_val = f_vdm()

// --- Session Liquidity Capture (SLC) ---
london_sess = input.session("1000-1130", "London SLC Window", group="Sessions", tooltip="First 90m of London")
ny_sess     = input.session("1500-1630", "New York SLC Window", group="Sessions", tooltip="First 90m of New York")
tz          = input.string("UTC+3", "Timezone", group="Sessions")

is_london_slc = not na(time(timeframe.period, london_sess, tz))
is_ny_slc     = not na(time(timeframe.period, ny_sess, tz))

var float lon_high = na
var float lon_low  = na
var float ny_high  = na
var float ny_low   = na

// Reset levels at start of session
if is_london_slc and not is_london_slc[1]
    lon_high := high
    lon_low  := low
else if is_london_slc
    lon_high := math.max(lon_high, high)
    lon_low  := math.min(lon_low, low)

if is_ny_slc and not is_ny_slc[1]
    ny_high := high
    ny_low  := low
else if is_ny_slc
    ny_high := math.max(ny_high, high)
    ny_low  := math.min(ny_low, low)

// --- Golden Ratio Displacement (GRD) ---
grd_len  = input.int(50, "GRD Basis Length", group="Displacement")
grd_mult = input.float(1.618, "GRD Multiplier", step=0.1, group="Displacement")
atr_val  = ta.atr(grd_len)
grd_basis = ta.ema(close, grd_len)
grd_upper = grd_basis + (atr_val * grd_mult)
grd_lower = grd_basis - (atr_val * grd_mult)

// --- Visuals (Placeholder for now) ---
plot(vdm_val, "VDM Z-Score", color=vdm_val > 0 ? color.lime : color.red, display=display.none)
plot(grd_upper, "GRD Upper", color=color.new(color.yellow, 70))
plot(grd_lower, "GRD Lower", color=color.new(color.yellow, 70))
plot(lon_high, "London SLC High", color=color.new(color.blue, 50), style=plot.style_stepline)
plot(lon_low, "London SLC Low", color=color.new(color.blue, 50), style=plot.style_stepline)
plot(ny_high, "NY SLC High", color=color.new(color.orange, 50), style=plot.style_stepline)
plot(ny_low, "NY SLC Low", color=color.new(color.orange, 50), style=plot.style_stepline)

// --- Strategy Entry & Exit Logic ---
sl_atr_mult = input.float(2.0, "SL ATR Multiplier", group="Risk")
tp_atr_mult = input.float(4.0, "TP ATR Multiplier", group="Risk")

// Detect Sweeps
lon_sweep_low  = low < lon_low[1] and close > lon_low[1] and not is_london_slc and not na(lon_low)
lon_sweep_high = high > lon_high[1] and close < lon_high[1] and not is_london_slc and not na(lon_high)
ny_sweep_low   = low < ny_low[1] and close > ny_low[1] and not is_ny_slc and not na(ny_low)
ny_sweep_high  = high > ny_high[1] and close < ny_high[1] and not is_ny_slc and not na(ny_high)

is_sweep_low  = lon_sweep_low or ny_sweep_low
is_sweep_high = lon_sweep_high or ny_sweep_high

// Conditions
long_cond  = is_sweep_low and vdm_val > -z_threshold and close < grd_lower
short_cond = is_sweep_high and vdm_val < z_threshold and close > grd_upper

if long_cond and strategy.position_size == 0
    sl = low - (atr_val * sl_atr_mult)
    tp = close + (atr_val * tp_atr_mult)
    strategy.entry("Midas Long", strategy.long, comment="Aura Long")
    strategy.exit("Exit Long", "Midas Long", stop=sl, limit=tp, comment_loss="SL", comment_profit="TP")

if short_cond and strategy.position_size == 0
    sl = high + (atr_val * sl_atr_mult)
    tp = close - (atr_val * tp_atr_mult)
    strategy.entry("Midas Short", strategy.short, comment="Aura Short")
    strategy.exit("Exit Short", "Midas Short", stop=sl, limit=tp, comment_loss="SL", comment_profit="TP")

// Visual signals
plotshape(long_cond, "Long Signal", shape.triangleup, location.belowbar, color.lime, size=size.small)
plotshape(short_cond, "Short Signal", shape.triangledown, location.abovebar, color.red, size=size.small)

// --- Dashboard ---
var table aura_tbl = table.new(position.top_right, 2, 4, color.rgb(0,0,0,80), color.gray, 1, color.gray, 1)

if barstate.islast
    table.cell(aura_tbl, 0, 0, "Aura Dashboard", text_color=color.rgb(255, 215, 0), text_size=size.small)
    table.cell(aura_tbl, 1, 0, "Status", text_color=color.rgb(255, 215, 0), text_size=size.small)

    // Momentum Row
    table.cell(aura_tbl, 0, 1, "VDM Z-Score", text_color=color.white, text_size=size.small)
    table.cell(aura_tbl, 1, 1, str.tostring(vdm_val, "#.##"), bgcolor=vdm_val > 0 ? color.new(color.lime, 40) : color.new(color.red, 40), text_color=color.white, text_size=size.small)

    // Session Row
    current_sess = is_london_slc ? "London" : is_ny_slc ? "NY" : "None"
    table.cell(aura_tbl, 0, 2, "Active Session", text_color=color.white, text_size=size.small)
    table.cell(aura_tbl, 1, 2, current_sess, bgcolor=current_sess != "None" ? color.new(color.blue, 40) : color.new(color.gray, 40), text_color=color.white, text_size=size.small)

    // Sweep Row
    last_sweep = is_sweep_low ? "Bullish" : is_sweep_high ? "Bearish" : "None"
    table.cell(aura_tbl, 0, 3, "Last Sweep", text_color=color.white, text_size=size.small)
    table.cell(aura_tbl, 1, 3, last_sweep, bgcolor=last_sweep == "Bullish" ? color.new(color.lime, 40) : last_sweep == "Bearish" ? color.new(color.red, 40) : color.new(color.gray, 40), text_color=color.white, text_size=size.small)
