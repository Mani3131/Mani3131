// @version=6
indicator("Carmine Rosato CLC Strategy [Chart Fanatics]", overlay=true, max_boxes_count=100, max_labels_count=100, force_overlay=true)

// ==========================================
// TOU: This script is based on Carmine Rosato's
// CLC (Context, Location, Confirmation) framework
// as featured on Chart Fanatics.
// ==========================================

// --- Inputs ---
grp_context = "1. Context (HTF Trend)"
ema_len     = input.int(200, "EMA Length", group=grp_context)
show_ema    = input.bool(true, "Show EMA", group=grp_context)

grp_location = "2. Location (Supply & Demand)"
pivot_len    = input.int(3, "Pivot Strength", minval=1, group=grp_location)
atr_mult     = input.float(1.5, "Expansion Mult (ATR)", minval=0.1, group=grp_location)
max_zones    = input.int(5, "Max Active Zones Per Side", minval=1, maxval=20, group=grp_location)
color_sup    = input.color(color.new(#673ab7, 70), "Supply (Aggressive Sellers)", group=grp_location)
color_dem    = input.color(color.new(#26a69a, 70), "Demand (Aggressive Buyers)", group=grp_location)

grp_confirm = "3. Confirmation"
vol_mult    = input.float(1.5, "Volume Multiplier", minval=0.1, group=grp_confirm)
show_signals = input.bool(true, "Show Entry Signals", group=grp_confirm)

grp_dash = "Dashboard"
show_dash = input.bool(true, "Show Dashboard", group=grp_dash)
dash_pos  = input.string("top_right", "Position", options=["top_right", "bottom_right", "top_left", "bottom_left"], group=grp_dash)

// --- Types ---
type Zone
    box   bx
    float level
    float extreme
    bool  is_supply
    int   taps = 0
    bool  active = true

// --- Variables ---
var Zone[] supply_zones = array.new<Zone>()
var Zone[] demand_zones = array.new<Zone>()
var int last_touched_zone_type = 0 // 1 for supply, -1 for demand
var bool is_ping_pong = false

// --- Context ---
ema_val = ta.ema(close, ema_len)
plot(show_ema ? ema_val : na, "Trend EMA", color.new(color.gray, 50), 2)
trend_bias = close > ema_val ? 1 : -1

// --- Location: Supply & Demand ---
atr = ta.atr(14)
ph = ta.pivothigh(high, pivot_len, pivot_len)
pl = ta.pivotlow(low, pivot_len, pivot_len)

// Detection Logic
if not na(ph)
    // Check for "Expansion" (Aggressive Sellers)
    float move = high[pivot_len] - close
    if move > atr * atr_mult
        Zone new_zone = Zone.new(
             bx       = box.new(bar_index - pivot_len, high[pivot_len], bar_index, low[pivot_len], bgcolor=color_sup, border_color=color_sup, extend=extend.right, border_style=line.style_dotted),
             level    = low[pivot_len],
             extreme  = high[pivot_len],
             is_supply = true
             )
        array.unshift(supply_zones, new_zone)
        if array.size(supply_zones) > max_zones
            Zone removed = array.pop(supply_zones)
            box.delete(removed.bx)

if not na(pl)
    // Check for "Expansion" (Aggressive Buyers)
    float move = close - low[pivot_len]
    if move > atr * atr_mult
        Zone new_zone = Zone.new(
             bx       = box.new(bar_index - pivot_len, high[pivot_len], bar_index, low[pivot_len], bgcolor=color_dem, border_color=color_dem, extend=extend.right, border_style=line.style_dotted),
             level    = high[pivot_len],
             extreme  = low[pivot_len],
             is_supply = false
             )
        array.unshift(demand_zones, new_zone)
        if array.size(demand_zones) > max_zones
            Zone removed = array.pop(demand_zones)
            box.delete(removed.bx)

// --- Zone Management & Ping Pong ---
bool touched_supply = false
bool touched_demand = false

if array.size(supply_zones) > 0
    for i = 0 to array.size(supply_zones) - 1
        Zone z = array.get(supply_zones, i)
        if z.active
            // Update box right
            box.set_right(z.bx, bar_index)
            // Check for tap
            if high > z.level and low < z.level
                z.taps += 1
                touched_supply := true
            // Check for violation
            if close > z.extreme
                z.active := false
                box.set_extend(z.bx, extend.none)
                box.set_right(z.bx, bar_index)

if array.size(demand_zones) > 0
    for i = 0 to array.size(demand_zones) - 1
        Zone z = array.get(demand_zones, i)
        if z.active
            box.set_right(z.bx, bar_index)
            if low < z.level and high > z.level
                z.taps += 1
                touched_demand := true
            if close < z.extreme
                z.active := false
                box.set_extend(z.bx, extend.none)
                box.set_right(z.bx, bar_index)

// Ping Pong Logic: Price oscillating between zones
var int pp_counter = 0
if touched_supply
    if last_touched_zone_type == -1
        pp_counter += 1
    last_touched_zone_type := 1
else if touched_demand
    if last_touched_zone_type == 1
        pp_counter += 1
    last_touched_zone_type := -1

is_ping_pong := pp_counter >= 2

// Reset Ping Pong if price trends (Context shift)
if ta.change(trend_bias) != 0
    pp_counter := 0
    is_ping_pong := false

// --- Confirmation: Signals ---
vol_ma = ta.sma(volume, 20)
is_high_vol = volume > vol_ma * vol_mult

bool sell_signal = touched_supply and close < open and is_high_vol and trend_bias == -1
bool buy_signal  = touched_demand and close > open and is_high_vol and trend_bias == 1

plotshape(show_signals and buy_signal, "Buy Signal", shape.triangleup, location.belowbar, color.new(#26a69a, 0), size=size.small, text="BUY")
plotshape(show_signals and sell_signal, "Sell Signal", shape.triangledown, location.abovebar, color.new(#673ab7, 0), size=size.small, text="SELL")

// --- Dashboard ---
var table dash = table.new(dash_pos, 2, 4, bgcolor=color.new(color.black, 50), border_width=1, border_color=color.gray)
if show_dash and barstate.islast
    table.cell(dash, 0, 0, "Metric", text_color=color.white, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 1, 0, "Value", text_color=color.white, text_size=size.small, text_halign=text.align_center)

    table.cell(dash, 0, 1, "Context (Bias)", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 1, trend_bias == 1 ? "BULLISH" : "BEARISH", bgcolor=trend_bias == 1 ? color.new(color.green, 70) : color.new(color.red, 70), text_size=size.small, text_halign=text.align_center)

    table.cell(dash, 0, 2, "Market State", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 2, is_ping_pong ? "PING PONG" : "EXPANDING", bgcolor=is_ping_pong ? color.new(color.orange, 70) : color.new(color.blue, 70), text_size=size.small, text_halign=text.align_center)

    table.cell(dash, 0, 3, "Zones Active", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 3, str.format("S:{0} | D:{1}", array.size(supply_zones), array.size(demand_zones)), text_color=color.white, text_size=size.small, text_halign=text.align_center)
