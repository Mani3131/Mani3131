//@version=6
indicator("S&R + Fibonacci Structure Engine [FEELS + Willy]", "S&R + Fib [FEELS+Willy]", overlay = true, max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500, max_bars_back = 5000)

// =====================================================================
//                               TYPES
// =====================================================================
type Pivot
    float price
    int   bar
    float vol
    float wick

type Zone
    float top
    float bot
    float center
    float strength
    float volSum
    int   touches
    int   firstBar
    int   lastTouch
    int   diedBar
    bool  isResistance
    bool  wasBroken
    bool  isLiveBreak

// =====================================================================
//                              FEELS INPUTS
// =====================================================================
grpFEELSStrength = "FEELS - Zone Strength"
preset      = input.string("Swing", "Strength preset", options = ["Scalp", "Local", "Swing", "Major", "Custom"], group = grpFEELSStrength, tooltip = "Scalp: very tight zones for 1-5m timeframes.\nLocal: tight zones from recent pivots.\nSwing: balanced zones.\nMajor: wide zones from significant macro pivots.\nCustom: manually define pivot lengths below.")

grpFEELSPivot     = "FEELS - Custom Parameters"
pivLeftIn    = input.int(15, "Left bars",  minval = 2, maxval = 100, group = grpFEELSPivot, tooltip = "Number of bars to the left required to confirm a custom pivot.")
pivRightIn   = input.int(8,  "Right bars", minval = 2, maxval = 50, group = grpFEELSPivot, tooltip = "Number of bars to the right required to confirm a custom pivot.")
clusterTolIn = input.float(0.9, "Cluster tolerance (× ATR)", minval = 0.2, maxval = 3.0, step = 0.1, group = grpFEELSPivot, tooltip = "Multiplier based on ATR. Higher values merge pivots that are further apart into a single, wider zone.")
minSpacingIn = input.int(20, "Minimum bars between touches", minval = 0, maxval = 200, group = grpFEELSPivot, tooltip = "Minimum number of bars required between price touches for them to be counted as separate, valid touches.")
pivBuffer    = input.int(80, "Pivot memory", minval = 20, maxval = 200, group = grpFEELSPivot, tooltip = "Maximum number of historical pivots kept in memory to build zones. Higher values look further back in time.")

grpFEELSCluster = "FEELS - Zones"
zoneCount  = input.int(6, "Active zones per side", minval = 1, maxval = 8, group = grpFEELSCluster, tooltip = "Maximum number of active Support and Resistance zones displayed on the chart simultaneously.")
minTouches = input.int(2, "Minimum touches", minval = 2, maxval = 10, group = grpFEELSCluster, tooltip = "Minimum number of pivot touches required to form and display a valid zone.")
fadeAge    = input.int(120, "Fade after (bars)", minval = 0, maxval = 500, group = grpFEELSCluster, tooltip = "Number of bars after which a zone starts to become more transparent if it hasn't been touched. Set to 0 to disable fading.")
hideFar    = input.float(60.0, "Hide zones farther than (%)", minval = 0.0, maxval = 200.0, step = 5.0, group = grpFEELSCluster, tooltip = "Hides zones whose center price is further than this percentage away from the current price. Set to 0 to always show all zones.")

grpFEELSHistory   = "FEELS - Broken Zones"
showBroken   = input.bool(false, "Show confirmed broken zones", group = grpFEELSHistory, tooltip = "Displays historical zones that were physically broken by the closing price.")
showDropped  = input.bool(false, "Show dropped zones",          group = grpFEELSHistory, tooltip = "Displays zones that were removed from the active list because newer, stronger pivots reorganized the clusters.")
brokenBull   = input.color(color.rgb(105, 140, 125),  "Broken support color",    group = grpFEELSHistory, tooltip = "Color applied to historical/broken support zones.")
brokenBear   = input.color(color.rgb(165, 105, 110),  "Broken resistance color", group = grpFEELSHistory, tooltip = "Color applied to historical/broken resistance zones.")
brokenOp     = input.int(85, "Broken zone opacity", minval = 30, maxval = 95, group = grpFEELSHistory, tooltip = "Base transparency for historical/broken zones. Lower values make them more transparent.")

grpFEELSSignals    = "FEELS - Signals (optional)"
showTest      = input.bool(false, "Show successful test markers",  group = grpFEELSSignals, tooltip = "Displays a circle when the price touches an active zone and successfully bounces/rejects off it.")
showRetest    = input.bool(false, "Show retest markers",           group = grpFEELSSignals, tooltip = "Displays a diamond when the price returns to test a previously broken zone from the opposite side (e.g., broken resistance turning into support).")
showReaction  = input.bool(false, "Show zone reaction marks",      group = grpFEELSSignals, tooltip = "Displays a small diamond when price touches an active zone but holds (does not close beyond it), and text labels when a zone is physically broken.")
sigCooldown   = input.int(20, "Cooldown bars",    minval = 0, maxval = 100, group = grpFEELSSignals, tooltip = "Minimum number of bars that must pass before a zone can trigger another bounce/retest signal.")
retestWindow  = input.int(50, "Retest window (bars)", minval = 5, maxval = 200, group = grpFEELSSignals, tooltip = "Maximum number of bars after a breakout during which a return to the zone is still considered a valid retest.")

grpFEELSStyle    = "FEELS - Style"
resColor    = input.color(color.rgb(244, 67, 79),  "Resistance", group = grpFEELSStyle, tooltip = "Color for active Resistance zones (top).")
supColor    = input.color(color.rgb(38, 166, 154), "Support",    group = grpFEELSStyle, tooltip = "Color for active Support zones (bottom).")
useVolColor = input.bool(true,  "Color zones by volume",  group = grpFEELSStyle, tooltip = "Automatically makes zones with higher cumulative volume more vivid and lowers opacity for low-volume zones.")
showLabels  = input.bool(true,  "Show zone strength label", group = grpFEELSStyle, tooltip = "Displays the text label containing star rating, number of touches, and volume score.")
showVolText = input.bool(true,  "Show volume score",        group = grpFEELSStyle, tooltip = "Displays the volume score text inside the zone label.")
volFormat   = input.string("Absolute", "Volume format", options = ["Absolute", "Percentage"], group = grpFEELSStyle, tooltip = "Absolute: Shows values like 1.2M or 450K.\nPercentage: Shows relative strength (1-100%) compared to the strongest active zone.")
singleLine  = input.bool(false, "Single line label",        group = grpFEELSStyle, tooltip = "Places the volume score and star rating on the same single line instead of two separate lines.")
zoneOpacity = input.int(82, "Zone opacity (low volume)", minval = 60, maxval = 95, group = grpFEELSStyle, tooltip = "Base transparency for zones with low volume. If 'Color zones by volume' is enabled, high-volume zones will automatically become less transparent than this value.")

// FEELS preset resolution
pivLeft    = preset == "Scalp" ?  4  : preset == "Local" ?  6  : preset == "Swing" ? 15  : preset == "Major" ? 35  : pivLeftIn
pivRight   = preset == "Scalp" ?  2  : preset == "Local" ?  4  : preset == "Swing" ?  8  : preset == "Major" ? 15  : pivRightIn
clusterTol = preset == "Scalp" ? 0.4 : preset == "Local" ? 0.5 : preset == "Swing" ? 0.9 : preset == "Major" ? 1.4 : clusterTolIn
minSpacing = preset == "Scalp" ?  4  : preset == "Local" ?  8  : preset == "Swing" ? 20  : preset == "Major" ? 50  : minSpacingIn

// =====================================================================
//                              WILLY INPUTS
// =====================================================================
GRP_WILLY_MAIN    = "Willy - Main Settings"
GRP_WILLY_FIB     = "Willy - Fibonacci Levels"
GRP_WILLY_STRUCT  = "Willy - Structure"
GRP_WILLY_LIQ     = "Willy - Liquidity"
