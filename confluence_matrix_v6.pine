//@version=6
indicator("Confluence Matrix [Trading System]", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

// --- INPUTS ---
// Trend Filter
grp_trend = "Trend Filter"
ema_len = input.int(200, "EMA Length", minval=1, group=grp_trend)
show_ema = input.bool(true, "Show EMA", group=grp_trend)

// Fibonacci
grp_fib = "Fibonacci Retracements"
fib_lookback = input.int(100, "Fib Pivot Lookback", minval=10, group=grp_fib)

// Static S/R
grp_sr = "Static S/R"
sr_lookback = input.int(300, "S/R History Lookback", minval=50, group=grp_sr)
sr_sensitivity = input.float(0.10, "Confluence Threshold (%)", minval=0.01, step=0.01, group=grp_sr, tooltip="Percentage distance between levels to consider them 'overlapping'")

// Daily Levels
grp_daily = "Daily Levels"
show_pdh_pdl = input.bool(true, "Show PDH/PDL", group=grp_daily)

// RSI
grp_rsi = "RSI Momentum"
rsi_len = input.int(14, "RSI Length", minval=1, group=grp_rsi)
rsi_ob = input.int(70, "Overbought Level", minval=50, maxval=100, group=grp_rsi)
rsi_os = input.int(30, "Oversold Level", minval=0, maxval=50, group=grp_rsi)

// Risk Management
grp_risk = "Risk Management"
show_targets = input.bool(true, "Show SL/TP Targets", group=grp_risk)

// --- COLORS ---
color_bull = color.teal
color_bear = color.red
color_killzone = color.new(color.yellow, 85)

// --- TREND FILTER (EMA 200) ---
ema_200 = ta.ema(close, ema_len)
plot(show_ema ? ema_200 : na, "EMA 200", color=color.gray, linewidth=2)

is_bullish_trend = close > ema_200
is_bearish_trend = close < ema_200

// --- DAILY LEVELS (PDH / PDL) ---
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)

plot(show_pdh_pdl ? pdh : na, "PDH", color=color.new(color.gray, 50), style=plot.style_stepline, linewidth=1)
plot(show_pdh_pdl ? pdl : na, "PDL", color=color.new(color.gray, 50), style=plot.style_stepline, linewidth=1)

// --- FIBONACCI RETRACEMENTS ---
var float swing_high = na
var float swing_low = na
var int swing_high_idx = na
var int swing_low_idx = na

ph = ta.pivothigh(high, fib_lookback, fib_lookback)
pl = ta.pivotlow(low, fib_lookback, fib_lookback)

if not na(ph)
    swing_high := ph
    swing_high_idx := bar_index - fib_lookback
if not na(pl)
    swing_low := pl
    swing_low_idx := bar_index - fib_lookback

fib_range = math.abs(swing_high - swing_low)

// Retracement Calculations (Pullback Depth)
// Bullish Retracements: measured from High back to Low
bull_fib_0 = swing_high
bull_fib_50 = swing_high - fib_range * 0.50
bull_fib_618 = swing_high - fib_range * 0.618
bull_fib_786 = swing_high - fib_range * 0.786
bull_fib_ext = swing_high + fib_range * 0.272

// Bearish Retracements: measured from Low back to High
bear_fib_0 = swing_low
bear_fib_50 = swing_low + fib_range * 0.50
bear_fib_618 = swing_low + fib_range * 0.618
bear_fib_786 = swing_low + fib_range * 0.786
bear_fib_ext = swing_low - fib_range * 0.272

// --- STATIC S/R LEVELS ---
// We'll collect recent pivots and find clusters
var float[] pivot_levels = array.new_float()
if not na(ph)
    array.push(pivot_levels, ph)
if not na(pl)
    array.push(pivot_levels, pl)

if array.size(pivot_levels) > sr_lookback
    array.remove(pivot_levels, 0)

// Function to find if price is near any static S/R
is_near_sr(price, threshold_pct) =>
    bool near = false
    if array.size(pivot_levels) > 0
        for i = 0 to array.size(pivot_levels) - 1
            lvl = array.get(pivot_levels, i)
            if math.abs(price - lvl) / price <= threshold_pct / 100
                near := true
                break
    near

// --- RSI MOMENTUM & DIVERGENCE ---
rsi = ta.rsi(close, rsi_len)

// Divergence Logic
var float last_rsi_high = na
var float last_rsi_low = na
var float last_price_high = na
var float last_price_low = na

// Pivot detection for RSI/Price
rsi_ph = ta.pivothigh(rsi, 5, 5)
rsi_pl = ta.pivotlow(rsi, 5, 5)
price_ph = ta.pivothigh(high, 5, 5)
price_pl = ta.pivotlow(low, 5, 5)

if not na(rsi_ph)
    last_rsi_high := rsi[5]
if not na(rsi_pl)
    last_rsi_low := rsi[5]
if not na(price_ph)
    last_price_high := high[5]
if not na(price_pl)
    last_price_low := low[5]

// Bullish Divergence: Price Lower Low, RSI Higher Low
bull_div = low < last_price_low and rsi > last_rsi_low and not na(last_price_low) and not na(last_rsi_low)
// Bearish Divergence: Price Higher High, RSI Lower High
bear_div = high > last_price_high and rsi < last_rsi_high and not na(last_price_high) and not na(last_rsi_high)

// --- CONFLUENCE MATRIX (KILL ZONE) ---
// Proximity Logic: Check if Fib 50/61.8 aligns with Static S/R or PDH/PDL
is_overlap(price1, price2) =>
    math.abs(price1 - price2) / price1 <= sr_sensitivity / 100

// Bullish Confluence (Longs)
bull_fib_confluence = is_near_sr(bull_fib_50, sr_sensitivity) or is_near_sr(bull_fib_618, sr_sensitivity) or
                      is_overlap(bull_fib_50, pdl) or is_overlap(bull_fib_618, pdl)

// Bearish Confluence (Shorts)
bear_fib_confluence = is_near_sr(bear_fib_50, sr_sensitivity) or is_near_sr(bear_fib_618, sr_sensitivity) or
                      is_overlap(bear_fib_50, pdh) or is_overlap(bear_fib_618, pdh)

// --- CANDLESTICK PATTERNS ---
is_bull_engulfing = close > open[1] and open < close[1] and close > open and open[1] > close[1]
is_bear_engulfing = close < open[1] and open > close[1] and close < open and open[1] < close[1]
is_bull_rejection = (low < open and low < close and math.abs(open - close) < (high - low) * 0.4 and (math.min(open, close) - low) > (high - low) * 0.5)
is_bear_rejection = (high > open and high > close and math.abs(open - close) < (high - low) * 0.4 and (high - math.max(open, close)) > (high - low) * 0.5)

// --- EXECUTION TRIGGERS ---
bull_killzone = bull_fib_confluence and low <= math.max(bull_fib_50, bull_fib_618) and low >= math.min(bull_fib_50, bull_fib_618)
bear_killzone = bear_fib_confluence and high >= math.min(bear_fib_50, bear_fib_618) and high <= math.max(bear_fib_50, bear_fib_618)

long_condition = barstate.isconfirmed and is_bullish_trend and bull_killzone and (rsi < rsi_os or bull_div) and (is_bull_engulfing or is_bull_rejection)
short_condition = barstate.isconfirmed and is_bearish_trend and bear_killzone and (rsi > rsi_ob or bear_div) and (is_bear_engulfing or is_bear_rejection)

// --- VISUAL FEEDBACK & PLOTS ---
// Active Kill Zone (Current Bar)
var box active_bull_box = box.new(na, na, na, na, bgcolor=color_killzone, border_color=na)
var box active_bear_box = box.new(na, na, na, na, bgcolor=color_killzone, border_color=na)

if bull_fib_confluence
    box.set_lefttop(active_bull_box, bar_index, math.max(bull_fib_50, bull_fib_618))
    box.set_rightbottom(active_bull_box, bar_index + 5, math.min(bull_fib_50, bull_fib_618))
else
    box.set_lefttop(active_bull_box, na, na)

if bear_fib_confluence
    box.set_lefttop(active_bear_box, bar_index, math.max(bear_fib_50, bear_fib_618))
    box.set_rightbottom(active_bear_box, bar_index + 5, math.min(bear_fib_50, bear_fib_618))
else
    box.set_lefttop(active_bear_box, na, na)

// Signal Labels and Historical Boxes
if long_condition
    label.new(bar_index, low, "BUY CONFLUENCE", color=color_bull, textcolor=color.white, style=label.style_label_up)
    box.new(bar_index[5], math.max(bull_fib_50, bull_fib_618), bar_index, math.min(bull_fib_50, bull_fib_618), bgcolor=color_killzone, border_color=na)
if short_condition
    label.new(bar_index, high, "SELL CONFLUENCE", color=color_bear, textcolor=color.white, style=label.style_label_down)
    box.new(bar_index[5], math.max(bear_fib_50, bear_fib_618), bar_index, math.min(bear_fib_50, bear_fib_618), bgcolor=color_killzone, border_color=na)

// Risk Management Visuals (Only on last signal)
var line sl_line = na
var line tp1_line = na
var line tp2_line = na

if show_targets and (long_condition or short_condition)
    line.delete(sl_line)
    line.delete(tp1_line)
    line.delete(tp2_line)

    sl_price = long_condition ? bull_fib_786 : bear_fib_786
    tp1_price = long_condition ? bull_fib_0 : bear_fib_0
    tp2_price = long_condition ? bull_fib_ext : bear_fib_ext

    sl_line := line.new(bar_index, sl_price, bar_index + 20, sl_price, color=color.red, width=2, style=line.style_dashed)
    tp1_line := line.new(bar_index, tp1_price, bar_index + 20, tp1_price, color=color.green, width=1, style=line.style_dotted)
    tp2_line := line.new(bar_index, tp2_price, bar_index + 20, tp2_price, color=color.green, width=2, style=line.style_solid)

    label.new(bar_index + 20, sl_price, "SL (78.6%)", color=color.new(color.red, 100), textcolor=color.red, style=label.style_label_left)
    label.new(bar_index + 20, tp1_price, "TP1 (0%)", color=color.new(color.green, 100), textcolor=color.green, style=label.style_label_left)
    label.new(bar_index + 20, tp2_price, "TP2 (-27.2%)", color=color.new(color.green, 100), textcolor=color.green, style=label.style_label_left)

// --- ALERTS ---
alertcondition(long_condition, "Long Confluence Setup", "Bullish confluence detected at Kill Zone!")
alertcondition(short_condition, "Short Confluence Setup", "Bearish confluence detected at Kill Zone!")
