//@version=6
strategy("Eagle V4.4 Auto", overlay=true, max_labels_count=500, max_boxes_count=500, max_lines_count=500, initial_capital=1000, default_qty_type=strategy.fixed, default_qty_value=0.01)

// --- INPUTS ---
// Account Info (Manual/Simulated for Dashboard)
grp_account = "ACCOUNT"
i_balance = input.float(290.90, "Initial Balance", group=grp_account)
i_equity = input.float(290.90, "Current Equity", group=grp_account)

// Progress Targets
grp_progress = "PROGRESS"
i_profit_target = input.float(10.00, "Profit Target ($)", group=grp_progress)
i_max_loss_limit = input.float(0.00, "Max Loss Limit (0 = OFF)", group=grp_progress)
i_entry_limit = input.int(20, "Entry Limit", group=grp_progress)

// Technical Parameters
grp_tech = "TECHNICAL SETTINGS"
i_ema_fast = input.int(10, "Fast EMA Length", group=grp_tech)
i_ema_slow = input.int(20, "Slow EMA Length", group=grp_tech)
i_ci_len = input.int(14, "Choppiness Index Length", group=grp_tech)
i_ci_upper = input.float(61.8, "CI Upper (Sideways > limit)", group=grp_tech)
i_ci_lower = input.float(38.2, "CI Lower (Trending < limit)", group=grp_tech)

// Trade Settings
grp_settings = "SETTINGS"
i_lot = input.float(0.01, "Lot size", group=grp_settings)
i_sl = input.float(5.00, "Stop Loss ($)", group=grp_settings)
i_tp = input.float(15.00, "Take Profit ($)", group=grp_settings)
i_trail_start = input.float(3.00, "Trailing Start ($)", group=grp_settings)
i_trail_step = input.float(2.00, "Trailing Step ($)", group=grp_settings)
i_be_start = input.float(2.00, "Break Even Start ($)", group=grp_settings)
i_be_offset = input.float(0.20, "Break Even Offset ($)", group=grp_settings)

// UI Settings
grp_ui = "UI SETTINGS"
i_table_pos = input.string("top_right", "Dashboard Position", options=["top_right", "bottom_right", "top_left", "bottom_left"], group=grp_ui)

// --- TECHNICAL LOGIC ---
// Trend Detection
ema_fast = ta.ema(close, i_ema_fast)
ema_slow = ta.ema(close, i_ema_slow)
is_bullish = ema_fast > ema_slow
is_bearish = ema_fast < ema_slow

trend_text = is_bullish ? "BULLISH" : is_bearish ? "BEARISH" : "NEUTRAL"
trend_color = is_bullish ? color.lime : is_bearish ? color.red : color.gray

// Choppiness Index (CI)
ci = 100 * math.log10(math.sum(ta.tr, i_ci_len) / (ta.highest(high, i_ci_len) - ta.lowest(low, i_ci_len))) / math.log10(i_ci_len)
is_sideways = ci > i_ci_upper
is_trending = ci < i_ci_lower

state_text = is_sideways ? "SIDEWAYS" : is_trending ? "TRENDING" : "STABLE"
state_color = is_sideways ? color.orange : is_trending ? color.lime : color.gray

// Signal Logic
buy_sig = ta.crossover(ema_fast, ema_slow) and not is_sideways
sell_sig = ta.crossunder(ema_fast, ema_slow) and not is_sideways

// Store last signal
var string last_pattern = "NONE"
var color pattern_color = color.gray

if buy_sig
    last_pattern := "BUY SIG"
    pattern_color := color.lime
if sell_sig
    last_pattern := "SELL SIG"
    pattern_color := color.red

// --- SESSION & TIME ---
// Simulating session/time for UI
t_hour = hour(time, "UTC+3")
t_min = minute(time, "UTC+3")
is_session_open = true // Placeholder for session logic

// --- STRATEGY EXECUTION ---
// Risk Management: Entry Limit
can_enter = strategy.closedtrades < i_entry_limit

if buy_sig and can_enter
    strategy.entry("Long", strategy.long, qty=i_lot)

if sell_sig and can_enter
    strategy.entry("Short", strategy.short, qty=i_lot)

// Exit Logic (SL/TP)
sl_dist = i_sl / (i_lot * syminfo.pointvalue)
tp_dist = i_tp / (i_lot * syminfo.pointvalue)

// Break Even Logic
if strategy.position_size > 0
    float profit_dollars = (close - strategy.opentrades.entry_price(0)) * i_lot * syminfo.pointvalue
    if profit_dollars >= i_be_start
        strategy.exit("BE Long", "Long", stop=strategy.opentrades.entry_price(0) + (i_be_offset * syminfo.mintick))

    strategy.exit("Exit Long", "Long", loss=sl_dist, profit=tp_dist, trail_points=i_trail_start, trail_offset=i_trail_step)

if strategy.position_size < 0
    float profit_dollars = (strategy.opentrades.entry_price(0) - close) * i_lot * syminfo.pointvalue
    if profit_dollars >= i_be_start
        strategy.exit("BE Short", "Short", stop=strategy.opentrades.entry_price(0) - (i_be_offset * syminfo.mintick))

    strategy.exit("Exit Short", "Short", loss=sl_dist, profit=tp_dist, trail_points=i_trail_start, trail_offset=i_trail_step)

// Dynamic account stats (using strategy variables)
float profit_val = strategy.netprofit + strategy.openprofit
float profit_pct = math.min(100, math.max(0, (profit_val / i_profit_target) * 100))

// --- DASHBOARD TABLE ---
var table main_table = table.new(i_table_pos, 4, 30, frame_color=color.gray, frame_width=1, border_width=1, border_color=color.new(color.gray, 50))

if barstate.islast
    // Helper function for headers
    header(table t, int row, string txt) =>
        table.cell(t, 0, row, txt, text_color=color.gray, text_size=size.small, text_halign=text.align_left)
        table.cell_set_background_color(t, 0, row, color.new(color.black, 100))
        table.merge_cells(t, 0, row, 3, row)

    // Helper function for key-value rows
    kv_row(table t, int row, string key, string val, color val_color) =>
        table.cell(t, 0, row, key, text_color=color.white, text_size=size.small, text_halign=text.align_left)
        table.cell(t, 1, row, val, text_color=val_color, text_size=size.small, text_halign=text.align_left)
        table.merge_cells(t, 1, row, 3, row)

    // Eagle Title
    table.cell(main_table, 0, 0, "⚡ EAGLE   V4.4   AUTO ⚡", text_color=color.orange, text_size=size.normal, text_halign=text.align_center)
    table.merge_cells(main_table, 0, 0, 3, 0)

    // ACCOUNT SECTION
    header(main_table, 1, "ACCOUNT")
    kv_row(main_table, 2, "Balance", "$ " + str.tostring(strategy.initial_capital + strategy.netprofit, "#.00"), color.aqua)
    kv_row(main_table, 3, "Equity", "$ " + str.tostring(strategy.equity, "#.00"), color.aqua)
    kv_row(main_table, 4, "P/L Day", "$ " + str.tostring(strategy.netprofit, "#.00"), strategy.netprofit >= 0 ? color.lime : color.red)
    kv_row(main_table, 5, "Floating", "$ " + str.tostring(strategy.openprofit, "#.00"), strategy.openprofit >= 0 ? color.lime : color.red)

    // PROGRESS SECTION
    header(main_table, 6, "PROGRESS")
    // Profit Progress Bar
    table.cell(main_table, 0, 7, "Profit", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    string prog_bar = "["
    int filled = int(math.min(10, profit_pct / 10))
    for i = 1 to 10
        prog_bar += i <= filled ? "■" : " "
    prog_bar += "]"
    table.cell(main_table, 1, 7, prog_bar, text_color=color.lime, text_size=size.small, text_halign=text.align_left)
    table.cell(main_table, 2, 7, str.tostring(int(profit_pct)) + "%", text_color=color.lime, text_size=size.small, text_halign=text.align_left)
    table.cell(main_table, 3, 7, "$" + str.tostring(i_profit_target, "#.00"), text_color=color.lime, text_size=size.small, text_halign=text.align_left)

    kv_row(main_table, 8, "Max Loss", i_max_loss_limit == 0 ? "OFF" : "$ " + str.tostring(i_max_loss_limit, "#.00"), i_max_loss_limit == 0 ? color.gray : color.red)

    // Entry Progress
    float entry_pct = math.min(100, (strategy.closedtrades / i_entry_limit) * 100)
    table.cell(main_table, 0, 9, "Entry", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    string entry_bar = "["
    int e_filled = int(entry_pct / 10)
    for i = 1 to 10
        entry_bar += i <= e_filled ? "■" : " "
    entry_bar += "]"
    table.cell(main_table, 1, 9, entry_bar, text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(main_table, 2, 9, str.tostring(int(entry_pct)) + "%", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(main_table, 3, 9, str.tostring(strategy.closedtrades) + "/" + str.tostring(i_entry_limit), text_color=color.white, text_size=size.small, text_halign=text.align_left)

    // MARKET STATUS SECTION
    header(main_table, 10, "MARKET STATUS")
    kv_row(main_table, 11, "Time", "OPEN (In 5h 20m)", color.lime)
    kv_row(main_table, 12, "State", state_text + " (CI: " + str.tostring(ci, "#.0") + ")", state_color)
    kv_row(main_table, 13, "Session", "● OPEN", color.lime)

    // NEWS FILTER SECTION
    header(main_table, 14, "NEWS FILTER (AUTO)")
    kv_row(main_table, 15, "Status", "● CLEAR", color.lime)
    kv_row(main_table, 16, "Before", "492m 52s", color.orange)
    kv_row(main_table, 17, "After", "--", color.white)
    kv_row(main_table, 18, "Next", "23:50 (GMT +0)", color.aqua)
    kv_row(main_table, 19, "JPY Low", "SPPI y/y", color.aqua)

    // TREND/PATTERN SECTION
    table.cell(main_table, 0, 20, "M5 Trend", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(main_table, 1, 20, (is_bullish ? "▲ " : is_bearish ? "▼ " : "● ") + trend_text, text_color=trend_color, text_size=size.small, text_halign=text.align_left)
    table.merge_cells(main_table, 1, 20, 3, 20)

    table.cell(main_table, 0, 21, "Pattern", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(main_table, 1, 21, (last_pattern == "BUY SIG" ? "▲ " : last_pattern == "SELL SIG" ? "▼ " : "") + last_pattern, text_color=pattern_color, text_size=size.small, text_halign=text.align_left)
    table.merge_cells(main_table, 1, 21, 3, 21)

    // SETTINGS SECTION
    header(main_table, 22, "SETTINGS")
    kv_row(main_table, 23, "Lot (AUTO)", str.tostring(i_lot, "#.00"), color.aqua)
    kv_row(main_table, 24, "SL / TP (AUTO)", "$" + str.tostring(i_sl, "#.00") + " / $" + str.tostring(i_tp, "#.00"), color.aqua)
    kv_row(main_table, 25, "Trailing", "$" + str.tostring(i_trail_start, "#.0") + " → $" + str.tostring(i_trail_step, "#.0"), color.aqua)
    kv_row(main_table, 26, "B.Even", "$" + str.tostring(i_be_start, "#.0") + " → $" + str.tostring(i_be_offset, "#.2"), color.aqua)

    // POSITIONS SECTION
    table.cell(main_table, 0, 27, "Positions", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(main_table, 1, 27, str.tostring(strategy.position_size == 0 ? 0 : 1) + " / 3", text_color=strategy.position_size != 0 ? color.lime : color.orange, text_size=size.small, text_halign=text.align_left)
    table.merge_cells(main_table, 1, 27, 3, 27)

// --- CHART VISUALS ---
plot(ema_fast, "Fast EMA", color=color.new(color.lime, 0), linewidth=1)
plot(ema_slow, "Slow EMA", color=color.new(color.red, 0), linewidth=1)

// Signals
plotshape(buy_sig, "Buy Signal", shape.triangleup, location.belowbar, color.lime, size=size.small)
plotshape(sell_sig, "Sell Signal", shape.triangledown, location.abovebar, color.red, size=size.small)

// Signal Labels
if buy_sig
    label.new(bar_index, low, "BUY SIG", color=color.new(color.black, 100), textcolor=color.lime, style=label.style_label_up, size=size.small)

if sell_sig
    label.new(bar_index, high, "SELL SIG", color=color.new(color.black, 100), textcolor=color.red, style=label.style_label_down, size=size.small)

// SL/TP Visuals
var line sl_line = na
var line tp_line = na

if strategy.position_size != 0
    float entry_price = strategy.opentrades.entry_price(strategy.opentrades - 1)
    float sl_price = strategy.position_size > 0 ? entry_price - sl_dist * syminfo.mintick : entry_price + sl_dist * syminfo.mintick
    float tp_price = strategy.position_size > 0 ? entry_price + tp_dist * syminfo.mintick : entry_price - tp_dist * syminfo.mintick

    if na(sl_line)
        sl_line := line.new(bar_index, sl_price, bar_index + 10, sl_price, color=color.red, style=line.style_dashed, extend=extend.right)
        tp_line := line.new(bar_index, tp_price, bar_index + 10, tp_price, color=color.lime, style=line.style_dashed, extend=extend.right)
    else
        line.set_xy1(sl_line, bar_index, sl_price)
        line.set_xy2(sl_line, bar_index + 10, sl_price)
        line.set_xy1(tp_line, bar_index, tp_price)
        line.set_xy2(tp_line, bar_index + 10, tp_price)
else
    line.delete(sl_line)
    line.delete(tp_line)
    sl_line := na
    tp_line := na
