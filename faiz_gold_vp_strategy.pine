//@version=6
strategy("Faiz Gold VP Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, max_labels_count=500, max_boxes_count=500)

// --- Inputs ---
session_input = input.session("0800-2200", "Trading Session")
timezone_input = input.string("UTC+3", "Timezone")
va_percent = input.float(70.0, "Value Area Percent", minval=0, maxval=100) / 100.0
row_size = input.int(24, "Volume Profile Rows", minval=5, maxval=100)

// Strategy Settings
use_failed_auction = input.bool(true, "Enable Failed Auction Setup")
use_breakout = input.bool(true, "Enable Breakout Setup")
momentum_filter = input.float(50.0, "Breakout Momentum Filter (Body %)", minval=0, maxval=100) / 100.0

// Risk Management
rr_ratio = input.float(2.0, "Risk:Reward Ratio")
sl_wick_buffer = input.float(1.0, "SL Wick Buffer (Ticks)", minval=0)

// --- Session Logic ---
is_in_session = not na(time(timeframe.period, session_input, timezone_input))
session_changed = ta.change(time(timeframe.period, session_input, timezone_input)) != 0

// --- Volume Profile Calculation ---
// We store bar data for the session to recalculate the profile on range expansion
var float[] bar_highs = array.new_float(0)
var float[] bar_lows = array.new_float(0)
var float[] bar_vols = array.new_float(0)

// VP Levels
var float vah = na
var float val = na
var float poc = na

if session_changed
    array.clear(bar_highs)
    array.clear(bar_lows)
    array.clear(bar_vols)
    vah := na
    val := na
    poc := na

if is_in_session
    array.push(bar_highs, high)
    array.push(bar_lows, low)
    array.push(bar_vols, volume)

    float s_high = array.max(bar_highs)
    float s_low = array.min(bar_lows)
    float s_range = s_high - s_low
    float step = s_range / row_size

    if s_range > 0
        float[] bins = array.new_float(row_size, 0.0)

        // Build profile from all session bars
        for i = 0 to array.size(bar_vols) - 1
            float b_h = array.get(bar_highs, i)
            float b_l = array.get(bar_lows, i)
            float b_v = array.get(bar_vols, i)

            // Distribute volume across bins the bar occupies
            int start_bin = math.max(0, math.floor((b_l - s_low) / step))
            int end_bin = math.min(row_size - 1, math.floor((b_h - s_low) / step))
            int num_bins = end_bin - start_bin + 1

            float vol_per_bin = b_v / num_bins
            for j = start_bin to end_bin
                array.set(bins, j, array.get(bins, j) + vol_per_bin)

        // Calculate POC
        int poc_idx = 0
        float max_v = -1.0
        for i = 0 to row_size - 1
            float v = array.get(bins, i)
            if v > max_v
                max_v := v
                poc_idx := i

        poc := s_low + (poc_idx * step) + (step / 2)

        // Calculate Value Area
        float total_v = array.sum(bins)
        float target_v = total_v * va_percent
        float current_v = array.get(bins, poc_idx)
        int u_idx = poc_idx
        int l_idx = poc_idx

        while current_v < target_v and (u_idx < row_size - 1 or l_idx > 0)
            float u_v = u_idx < row_size - 1 ? array.get(bins, u_idx + 1) : 0.0
            float l_v = l_idx > 0 ? array.get(bins, l_idx - 1) : 0.0

            if u_v >= l_v and u_idx < row_size - 1
                u_idx += 1
                current_v += u_v
            else if l_idx > 0
                l_idx -= 1
                current_v += l_v
            else
                break

        vah := s_low + (u_idx * step) + step
        val := s_low + (l_idx * step)

// --- Strategy Logic ---
float prev_vah = vah[1]
float prev_val = val[1]

// Track Multi-candle Sweeps
var bool swept_low = false
var bool swept_high = false

if session_changed
    swept_low := false
    swept_high := false

if is_in_session and not na(prev_vah) and not na(prev_val)
    if low < prev_val
        swept_low := true
    if high > prev_vah
        swept_high := true

    // Reset sweep if price goes too far or session ends (already handled)
    // Here we reset if price re-enters successfully
    if close > prev_val and swept_low
        swept_low := false
    if close < prev_vah and swept_high
        swept_high := false

// Failed Auction: Sweep and close back inside (Same bar or multi-bar)
bool long_fa = use_failed_auction and ((low < prev_val and close > prev_val) or (swept_low[1] and close > prev_val and close[1] <= prev_val))
bool short_fa = use_failed_auction and ((high > prev_vah and close < prev_vah) or (swept_high[1] and close < prev_vah and close[1] >= prev_vah))

// Breakout: Decisive close outside with momentum
float body = math.abs(close - open)
float r = high - low
bool mom = r > 0 and (body / r) >= momentum_filter

bool long_bo = use_breakout and close > prev_vah and open < prev_vah and mom
bool short_bo = use_breakout and close < prev_val and open > prev_val and mom

// --- Execution ---
if is_in_session and not na(prev_vah) and not na(prev_val)
    if long_fa or long_bo
        float sl = low - (sl_wick_buffer * syminfo.mintick)
        float risk = close - sl
        if risk > 0
            strategy.entry("Long", strategy.long, comment=long_fa ? "FA" : "BO")
            strategy.exit("ExL", "Long", stop=sl, limit=close + (risk * rr_ratio))

    if short_fa or short_bo
        float sl = high + (sl_wick_buffer * syminfo.mintick)
        float risk = sl - close
        if risk > 0
            strategy.entry("Short", strategy.short, comment=short_fa ? "FA" : "BO")
            strategy.exit("ExS", "Short", stop=sl, limit=close - (risk * rr_ratio))

// --- Visuals ---
plot(vah, "VAH", color.new(color.blue, 0), style=plot.style_linebr, linewidth=2)
plot(val, "VAL", color.new(color.blue, 0), style=plot.style_linebr, linewidth=2)
plot(poc, "POC", color.new(color.red, 0), style=plot.style_linebr, linewidth=1)
bgcolor(is_in_session ? color.new(color.gray, 90) : na)
