//@version=6
indicator("FX Telepath Confirmation Indicator [V6]", overlay = true, max_boxes_count = 500, max_labels_count = 500)

// --- Constants & Inputs ---
string htf_tf = input.timeframe("240", "Higher Timeframe")
int max_base_candles = input.int(6, "Max Base Candles", minval = 1, maxval = 10)
float erc_threshold = input.float(50.0, "ERC Threshold (%)", minval = 10.0, maxval = 90.0)

// --- MTF Data ---
[h_htf, l_htf, o_htf, c_htf, index_htf] = request.security(syminfo.tickerid, htf_tf, [high, low, open, close, bar_index], lookahead = barmerge.lookahead_off)

// --- Candle Classification ---
// LTF
float body_size = math.abs(close - open)
float candle_range = high - low
bool is_erc = candle_range > 0 and (body_size / candle_range) * 100 >= erc_threshold
bool is_boring = not is_erc

type LTFBar
    float h
    float l
    float o
    float c
    bool is_erc
    bool is_boring
    int b_idx

var LTFBar[] ltf_history = array.new<LTFBar>()
if barstate.isconfirmed
    array.unshift(ltf_history, LTFBar.new(high, low, open, close, is_erc, is_boring, bar_index))
    if array.size(ltf_history) > 50
        array.pop(ltf_history)

// HTF
float body_size_htf = math.abs(c_htf - o_htf)
float candle_range_htf = h_htf - l_htf
bool is_erc_htf = candle_range_htf > 0 and (body_size_htf / candle_range_htf) * 100 >= erc_threshold
bool is_boring_htf = not is_erc_htf

// --- Zone Detection Logic ---
enum ZoneType
    Supply
    Demand

type Zone
    ZoneType z_type
    int start_bar
    float proximal
    float distal
    bool active = true
    box z_box = na

type HTFBar
    float h
    float l
    float o
    float c
    bool is_erc
    bool is_boring

var HTFBar[] htf_history = array.new<HTFBar>()
var Zone[] htf_zones = array.new<Zone>()
var Zone[] ltf_zones = array.new<Zone>()

// Track LTF bar index at start of HTF bar
var int htf_start_ltf_idx = 0
if index_htf != index_htf[1]
    htf_start_ltf_idx := bar_index

// Store HTF History
if index_htf != index_htf[1]
    array.unshift(htf_history, HTFBar.new(h_htf, l_htf, o_htf, c_htf, is_erc_htf, is_boring_htf))
    if array.size(htf_history) > 20
        array.pop(htf_history)

// Function to detect patterns
detect_ltf_zones() =>
    if is_erc and array.size(ltf_history) > 2
        LTFBar leg_out = array.get(ltf_history, 0)
        int base_count = 0
        int leg_in_idx = -1
        for i = 1 to math.min(max_base_candles, array.size(ltf_history) - 1)
            LTFBar b = array.get(ltf_history, i)
            if b.is_boring
                base_count += 1
            else if b.is_erc
                leg_in_idx := i
                break
            else
                break
        if base_count >= 1 and leg_in_idx != -1
            LTFBar leg_in = array.get(ltf_history, leg_in_idx)
            bool is_supply = leg_in.c > leg_in.o and leg_out.c < leg_out.o or leg_in.c < leg_in.o and leg_out.c < leg_out.o
            bool is_demand = leg_in.c < leg_in.o and leg_out.c > leg_out.o or leg_in.c > leg_in.o and leg_out.c > leg_out.o
            if is_supply or is_demand
                float prox = na
                float dist = na
                if is_supply
                    LTFBar b1 = array.get(ltf_history, 1)
                    prox := math.min(b1.o, b1.c), dist := b1.h
                    if base_count > 1
                        for j = 2 to base_count
                            LTFBar bj = array.get(ltf_history, j)
                            prox := math.min(prox, math.min(bj.o, bj.c)), dist := math.max(dist, bj.h)
                    array.push(ltf_zones, Zone.new(ZoneType.Supply, leg_out.b_idx - base_count, prox, dist))
                else if is_demand
                    LTFBar b1 = array.get(ltf_history, 1)
                    prox := math.max(b1.o, b1.c), dist := b1.l
                    if base_count > 1
                        for j = 2 to base_count
                            LTFBar bj = array.get(ltf_history, j)
                            prox := math.max(prox, math.max(bj.o, bj.c)), dist := math.min(dist, bj.l)
                    array.push(ltf_zones, Zone.new(ZoneType.Demand, leg_out.b_idx - base_count, prox, dist))

detect_htf_zones() =>
    if index_htf != index_htf[1] and array.size(htf_history) > 2
        // Current completed HTF bar is at index 0 of htf_history
        HTFBar leg_out = array.get(htf_history, 0)

        if leg_out.is_erc
            int base_count = 0
            int leg_in_idx = -1

            for i = 1 to math.min(max_base_candles, array.size(htf_history) - 1)
                HTFBar b = array.get(htf_history, i)
                if b.is_boring
                    base_count += 1
                else if b.is_erc
                    leg_in_idx := i
                    break
                else
                    break

            if base_count >= 1 and leg_in_idx != -1
                HTFBar leg_in = array.get(htf_history, leg_in_idx)
                bool is_supply = false
                bool is_demand = false

                if leg_in.c < leg_in.o and leg_out.c > leg_out.o // DBR
                    is_demand := true
                else if leg_in.c > leg_in.o and leg_out.c > leg_out.o // RBR
                    is_demand := true
                else if leg_in.c > leg_in.o and leg_out.c < leg_out.o // RBD
                    is_supply := true
                else if leg_in.c < leg_in.o and leg_out.c < leg_out.o // DBD
                    is_supply := true

                if is_supply or is_demand
                    float prox = na
                    float dist = na

                    if is_supply
                        HTFBar b1 = array.get(htf_history, 1)
                        prox := math.min(b1.o, b1.c)
                        dist := b1.h
                        if base_count > 1
                            for j = 2 to base_count
                                HTFBar bj = array.get(htf_history, j)
                                prox := math.min(prox, math.min(bj.o, bj.c))
                                dist := math.max(dist, bj.h)
                        array.push(htf_zones, Zone.new(ZoneType.Supply, bar_index, prox, dist))

                    else if is_demand
                        HTFBar b1 = array.get(htf_history, 1)
                        prox := math.max(b1.o, b1.c)
                        dist := b1.l
                        if base_count > 1
                            for j = 2 to base_count
                                HTFBar bj = array.get(htf_history, j)
                                prox := math.max(prox, math.max(bj.o, bj.c))
                                dist := math.min(dist, bj.l)
                        array.push(htf_zones, Zone.new(ZoneType.Demand, bar_index, prox, dist))

// --- Confirmation Logic (ETF) ---
// 1. Structure Shift (CHoCH)
// 2. Zone Removal (Price closes beyond HTF zone or opposing LTF zone)

// Basic Swing High/Low
int lookback = 3
float swing_high = ta.pivothigh(high, lookback, lookback)
float swing_low = ta.pivotlow(low, lookback, lookback)

var float last_swing_high = na
var float last_swing_low = na
if not na(swing_high)
    last_swing_high := swing_high
if not na(swing_low)
    last_swing_low := swing_low

// State variables
var bool inside_supply = false
var bool inside_demand = false
var float active_htf_prox = na
var float active_htf_dist = na

// Check if price is inside any HTF zone
inside_supply := false
inside_demand := false
active_htf_prox := na
active_htf_dist := na

if array.size(htf_zones) > 0
    for i = array.size(htf_zones) - 1 to 0
        Zone z = array.get(htf_zones, i)
        if z.active
            if z.z_type == ZoneType.Supply
                if high >= z.proximal and low <= z.distal
                    inside_supply := true
                    active_htf_prox := z.proximal
                    active_htf_dist := z.distal
                    break
            else
                if low <= z.proximal and high >= z.distal
                    inside_demand := true
                    active_htf_prox := z.proximal
                    active_htf_dist := z.distal
                    break

// Zone Removal (LTF)
bool ltf_supply_removed = false
bool ltf_demand_removed = false

if array.size(ltf_zones) > 0
    for i = 0 to array.size(ltf_zones) - 1
        Zone z = array.get(ltf_zones, i)
        if z.active
            if z.z_type == ZoneType.Supply and close > z.distal
                z.active := false
                ltf_supply_removed := true
            else if z.z_type == ZoneType.Demand and close < z.distal
                z.active := false
                ltf_demand_removed := true

// Structure Shift
bool mss_bull = inside_demand and ta.crossover(close, last_swing_high)
bool mss_bear = inside_supply and ta.crossunder(close, last_swing_low)

// Zone Removal Confirmation
bool zr_bull = inside_demand and ltf_supply_removed
bool zr_bear = inside_supply and ltf_demand_removed

// Zone Removal (Simplified for this script: mark HTF zone as inactive if price closes beyond distal)
if array.size(htf_zones) > 0
    for i = 0 to array.size(htf_zones) - 1
        Zone z = array.get(htf_zones, i)
        if z.active
            if z.z_type == ZoneType.Supply and close > z.distal
                z.active := false
            else if z.z_type == ZoneType.Demand and close < z.distal
                z.active := false

if barstate.isconfirmed
    detect_ltf_zones()
    detect_htf_zones()

// --- Visuals ---
// Update boxes for active zones
if barstate.islast
    if array.size(htf_zones) > 0
        for i = 0 to array.size(htf_zones) - 1
            Zone z = array.get(htf_zones, i)
            if z.active
                if na(z.z_box)
                    color b_color = z.z_type == ZoneType.Supply ? color.new(color.red, 80) : color.new(color.blue, 80)
                    color border_color = z.z_type == ZoneType.Supply ? color.red : color.blue
                    z.z_box := box.new(z.start_bar, z.distal, bar_index, z.proximal,
                                         bgcolor = b_color, border_color = border_color,
                                         extend = extend.right)
                else
                    box.set_right(z.z_box, bar_index)
            else
                if not na(z.z_box)
                    box.delete(z.z_box)
                    z.z_box := na

// Labels for Signals - Wrapped in isconfirmed to prevent flickering/duplicates
if barstate.isconfirmed
    if mss_bull
        label.new(bar_index, low, "MSS BULL", color = color.green, textcolor = color.white, style = label.style_label_up)
    if mss_bear
        label.new(bar_index, high, "MSS BEAR", color = color.red, textcolor = color.white, style = label.style_label_down)
    if zr_bull
        label.new(bar_index, low, "ZR BULL", color = color.teal, textcolor = color.white, style = label.style_label_up)
    if zr_bear
        label.new(bar_index, high, "ZR BEAR", color = color.maroon, textcolor = color.white, style = label.style_label_down)

// Dashboard
var table status_table = table.new(position.top_right, 2, 3, border_width = 1)
if barstate.islast
    table.cell(status_table, 0, 0, "Metric", bgcolor = color.gray, text_color = color.white)
    table.cell(status_table, 1, 0, "Value", bgcolor = color.gray, text_color = color.white)

    table.cell(status_table, 0, 1, "HTF Trend", text_halign = text.align_left)
    bool is_htf_bull = false
    if array.size(htf_history) >= 2
        is_htf_bull := array.get(htf_history, 0).c > array.get(htf_history, 1).c
    string trend_val = is_htf_bull ? "BULLISH" : "BEARISH"
    color trend_col = is_htf_bull ? color.aqua : color.red
    table.cell(status_table, 1, 1, trend_val, text_color = trend_col)

    table.cell(status_table, 0, 2, "Zone Status", text_halign = text.align_left)
    string status_val = inside_supply ? "Inside Supply" : inside_demand ? "Inside Demand" : "Neutral"
    color status_col = inside_supply ? color.red : inside_demand ? color.blue : color.gray
    table.cell(status_table, 1, 2, status_val, text_color = status_col)

// --- Final Cleanup/Optimizations ---
// Limit number of zones to prevent performance issues
if array.size(htf_zones) > 100
    Zone old_z = array.shift(htf_zones)
    if not na(old_z.z_box)
        box.delete(old_z.z_box)

if array.size(ltf_zones) > 100
    array.shift(ltf_zones)
