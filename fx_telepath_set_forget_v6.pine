//@version=6
indicator("FX Telepath Set & Forget [v6]", overlay = true, max_boxes_count = 500, max_labels_count = 500)

// --- Inputs ---
group_candle = "Candle Classification"
perc_body_min = input.float(50.0, "ERC Body % Threshold", minval = 0.0, maxval = 100.0, group = group_candle)

group_zones = "Zone Detection"
max_base_candles = input.int(6, "Max Base Candles", minval = 1, maxval = 10, group = group_zones)
min_legout_erc = input.bool(true, "Require ERC Leg-out", group = group_zones)

group_odds = "High Odds Criteria"
high_odds_base_max = input.int(3, "High Odds Max Base Candles", group = group_odds)
use_trend_filter = input.bool(true, "Trend Alignment Filter", group = group_odds)
explosive_legout = input.bool(true, "Require Explosive Leg-out (2x Body)", group = group_odds)
pivot_len = input.int(5, "Market Structure Pivot Length", minval = 1, group = group_odds)

group_visuals = "Visuals"
up_zone_col = input.color(color.new(color.green, 80), "Demand Zone Color", group = group_visuals)
dn_zone_col = input.color(color.new(color.red, 80), "Supply Zone Color", group = group_visuals)
show_high_odds_only = input.bool(false, "Show High Odds Only", group = group_visuals)
show_rr = input.bool(true, "Show SL/TP Labels (Set & Forget)", group = group_visuals)
rr_ratio = input.float(3.0, "Risk:Reward Ratio", minval = 0.1, group = group_visuals)

// --- Candle Classification ---
candle_span = high - low
candle_body = math.abs(close - open)
is_boring = candle_span > 0 ? (candle_body / candle_span) * 100 < perc_body_min : true
is_erc = not is_boring

avg_body_20 = ta.sma(candle_body, 20)

// --- UDTs ---
type Zone
    float proximal
    float distal
    int   base_start_bar
    int   base_end_bar
    bool  is_demand
    bool  is_mitigated = false
    bool  is_high_odds = false
    box   box_id = na

var Zone[] demand_zones = array.new<Zone>()
var Zone[] supply_zones = array.new<Zone>()

// --- Trend Identification (Market Structure) ---
float ph = ta.pivothigh(high, pivot_len, pivot_len)
float pl = ta.pivotlow(low, pivot_len, pivot_len)

var float last_ph = na
var float last_pl = na
var int trend_direction = 0 // 0: unknown, 1: up, 2: down

if not na(ph)
    if not na(last_ph)
        if ph > last_ph
            trend_direction := 1
        else if ph < last_ph
            trend_direction := -1
    last_ph := ph

if not na(pl)
    if not na(last_pl)
        if pl > last_pl
            trend_direction := 1
        else if pl < last_pl
            trend_direction := -1
    last_pl := pl

// --- Helper Functions ---
create_zone(float p_prox, float p_dist, int p_start, int p_end, bool p_is_dem, bool p_high_odds, Zone[] p_zones, color p_col, bool p_legout_ok) =>
    bool trend_ok = not use_trend_filter or trend_direction == 0 or (p_is_dem ? trend_direction == 1 : trend_direction == -1)
    bool final_high_odds = p_high_odds and trend_ok and p_legout_ok
    if not show_high_odds_only or final_high_odds
        Zone new_zone = Zone.new(p_prox, p_dist, p_start, p_end, p_is_dem)
        new_zone.is_high_odds := final_high_odds
        new_zone.box_id := box.new(p_start, math.max(p_prox, p_dist), bar_index, math.min(p_prox, p_dist),
          bgcolor = p_col, border_color = na,
          extend = extend.none)
        if final_high_odds
            float lbl_y = p_is_dem ? math.min(p_prox, p_dist) : math.max(p_prox, p_dist)
            label.new(p_start, lbl_y, "HIGH ODDS",
              color = color.new(color.yellow, 20),
              style = p_is_dem ? label.style_label_up : label.style_label_down,
              textcolor = color.black, size = size.small)

            if show_rr
                float risk = math.abs(p_prox - p_dist)
                float tp_price = p_is_dem ? p_prox + risk * rr_ratio : p_prox - risk * rr_ratio
                string tp_text = "TP: " + str.tostring(tp_price, format.mintick)
                label.new(bar_index, tp_price, tp_text,
                  color = color.new(color.lime, 20),
                  style = p_is_dem ? label.style_label_down : label.style_label_up,
                  textcolor = color.black, size = size.small)
                string sl_text = "SL: " + str.tostring(p_dist, format.mintick)
                label.new(bar_index, p_dist, sl_text,
                  color = color.new(color.red, 20),
                  style = p_is_dem ? label.style_label_up : label.style_label_down,
                  textcolor = color.white, size = size.small)
        p_zones.push(new_zone)
        if p_zones.size() > 100
            p_zones.shift()

// --- Pattern Detection ---
bool leg_out_valid = not min_legout_erc or is_erc
if barstate.isconfirmed and leg_out_valid
    int base_count = 0
    for i = 1 to max_base_candles
        if is_boring[i]
            base_count += 1
        else
            break

    if base_count >= 1 and base_count <= max_base_candles
        bool leg_out_up = close > open
        bool leg_in_up = close[base_count + 1] > open[base_count + 1]
        bool leg_in_dn = close[base_count + 1] < open[base_count + 1]

        float base_max_h = -1.0
        float base_min_l = 1000000000.0
        float base_max_body_h = -1.0
        float base_min_body_l = 1000000000.0

        for i = 1 to base_count
            base_max_h := math.max(base_max_h, high[i])
            base_min_l := math.min(base_min_l, low[i])
            base_max_body_h := math.max(base_max_body_h, math.max(open[i], close[i]))
            base_min_body_l := math.min(base_min_body_l, math.min(open[i], close[i]))

        // High Odds checks
        float avg_body = avg_body_20[1]
        bool is_explosive = candle_body >= 2 * avg_body
        bool legout_ok = not explosive_legout or is_explosive

        // Reversal Patterns
        if leg_out_up and leg_in_dn // DBR
            create_zone(base_max_body_h, base_min_l, bar_index - base_count, bar_index - 1, true, base_count <= high_odds_base_max, demand_zones, up_zone_col, legout_ok)
        else if not leg_out_up and leg_in_up // RBD
            create_zone(base_min_body_l, base_max_h, bar_index - base_count, bar_index - 1, false, base_count <= high_odds_base_max, supply_zones, dn_zone_col, legout_ok)
        // Continuation Patterns
        else if leg_out_up and leg_in_up // RBR
            create_zone(base_max_body_h, base_min_l, bar_index - base_count, bar_index - 1, true, base_count <= high_odds_base_max, demand_zones, up_zone_col, legout_ok)
        else if not leg_out_up and leg_in_dn // DBD
            create_zone(base_min_body_l, base_max_h, bar_index - base_count, bar_index - 1, false, base_count <= high_odds_base_max, supply_zones, dn_zone_col, legout_ok)

// --- Zone Management and Drawing ---
process_zones(Zone[] zones) =>
    if zones.size() > 0
        for i = 0 to zones.size() - 1
            Zone z = zones.get(i)
            if not z.is_mitigated
                // Update box end
                if not na(z.box_id)
                    box.set_right(z.box_id, bar_index)

                // Check for mitigation
                if z.is_demand
                    if close < z.distal
                        z.is_mitigated := true
                        box.set_right(z.box_id, bar_index)
                else
                    if close > z.distal
                        z.is_mitigated := true
                        box.set_right(z.box_id, bar_index)

process_zones(demand_zones)
process_zones(supply_zones)

// --- Plotting for verification ---
plotshape(is_boring, "Boring Candle", shape.circle, location.abovebar, color.gray, size = size.tiny, display = display.none)
plotshape(is_erc, "ERC Candle", shape.diamond, location.belowbar, color.blue, size = size.tiny, display = display.none)
