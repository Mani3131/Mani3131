//@version=6
indicator("Gold Macro Daily Bias Strategy [Mani3131]", overlay=true, max_boxes_count=500, max_labels_count=500)

// Strategy Parameters
var string G_DAILY = "Macro Daily Bias"
dailyLookback = input.int(20, "Daily Swing Lookback", minval=2, group=G_DAILY)

var string G_INTRADAY = "Intraday Narrative (1H)"
showMSS = input.bool(true, "Show Market Structure Shift (MSS)", group=G_INTRADAY)
showSweeps = input.bool(true, "Show Liquidity Sweeps", group=G_INTRADAY)

var string G_ENTRY = "Entry Zones"
showOB = input.bool(true, "Show Order Blocks (OB)", group=G_ENTRY)
showFVG = input.bool(true, "Show Fair Value Gaps (FVG)", group=G_ENTRY)

// --- Macro Daily Bias Logic ---
[dHigh, dLow] = request.security(syminfo.tickerid, "D", [ta.highest(high, dailyLookback), ta.lowest(low, dailyLookback)])
dEquilibrium = (dHigh + dLow) / 2

// Execution Bias
isPremium = close > dEquilibrium
isDiscount = close < dEquilibrium
dailyBias = isPremium ? "Premium (Sells)" : isDiscount ? "Discount (Buys)" : "Equilibrium"
biasColor = isPremium ? color.red : isDiscount ? color.green : color.gray

// Visualization - Daily Levels
var line lineHigh = line.new(int(na), float(na), int(na), float(na), color=color.red, style=line.style_dashed)
var line lineLow = line.new(int(na), float(na), int(na), float(na), color=color.green, style=line.style_dashed)
var line lineMid = line.new(int(na), float(na), int(na), float(na), color=color.gray, style=line.style_dotted)

if barstate.islast
    x1 = bar_index - math.min(bar_index, 500)
    line.set_xy1(lineHigh, x1, dHigh)
    line.set_xy2(lineHigh, bar_index, dHigh)
    line.set_xy1(lineLow, x1, dLow)
    line.set_xy2(lineLow, bar_index, dLow)
    line.set_xy1(lineMid, x1, dEquilibrium)
    line.set_xy2(lineMid, bar_index, dEquilibrium)

// --- Intraday Narrative (1H) ---
var float lastPH = float(na)
var float lastPL = float(na)
ph = ta.pivothigh(high, 5, 5)
pl = ta.pivotlow(low, 5, 5)

if not na(ph)
    lastPH := ph
if not na(pl)
    lastPL := pl

// Liquidity Sweep
bullSweep = low < lastPL and close > lastPL
bearSweep = high > lastPH and close < lastPH

// MSS Logic
var bool waitingForBullMSS = false
var bool waitingForBearMSS = false
var float sweepLow = float(na)
var float sweepHigh = float(na)

if bullSweep
    waitingForBullMSS := true
    sweepLow := low
    waitingForBearMSS := false

if bearSweep
    waitingForBearMSS := true
    sweepHigh := high
    waitingForBullMSS := false

mssBull = waitingForBullMSS and ta.crossover(close, lastPH)
mssBear = waitingForBearMSS and ta.crossunder(close, lastPL)

if mssBull
    waitingForBullMSS := false
if mssBear
    waitingForBearMSS := false

// Continuation Rule (50% of sweeping leg)
var float bullLegMid = float(na)
var float bearLegMid = float(na)

if bullSweep
    bullLegMid := (low + lastPL) / 2
if bearSweep
    bearLegMid := (high + lastPH) / 2

continuationSignal = (mssBull and close > bullLegMid) or (mssBear and close < bearLegMid)

// Visualization - Sweeps and MSS
plotshape(showSweeps and bullSweep, "Bullish Sweep", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(showSweeps and bearSweep, "Bearish Sweep", shape.triangledown, location.abovebar, color.red, size=size.small)
plotshape(showMSS and mssBull, "MSS Bullish", shape.labelup, location.belowbar, color.blue, text="MSS", textcolor=color.white, size=size.small)
plotshape(showMSS and mssBear, "MSS Bearish", shape.labeldown, location.abovebar, color.orange, text="MSS", textcolor=color.white, size=size.small)

// --- Entry Zones and Triggers ---

// FVG Detection
bullFVG = low > high[2] and close[1] > high[2]
bearFVG = high < low[2] and close[1] < low[2]

if showFVG
    if bullFVG
        box.new(bar_index[2], high[2], bar_index, low, bgcolor=color.new(color.green, 90), border_color=color(na))
    if bearFVG
        box.new(bar_index[2], low[2], bar_index, high, bgcolor=color.new(color.red, 90), border_color=color(na))

// Order Block (OB) - Last opposing candle before displacement
// Displacement is characterized by an FVG.
var box lastBullOB = box(na)
var box lastBearOB = box(na)

if bullFVG
    // Look for last bearish candle starting from candle 2 (the start of the FVG)
    for i = 2 to 10
        if close[i] < open[i]
            if showOB
                box.set_extend(lastBullOB, extend.none)
                lastBullOB := box.new(bar_index[i], high[i], bar_index[i], low[i], bgcolor=color.new(color.blue, 80), border_color=color.blue, extend=extend.right)
            break

if bearFVG
    // Look for last bullish candle starting from candle 2
    for i = 2 to 10
        if close[i] > open[i]
            if showOB
                box.set_extend(lastBearOB, extend.none)
                lastBearOB := box.new(bar_index[i], high[i], bar_index[i], low[i], bgcolor=color.new(color.orange, 80), border_color=color.orange, extend=extend.right)
            break

// Energy Compression Zones
wickSize = high - math.max(open, close) + math.min(open, close) - low
bodySize = math.abs(open - close)
isCompression = bodySize < wickSize and bodySize < ta.sma(bodySize, 20)
// Triangle-like consolidation: narrowing range
isConsolidation = ta.atr(10) < ta.atr(50) * 0.8

plotshape(isCompression and isConsolidation, "Compression Zone", shape.diamond, location.abovebar, color.purple, size=size.tiny)

// Disabled Candle Breakout
// Large body, zero wick on one side
disabledBull = close > open and bodySize > ta.sma(bodySize, 20) * 1.5 and (high == close or low == open)
disabledBear = close < open and bodySize > ta.sma(bodySize, 20) * 1.5 and (low == close or high == open)

plotshape(disabledBull, "Disabled Bullish", shape.arrowup, location.belowbar, color.green, size=size.small)
plotshape(disabledBear, "Disabled Bearish", shape.arrowdown, location.abovebar, color.red, size=size.small)

// --- Dashboard ---
var table dash = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 50), border_width=1, border_color=color.gray)

if barstate.islast
    table.cell(dash, 0, 0, "Metric", text_color=color.white, text_halign=text.align_left)
    table.cell(dash, 1, 0, "Value", text_color=color.white, text_halign=text.align_left)

    table.cell(dash, 0, 1, "Daily Bias", text_color=color.white, text_halign=text.align_left)
    table.cell(dash, 1, 1, dailyBias, text_color=biasColor, text_halign=text.align_left)

    table.cell(dash, 0, 2, "1H Structure", text_color=color.white, text_halign=text.align_left)
    table.cell(dash, 1, 2, mssBull ? "MSS Bullish" : mssBear ? "MSS Bearish" : "Neutral", text_color=mssBull ? color.green : mssBear ? color.red : color.gray, text_halign=text.align_left)

    table.cell(dash, 0, 3, "Compression", text_color=color.white, text_halign=text.align_left)
    table.cell(dash, 1, 3, isCompression ? "Yes" : "No", text_color=isCompression ? color.purple : color.gray, text_halign=text.align_left)

    table.cell(dash, 0, 4, "Signal", text_color=color.white, text_halign=text.align_left)
    table.cell(dash, 1, 4, continuationSignal ? "Continuation" : "None", text_color=continuationSignal ? color.yellow : color.gray, text_halign=text.align_left)

// Alerts
alertcondition(bullSweep or bearSweep, "Liquidity Sweep", "Gold Liquidity Sweep Detected!")
alertcondition(mssBull or mssBear, "Market Structure Shift", "Gold MSS Detected!")
alertcondition(disabledBull or disabledBear, "Disabled Candle Breakout", "Gold Momentum Breakout Detected!")

plot(close, color=color.new(color.gray, 100))
