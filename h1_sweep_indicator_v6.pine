//@version=6
indicator("H1 Sweep Entry Strategy", overlay = true, max_labels_count = 500)

// --- Instructions from prompt ---
// 1. Session: 17:30 - 21:00 UTC+3. Anchor: High/Low of most recently closed H1 bar.
// 2. Sweep (Candle 2): LTF High/Low pierces H1 boundary, Close is back inside.
// 3. Entry (Candle 3): Break of Sweep candle's extreme (Low for short, High for long).

// Ensure historical buffer is established
max_bars_back(high, 500)
max_bars_back(low, 500)
max_bars_back(close, 500)

// --- Inputs ---
var string GP1 = "Session Settings"
session_input = input.session("1730-2100", "Trading Session (UTC+3)", group = GP1)
timezone_input = input.string("UTC+3", "Timezone", group = GP1)

var string GP2 = "Visuals"
show_h1_levels = input.bool(true, "Show H1 Anchor Levels", group = GP2)
h1_color = input.color(color.gray, "H1 Level Color", group = GP2)
sweep_color = input.color(color.yellow, "Sweep Candle Color", group = GP2)
long_color = input.color(color.green, "Long Signal Color", group = GP2)
short_color = input.color(color.red, "Short Signal Color", group = GP2)

// --- Session Logic ---
in_session = not na(time(timeframe = "1", session = session_input, timezone = timezone_input))

// --- H1 Anchor Logic ---
// Fetch the high and low of the most recently closed H1 bar.
// request.security with lookahead_off returns the last completed bar's value.
[h1_high_raw, h1_low_raw] = request.security(syminfo.tickerid, "60", [high, low], lookahead = barmerge.lookahead_off)

var float h1_high = na
var float h1_low = na

if in_session
    h1_high := h1_high_raw
    h1_low := h1_low_raw
else
    h1_high := na
    h1_low := na

// Plot H1 Levels
plot(show_h1_levels and in_session ? h1_high : na, "H1 High Anchor", color = h1_color, style = plot.style_linebr, linewidth = 2)
plot(show_h1_levels and in_session ? h1_low : na, "H1 Low Anchor", color = h1_color, style = plot.style_linebr, linewidth = 2)

// --- Sweep Matrix (Candle 2) ---
var float short_trigger_price = na
var float long_trigger_price = na
var bool high_sweep_active = false
var bool low_sweep_active = false

// Reset sweep states when session starts or ends
session_start = in_session and not in_session[1]
if not in_session or session_start
    high_sweep_active := false
    low_sweep_active := false
    short_trigger_price := na
    long_trigger_price := na

// Detect Sweep
// Candle 2: High/Low pierces outside, Close is back inside.
is_high_sweep = in_session and high > h1_high and close < h1_high
is_low_sweep = in_session and low < h1_low and close > h1_low

if is_high_sweep
    high_sweep_active := true
    short_trigger_price := low
    label.new(bar_index, high, "High Sweep", color = color.new(short_color, 50), textcolor = color.white, style = label.style_label_down)

if is_low_sweep
    low_sweep_active := true
    long_trigger_price := high
    label.new(bar_index, low, "Low Sweep", color = color.new(long_color, 50), textcolor = color.white, style = label.style_label_up)

// Highlight sweep candle
barcolor(is_high_sweep or is_low_sweep ? sweep_color : na)

// --- Entry Signal Matrix (Candle 3 Execution) ---
var bool long_triggered = false
var bool short_triggered = false

// Reset triggers when session starts or a new sweep happens
if not in_session or session_start
    long_triggered := false
    short_triggered := false

if is_high_sweep
    short_triggered := false
if is_low_sweep
    long_triggered := false

// For Short: Break below the low of the sweeping bar
short_signal = high_sweep_active and not short_triggered and low < short_trigger_price
// For Long: Break above the high of the sweeping bar
long_signal = low_sweep_active and not long_triggered and high > long_trigger_price

if long_signal
    long_triggered := true
    label.new(bar_index, low, "LONG", color = long_color, textcolor = color.white, style = label.style_label_up, size = size.large)
    alert("Long Signal: Price broke above Low Sweep candle high", alert.freq_once_per_bar)

if short_signal
    short_triggered := true
    label.new(bar_index, high, "SHORT", color = short_color, textcolor = color.white, style = label.style_label_down, size = size.large)
    alert("Short Signal: Price broke below High Sweep candle low", alert.freq_once_per_bar)

// --- Visual feedback for active setups ---
plotshape(high_sweep_active and not short_triggered, "Awaiting Short", shape.triangledown, location.top, color = color.new(short_color, 80), size = size.tiny)
plotshape(low_sweep_active and not long_triggered, "Awaiting Long", shape.triangleup, location.bottom, color = color.new(long_color, 80), size = size.tiny)

// --- Dashboard ---
var table status_table = table.new(position.top_right, 2, 4, border_width = 1)
if barstate.islast
    table.cell(status_table, 0, 0, "Metric", bgcolor = color.gray, text_color = color.white)
    table.cell(status_table, 1, 0, "Value", bgcolor = color.gray, text_color = color.white)

    table.cell(status_table, 0, 1, "In Session")
    table.cell(status_table, 1, 1, in_session ? "YES" : "NO", bgcolor = in_session ? color.green : color.red)

    table.cell(status_table, 0, 2, "Active Sweep")
    string sweep_status = (high_sweep_active and low_sweep_active) ? "BOTH" : high_sweep_active ? "HIGH" : low_sweep_active ? "LOW" : "NONE"
    color sweep_bg = (high_sweep_active and low_sweep_active) ? color.orange : high_sweep_active ? color.red : low_sweep_active ? color.green : color.gray
    table.cell(status_table, 1, 2, sweep_status, bgcolor = sweep_bg)

    table.cell(status_table, 0, 3, "H1 High/Low")
    table.cell(status_table, 1, 3, str.tostring(h1_high, "#.#####") + " / " + str.tostring(h1_low, "#.#####"))
