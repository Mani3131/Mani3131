//@version=6
indicator("Impulse Heatmap v6", overlay=true, max_labels_count=500, max_boxes_count=500)

// --- Inputs ---
var group_calc = "Calculation Settings"
ema_len   = input.int(13, "EMA Length", group=group_calc)
fast_len  = input.int(12, "MACD Fast Length", group=group_calc)
slow_len  = input.int(26, "MACD Slow Length", group=group_calc)
sig_len   = input.int(9,  "MACD Signal Length", group=group_calc)

var group_ui = "UI Settings"
table_pos = input.string(position.top_right, "Table Position", options=[position.top_right, position.bottom_right, position.top_left, position.bottom_left, position.middle_right], group=group_ui)
text_size = input.string(size.small, "Text Size", options=[size.tiny, size.small, size.normal, size.large], group=group_ui)

// --- Colors ---
color_bull = color.new(color.green, 0)
color_bear = color.new(color.red, 0)
color_neut = color.new(color.blue, 0)
color_bg   = color.new(color.gray, 80)
color_txt  = color.white

// --- Impulse Logic Function ---
// Returns: 1 for Bullish, -1 for Bearish, 0 for Neutral
f_impulse_state() =>
    ema = ta.ema(close, ema_len)
    [macd_line, signal_line, _] = ta.macd(close, fast_len, slow_len, sig_len)
    hist = macd_line - signal_line

    ema_rising  = ema > ema[1]
    ema_falling = ema < ema[1]
    hist_rising  = hist > hist[1]
    hist_falling = hist < hist[1]

    int state = 0
    if ema_rising and hist_rising
        state := 1
    else if ema_falling and hist_falling
        state := -1
    else
        state := 0
    state

// --- MTF Data Fetching ---
// We use a helper to get the state for a specific timeframe
get_mtf_state(string tf) =>
    request.security(syminfo.tickerid, tf, f_impulse_state()[1], lookahead=barmerge.lookahead_on)

// Timeframes to display
tf1 = input.timeframe("1", "Timeframe 1")
tf2 = input.timeframe("5", "Timeframe 2")
tf3 = input.timeframe("15", "Timeframe 3")
tf4 = input.timeframe("60", "Timeframe 4")
tf5 = input.timeframe("240", "Timeframe 5")
tf6 = input.timeframe("D", "Timeframe 6")
tf7 = input.timeframe("W", "Timeframe 7")

s1 = get_mtf_state(tf1)
s2 = get_mtf_state(tf2)
s3 = get_mtf_state(tf3)
s4 = get_mtf_state(tf4)
s5 = get_mtf_state(tf5)
s6 = get_mtf_state(tf6)
s7 = get_mtf_state(tf7)
s_curr = f_impulse_state()

// --- Bar Coloring ---
bar_color = s_curr == 1 ? color_bull : s_curr == -1 ? color_bear : color_neut
barcolor(bar_color)

// --- Dashboard Table ---
var table heatmap = table.new(table_pos, 2, 8, border_width=1, border_color=color.gray)

// Rows helper - declared at global scope for v6 best practices
f_fill_cell(table tbl, int row, string tf_name, int state, color c_bull, color c_bear, color c_neut, color c_bg, color c_txt, string t_size) =>
    color c = state == 1 ? c_bull : state == -1 ? c_bear : c_neut
    string txt = state == 1 ? "BULL" : state == -1 ? "BEAR" : "NEUT"
    table.cell(tbl, 0, row, tf_name, bgcolor=c_bg, text_color=c_txt, text_size=t_size)
    table.cell(tbl, 1, row, txt,       bgcolor=c,        text_color=c_txt, text_size=t_size)

if barstate.islast
    // Header
    table.cell(heatmap, 0, 0, "Timeframe", bgcolor=color_bg, text_color=color_txt, text_size=text_size)
    table.cell(heatmap, 1, 0, "Impulse",   bgcolor=color_bg, text_color=color_txt, text_size=text_size)

    f_fill_cell(heatmap, 1, tf1, s1, color_bull, color_bear, color_neut, color_bg, color_txt, text_size)
    f_fill_cell(heatmap, 2, tf2, s2, color_bull, color_bear, color_neut, color_bg, color_txt, text_size)
    f_fill_cell(heatmap, 3, tf3, s3, color_bull, color_bear, color_neut, color_bg, color_txt, text_size)
    f_fill_cell(heatmap, 4, tf4, s4, color_bull, color_bear, color_neut, color_bg, color_txt, text_size)
    f_fill_cell(heatmap, 5, tf5, s5, color_bull, color_bear, color_neut, color_bg, color_txt, text_size)
    f_fill_cell(heatmap, 6, tf6, s6, color_bull, color_bear, color_neut, color_bg, color_txt, text_size)
    f_fill_cell(heatmap, 7, tf7, s7, color_bull, color_bear, color_neut, color_bg, color_txt, text_size)
