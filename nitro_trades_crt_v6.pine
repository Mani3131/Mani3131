//@version=6
strategy("NitroTrades CRT Strategy", overlay=true, margin_long=100, margin_short=100, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ==========================================
// Inputs
// ==========================================
grp_gen = "General Settings"
ref_tf = input.timeframe("60", "Reference Timeframe", group=grp_gen)
use_session = input.bool(true, "Use Session Filter", group=grp_gen)
session_time = input.session("0800-2000:1234567", "Session Time", group=grp_gen, tooltip="Default covers London & NY")
tz_input = input.string("UTC+3", "Timezone", group=grp_gen)

grp_entry = "Entry Settings"
use_fvg_entry = input.bool(true, "Entry on FVG Retest", group=grp_entry)
fvg_lookback = input.int(10, "FVG Lookback Bars", minval=1, group=grp_entry)

grp_risk = "Risk Management"
rr_ratio = input.float(2.0, "Risk:Reward Ratio", minval=0.1, group=grp_risk)
risk_per_trade = input.float(1.0, "Risk % Per Trade", minval=0.1, group=grp_risk)

grp_vis = "Visualization"
show_ref_range = input.bool(true, "Show Reference Range", group=grp_vis)
show_dashboard = input.bool(true, "Show Dashboard", group=grp_vis)

// ==========================================
// Logic & Calculations
// ==========================================

// Ensure historical buffer for calculations
max_bars_back(high, 500)
max_bars_back(low, 500)
max_bars_back(close, 500)

// Get Reference Candle Range (Last Completed HTF Candle)
[ref_high, ref_low] = request.security(syminfo.tickerid, ref_tf, [high, low], lookahead=barmerge.lookahead_off)

// Session Logic
is_in_session = not use_session or not na(time(timeframe.period, session_time, timezone = tz_input))

// State Variables
var float current_ref_high = na
var float current_ref_low = na
var bool high_swept = false
var bool low_swept = false
var float sweep_extreme = na
var bool setup_active_long = false
var bool setup_active_short = false

// Detect New Reference Candle
new_ref_candle = ta.change(time(ref_tf)) != 0

if new_ref_candle
    current_ref_high := ref_high
    current_ref_low := ref_low
    high_swept := false
    low_swept := false
    setup_active_long := false
    setup_active_short := false
    sweep_extreme := na

// 1. Detect Sweeps
// A sweep occurs when price goes beyond the reference extreme
if is_in_session and not high_swept and high > current_ref_high
    high_swept := true
    sweep_extreme := high
    setup_active_short := true

if is_in_session and not low_swept and low < current_ref_low
    low_swept := true
    sweep_extreme := low
    setup_active_long := true

// Update sweep extreme if price goes further before MSS
if setup_active_short and high > sweep_extreme
    sweep_extreme := high

if setup_active_long and low < sweep_extreme
    sweep_extreme := low

// 2. LTF Confirmation: Market Structure Shift (MSS) / Return to Range
// We look for a candle close reversing back into the range
mss_short = setup_active_short and ta.crossunder(close, current_ref_high)
mss_long = setup_active_long and ta.crossover(close, current_ref_low)

// 3. FVG Detection & Entry
var float entry_price = na
var float sl_price = na
var float tp_price = na
var string last_signal = "None"

if mss_long and not (strategy.position_size > 0)
    // Search for a Bullish FVG in the last X bars
    float found_fvg = na
    for i = 0 to fvg_lookback
        if low[i] > high[i+2] and close[i+1] > high[i+2]
            found_fvg := low[i]
            break

    if not na(found_fvg) or not use_fvg_entry
        entry_price := use_fvg_entry ? found_fvg : close
        sl_price := sweep_extreme - syminfo.mintick * 10
        tp_price := entry_price + (entry_price - sl_price) * rr_ratio

        strategy.entry("CRT Long", strategy.long, limit = use_fvg_entry ? entry_price : na)
        strategy.exit("Exit Long", "CRT Long", stop = sl_price, limit = tp_price)
        setup_active_long := false
        last_signal := "Bullish"
        label.new(bar_index, low, "BUY\n(CRT)", color=color.green, textcolor=color.white, style=label.style_label_up)

if mss_short and not (strategy.position_size < 0)
    // Search for a Bearish FVG in the last X bars
    float found_fvg = na
    for i = 0 to fvg_lookback
        if high[i] < low[i+2] and close[i+1] < low[i+2]
            found_fvg := high[i]
            break

    if not na(found_fvg) or not use_fvg_entry
        entry_price := use_fvg_entry ? found_fvg : close
        sl_price := sweep_extreme + syminfo.mintick * 10
        tp_price := entry_price - (sl_price - entry_price) * rr_ratio

        strategy.entry("CRT Short", strategy.short, limit = use_fvg_entry ? entry_price : na)
        strategy.exit("Exit Short", "CRT Short", stop = sl_price, limit = tp_price)
        setup_active_short := false
        last_signal := "Bearish"
        label.new(bar_index, high, "SELL\n(CRT)", color=color.red, textcolor=color.white, style=label.style_label_down)

// ==========================================
// Visualization
// ==========================================

// Plot Reference Range
var box ref_box = na
if new_ref_candle and show_ref_range
    ref_box := box.new(bar_index, current_ref_high, bar_index + 1, current_ref_low,
     border_color=color.new(color.gray, 50),
     bgcolor=color.new(color.gray, 90),
     extend=extend.right)

if not new_ref_candle and not na(ref_box)
    box.set_right(ref_box, bar_index)

plot(current_ref_high, "H1 High", color.new(color.red, 50), style=plot.style_linebr)
plot(current_ref_low, "H1 Low", color.new(color.green, 50), style=plot.style_linebr)

// Dashboard
var table dash = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 0), border_color=color.gray, border_width=1)
if show_dashboard and barstate.islast
    table.cell(dash, 0, 0, "NitroTrades CRT", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, "v6", text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 1, "High Swept", text_color=color.white)
    table.cell(dash, 1, 1, high_swept ? "YES" : "NO", bgcolor=high_swept ? color.red : color.gray)

    table.cell(dash, 0, 2, "Low Swept", text_color=color.white)
    table.cell(dash, 1, 2, low_swept ? "YES" : "NO", bgcolor=low_swept ? color.green : color.gray)

    table.cell(dash, 0, 3, "Session", text_color=color.white)
    table.cell(dash, 1, 3, is_in_session ? "ACTIVE" : "CLOSED", bgcolor=is_in_session ? color.teal : color.maroon)

    table.cell(dash, 0, 4, "Last Signal", text_color=color.white)
    table.cell(dash, 1, 4, last_signal, bgcolor=last_signal == "Bullish" ? color.green : (last_signal == "Bearish" ? color.red : color.gray))

    table.cell(dash, 0, 5, "Ref High/Low", text_color=color.white)
    table.cell(dash, 1, 5, na(current_ref_high) ? "Initializing..." : str.format("{0} / {1}", current_ref_high, current_ref_low), text_color=color.white)

// Alerts
alertcondition(mss_long, "CRT Bullish Setup", "Bullish Sweep + Return to Range")
alertcondition(mss_short, "CRT Bearish Setup", "Bearish Sweep + Return to Range")
