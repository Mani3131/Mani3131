//@version=6
indicator("Rich Zone", overlay = true, max_labels_count = 500, max_boxes_count = 500)

// --- Colors ---
color_bull = color.rgb(38, 166, 154) // Greenish
color_bear = color.rgb(239, 83, 80)  // Reddish
color_fvg_bull = color.new(color_bull, 85)
color_fvg_bear = color.new(color_bear, 85)

// --- Inputs ---
atr_length = input.int(10, "ATR Length", minval = 1)
atr_mult = input.float(3.0, "ATR Multiplier", step = 0.1)
fvg_extend = input.int(10, "FVG Extend Bars", minval = 1)

// --- FVG Logic ---
is_bull_fvg = low > high[2] and close[1] > high[2]
is_bear_fvg = high < low[2] and close[1] < low[2]

if is_bull_fvg and barstate.isconfirmed
    box.new(bar_index - 2, low, bar_index + fvg_extend, high[2],
     border_color = color.new(color_bull, 50),
     bgcolor = color_fvg_bull,
     text = "Bull FVG",
     text_size = size.tiny,
     text_color = color.new(color_bull, 20),
     text_halign = text.align_center,
     text_valign = text.align_center)

if is_bear_fvg and barstate.isconfirmed
    box.new(bar_index - 2, low[2], bar_index + fvg_extend, high,
     border_color = color.new(color_bear, 50),
     bgcolor = color_fvg_bear,
     text = "Bear FVG",
     text_size = size.tiny,
     text_color = color.new(color_bear, 20),
     text_halign = text.align_center,
     text_valign = text.align_center)

// --- Signal Logic (ATR Trailing Stop / Supertrend-like) ---
[supertrend, direction] = ta.supertrend(atr_mult, atr_length)

bool buy_signal = ta.change(direction) < 0
bool sell_signal = ta.change(direction) > 0

if buy_signal
    label.new(bar_index, low, "BUY ▲", color = color_bull, style = label.style_label_up, textcolor = color.white, size = size.small)

if sell_signal
    label.new(bar_index, high, "SELL ▼", color = color_bear, style = label.style_label_down, textcolor = color.white, size = size.small)

// --- Trade Levels ---
atr_val = ta.atr(atr_length)
var float entry_price = na
var float tp1 = na
var float tp2 = na
var float tp3 = na
var float sl = na
var string current_signal = "NONE"

if buy_signal
    entry_price := close
    sl := low - atr_val * 1.5
    tp1 := entry_price + (entry_price - sl) * 1.0
    tp2 := entry_price + (entry_price - sl) * 2.0
    tp3 := entry_price + (entry_price - sl) * 3.0
    current_signal := "LONG"

if sell_signal
    entry_price := close
    sl := high + atr_val * 1.5
    tp1 := entry_price - (sl - entry_price) * 1.0
    tp2 := entry_price - (sl - entry_price) * 2.0
    tp3 := entry_price - (sl - entry_price) * 3.0
    current_signal := "SHORT"

// --- Trend Logic (200 EMA) ---
ema200 = ta.ema(close, 200)
trend_status = close > ema200 ? "Uptrend" : "Downtrend"

// --- MTF Data ---
f_get_signal(tf) =>
    request.security(syminfo.tickerid, tf, direction < 0 ? "BUY" : "SELL")[1]

sig_5m  = f_get_signal("5")
sig_15m = f_get_signal("15")
sig_1h  = f_get_signal("60")
sig_4h  = f_get_signal("240")
sig_1d  = f_get_signal("D")

// --- Dashboard Table Functions ---
f_add_mtf_row(table_id, row, tf_name, signal) =>
    table.cell(table_id, 0, row, tf_name, text_color = color.white, text_size = size.small)
    table.cell(table_id, 1, row, signal, bgcolor = (signal == "BUY" ? color_bull : color_bear), text_color = color.white, text_size = size.small)

// --- Dashboard ---
var table main_table = table.new(position.top_right, 2, 15, bgcolor = color.rgb(20, 20, 20, 10), border_width = 1, border_color = color.gray)

if barstate.islast
    // Header
    table.cell(main_table, 0, 0, "✦ Rich Zone ✦", bgcolor = color.rgb(41, 98, 255), text_color = color.white, text_size = size.normal)
    table.merge_cells(main_table, 0, 0, 1, 0)

    // Signal
    table.cell(main_table, 0, 1, "SIGNAL ...........", text_color = color.white, text_halign = text.align_left, text_size = size.small)
    table.cell(main_table, 1, 1, current_signal, bgcolor = (current_signal == "LONG" ? color_bull : current_signal == "SHORT" ? color_bear : color.gray), text_color = color.white, text_size = size.small)

    // Entry Price
    table.cell(main_table, 0, 2, "Entry Price", text_color = color.white, text_halign = text.align_left, text_size = size.small)
    table.cell(main_table, 1, 2, str.tostring(entry_price, "#.##"), text_color = color.white, text_size = size.small)

    // TP Targets
    table.cell(main_table, 0, 3, "TP1 Target", text_color = color.white, text_halign = text.align_left, text_size = size.small)
    table.cell(main_table, 1, 3, str.tostring(tp1, "#.##"), text_color = color.rgb(0, 255, 132), text_size = size.small)

    table.cell(main_table, 0, 4, "TP2 Target", text_color = color.white, text_halign = text.align_left, text_size = size.small)
    table.cell(main_table, 1, 4, str.tostring(tp2, "#.##"), text_color = color.rgb(0, 255, 132), text_size = size.small)

    table.cell(main_table, 0, 5, "TP3 Target", text_color = color.white, text_halign = text.align_left, text_size = size.small)
    table.cell(main_table, 1, 5, str.tostring(tp3, "#.##"), text_color = color.rgb(0, 255, 132), text_size = size.small)

    // Stop Loss
    table.cell(main_table, 0, 6, "Stop Loss", text_color = color.white, text_halign = text.align_left, text_size = size.small)
    table.cell(main_table, 1, 6, str.tostring(sl, "#.##"), text_color = color.rgb(255, 82, 82), text_size = size.small)

    // Trend
    table.cell(main_table, 0, 7, "Trend: " + trend_status, bgcolor = (trend_status == "Uptrend" ? color.rgb(0, 200, 83) : color.rgb(255, 82, 82)), text_color = color.white, text_size = size.small)
    table.merge_cells(main_table, 0, 7, 1, 7)

    // MTF Table Header
    table.cell(main_table, 0, 8, "TIMEFRAME", bgcolor = color.rgb(41, 98, 255), text_color = color.white, text_size = size.small)
    table.cell(main_table, 1, 8, "SIGNAL", bgcolor = color.rgb(41, 98, 255), text_color = color.white, text_size = size.small)

    // MTF Rows
    f_add_mtf_row(main_table, 9, "Chart (" + timeframe.period + ")", (current_signal == "LONG" ? "BUY" : current_signal == "SHORT" ? "SELL" : "NONE"))
    f_add_mtf_row(main_table, 10, "5 MIN", sig_5m)
    f_add_mtf_row(main_table, 11, "15 MIN", sig_15m)
    f_add_mtf_row(main_table, 12, "1 HOUR", sig_1h)
    f_add_mtf_row(main_table, 13, "4 HOUR", sig_4h)
    f_add_mtf_row(main_table, 14, "1 DAY", sig_1d)
