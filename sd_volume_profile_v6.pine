//@version=6
indicator("S&D + Volume Profile", shorttitle="SD+VP", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

// --- Instructions / Logic ---
// 1. Accumulation (Base) -> HVN/POC
// 2. Displacement (Imbalance) -> LVN
// 3. Retracement -> Auction Vacuum Fill
// 4. Mitigation -> Institutional Re-entry
// Filter Rule: Invalidate if displacement contains HVN clusters.

// --- Inputs ---
atr_length             = input.int(14, "ATR Length", minval=1, group="Core Settings")
displacement_multiplier = input.float(2.0, "Displacement Multiplier (ATR)", minval=0.1, group="Core Settings", tooltip="Multiplier for ATR to qualify displacement")
base_max_dist_atr     = input.float(0.5, "Base Max Range (ATR)", minval=0.1, group="Core Settings", tooltip="Multiplier for ATR to define base range")
volume_lookback        = input.int(20, "Volume Lookback", minval=1, group="Volume Profile", tooltip="Lookback for average volume")
hvn_multiplier         = input.float(1.5, "HVN Multiplier", minval=0.1, group="Volume Profile", tooltip="Multiplier for average volume to identify HVNs in displacement")
vp_bins                = input.int(10, "Volume Profile Bins", minval=2, maxval=50, group="Volume Profile", tooltip="Number of price segments for Volume Profile")

// Styling
bull_color = input.color(color.new(color.teal, 80), "Bullish Zone Color", group="Styling")
bear_color = input.color(color.new(color.red, 80), "Bearish Zone Color", group="Styling")
poc_color  = input.color(color.yellow, "POC Color", group="Styling")
dashboard_color = input.color(color.new(color.gray, 90), "Dashboard Color", group="Styling")

// --- Calculations & Logic ---
atr_val = ta.atr(atr_length)
base_threshold = base_max_dist_atr * atr_val

// Detect 3-bar consolidation (minimum base)
three_bar_high = ta.highest(high, 3)
three_bar_low = ta.lowest(low, 3)
three_bar_hldist = three_bar_high - three_bar_low
is_base_active = three_bar_hldist <= base_threshold

// Tracking the active base
var float active_base_h = na
var float active_base_l = na
var int active_base_start = na
var bool in_base = false

if is_base_active
    if not in_base
        active_base_start := bar_index - 2
        in_base := true
    active_base_h := ta.highest(high, bar_index - active_base_start + 1)
    active_base_l := ta.lowest(low, bar_index - active_base_start + 1)
else
    if in_base
        // Base just ended. We'll check for displacement in the next step.
        in_base := false

// Helper function for Volume Profile within the base
get_base_poc(b_start, b_end, b_low, b_high, bins) =>
    float bin_size = (b_high - b_low) / bins
    float[] vol_bins = array.new_float(bins, 0.0)
    if bin_size > 0
        for i = b_start to b_end
            float price_mid = (high[bar_index - i] + low[bar_index - i]) / 2
            int bin_idx = math.min(bins - 1, math.max(0, int((price_mid - b_low) / bin_size)))
            array.set(vol_bins, bin_idx, array.get(vol_bins, bin_idx) + volume[bar_index - i])

    int max_bin = 0
    float max_vol = -1.0
    for j = 0 to bins - 1
        if array.get(vol_bins, j) > max_vol
            max_vol := array.get(vol_bins, j)
            max_bin := j

    float poc_price = b_low + (max_bin + 0.5) * bin_size
    poc_price

// Define Zone structure
type Zone
    float b_h
    float b_l
    float b_poc
    int b_start
    int b_end
    bool is_bull
    bool is_valid = true
    bool is_mitigated = false
    box box_obj
    line poc_obj
    label lbl_obj
    label disp_lbl_obj
    label retr_lbl_obj

var Zone[] active_zones = array.new<Zone>()

// Detect Displacement
avg_vol = ta.sma(volume, volume_lookback)
body_size = math.abs(close - open)
is_displacement = not in_base and in_base[1] and body_size > displacement_multiplier * atr_val

if is_displacement
    bool is_bull_disp = close > open
    float poc_val = get_base_poc(active_base_start, bar_index - 1, active_base_l, active_base_h, vp_bins)

    Zone new_zone = Zone.new(
         b_h = active_base_h,
         b_l = active_base_l,
         b_poc = poc_val,
         b_start = active_base_start,
         b_end = bar_index - 1,
         is_bull = is_bull_disp
         )

    // Real-Chart Filter Rule: Check for HVN in the displacement candle itself
    // Or if the displacement is multiple candles, we would check the whole leg.
    // For simplicity, we check the trigger candle.
    if volume > avg_vol * hvn_multiplier and body_size < (high - low) * 0.5
        new_zone.is_valid := false

    active_zones.push(new_zone)

// Manage Zones (Retracement, Mitigation, Cleanup)
if active_zones.size() > 0
    for i = active_zones.size() - 1 to 0 by -1
        Zone z = active_zones.get(i)

        if not z.is_mitigated and z.is_valid
            // Check for Retracement (Vacuum Fill)
            if na(z.retr_lbl_obj) and bar_index > z.b_end + 2
                // If price has moved away and starts coming back
                bool is_retracing = z.is_bull ? (high < high[1] and low < low[1]) : (low > low[1] and high > high[1])
                if is_retracing
                    z.retr_lbl_obj := label.new(bar_index, z.is_bull ? high : low, "3. VACUUM FILL (Retracement)", color=color.new(color.red, 100), textcolor=color.red, style=z.is_bull ? label.style_label_down : label.style_label_up)

            // Check for Mitigation (Re-entry)
            bool touched = false
            if z.is_bull
                touched := low <= z.b_h and high >= z.b_l
            else
                touched := high >= z.b_l and low <= z.b_h

            if touched and bar_index > z.b_end + 1
                z.is_mitigated := true
                label.new(bar_index, z.is_bull ? z.b_l : z.b_h, "4. RE-ENTRY (Mitigation)", color=color.white, textcolor=color.teal, style=label.style_label_center)

        // Cleanup: Invalidate if price breaks through the zone
        if z.is_bull and close < z.b_l
            z.is_valid := false
        else if not z.is_bull and close > z.b_h
            z.is_valid := false

        // Visualization
        if z.is_valid
            if na(z.box_obj)
                z.box_obj := box.new(z.b_start, z.b_h, bar_index, z.b_l, border_color=color.gray, bgcolor=z.is_bull ? bull_color : bear_color)
                z.poc_obj := line.new(z.b_start, z.b_poc, bar_index, z.b_poc, color=poc_color, style=line.style_dashed)
                z.lbl_obj := label.new(z.b_start, z.is_bull ? z.b_l : z.b_h, "1. THE BASE (Orders Accumulated) - POC: " + str.tostring(z.b_poc, format.mintick), color=color.new(color.black, 100), textcolor=color.white, style=label.style_label_up)
                z.disp_lbl_obj := label.new(z.b_end + 1, z.is_bull ? z.b_h : z.b_l, "2. DISPLACEMENT (Market Imbalance)", color=color.new(color.black, 100), textcolor=color.teal, style=label.style_label_down)
            else
                box.set_right(z.box_obj, bar_index)
                line.set_x2(z.poc_obj, bar_index)
        else
            box.delete(z.box_obj)
            line.delete(z.poc_obj)
            label.delete(z.lbl_obj)
            label.delete(z.disp_lbl_obj)
            label.delete(z.retr_lbl_obj)
            active_zones.remove(i)

// Dashboard
var table dash = table.new(position.top_right, 2, 2, bgcolor=dashboard_color, border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "Current Phase", text_color=color.white)
    string phase_str = "Scanning"
    if in_base
        phase_str := "1. THE BASE"
    else if is_displacement
        phase_str := "2. DISPLACEMENT"
    else if active_zones.size() > 0
        Zone last_z = active_zones.get(active_zones.size() - 1)
        if last_z.is_mitigated
            phase_str := "4. RE-ENTRY"
        else if not na(last_z.retr_lbl_obj)
            phase_str := "3. VACUUM FILL"
        else
            phase_str := "2. DISPLACEMENT (Leg)"

    table.cell(dash, 1, 0, phase_str, text_color=color.yellow)
    table.cell(dash, 0, 1, "Active Zones", text_color=color.white)
    table.cell(dash, 1, 1, str.tostring(active_zones.size()), text_color=color.yellow)
