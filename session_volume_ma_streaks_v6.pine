//@version=6
indicator("Session Volume Moving Average & Streaks [LuxAlgo]", overlay = true, max_boxes_count = 500, max_lines_count = 500)

// This script implements a Session Volume Moving Average with Volume Streak Detection
// inspired by LuxAlgo's "Session Volume Moving Average" indicator.
// It features:
// 1. Session Volume MA with Trend Strength coloring
// 2. Volume Streak Detection (consecutively increasing/decreasing volume)
// 3. Significant Volume Blocks
// 4. Session Volume Profile (VAH, VAL, POC)

// --- Inputs ---
grp_session = "Session Settings"
sess_input  = input.session("0800-1700", "Session Time", group = grp_session)
tz_input    = input.string("UTC+3", "Timezone", group = grp_session)
past_sess   = input.int(5, "Past Sessions to Show", minval = 1, group = grp_session)

grp_ma      = "Volume Moving Average"
ma_len      = input.int(20, "MA Length", minval = 1, group = grp_ma)
ma_type     = input.string("EMA", "MA Type", options = ["SMA", "EMA", "HMA", "RMA", "WMA"], group = grp_ma)

grp_streaks = "Volume Streak Detection"
min_streak  = input.int(3, "Min Streak Length", minval = 1, group = grp_streaks)
vol_mult    = input.float(1.5, "Significant Vol Multiplier", minval = 0.1, step = 0.1, group = grp_streaks)

grp_visuals = "Visual Settings"
height_mult = input.float(1.0, "Height Multiplier", minval = 0.1, step = 0.1, group = grp_visuals)
bull_col    = input.color(color.new(color.aqua, 50), "Bullish Volume Color", group = grp_visuals)
bear_col    = input.color(color.new(color.orange, 50), "Bearish Volume Color", group = grp_visuals)

// --- Session Logic ---
is_in_session = not na(time(timeframe.period, sess_input, tz_input))
new_session   = is_in_session and (not is_in_session[1] or na(is_in_session[1]))

// --- Global TA Calculations ---
atr_val = ta.atr(14)

// --- Volume Moving Average ---
get_ma(src, len, type) =>
    switch type
        "SMA" => ta.sma(src, len)
        "EMA" => ta.ema(src, len)
        "HMA" => ta.hma(src, len)
        "RMA" => ta.rma(src, len)
        "WMA" => ta.wma(src, len)
        => ta.sma(src, len)

vol_ma = get_ma(volume, ma_len, ma_type)

// --- Trend Strength (Bullish vs Bearish Volume) ---
var float bull_vol_cum = 0.0
var float bear_vol_cum = 0.0

if new_session
    bull_vol_cum := 0.0
    bear_vol_cum := 0.0

if is_in_session
    if close > open
        bull_vol_cum += volume
    else if close < open
        bear_vol_cum += volume
    else
        bull_vol_cum += volume / 2
        bear_vol_cum += volume / 2

// Price MA for Trend Strength visualization
trend_ma = get_ma(close, ma_len, ma_type)
trend_strength_col = bull_vol_cum >= bear_vol_cum ? color.aqua : color.orange
plot(trend_ma, "Trend MA", color = is_in_session ? color.new(trend_strength_col, 0) : color.new(color.gray, 50), linewidth = 2)

// --- Volume Streak Detection ---
var int up_streak_count = 0
var int dn_streak_count = 0

if is_in_session
    up_streak_count := volume > volume[1] ? up_streak_count + 1 : (volume < volume[1] ? 0 : up_streak_count)
    dn_streak_count := volume < volume[1] ? dn_streak_count + 1 : (volume > volume[1] ? 0 : dn_streak_count)
else
    up_streak_count := 0
    dn_streak_count := 0

is_significant = volume > vol_ma * vol_mult
is_up_streak   = up_streak_count >= min_streak and is_significant
is_dn_streak   = dn_streak_count >= min_streak and is_significant

// --- Volume Blocks ---
if is_up_streak or is_dn_streak
    block_col = is_up_streak ? bull_col : bear_col
    vol_ratio = volume / vol_ma
    // Vertical span based on ATR and volume intensity
    box_height = atr_val * (vol_ratio - 1.0) * height_mult
    box.new(bar_index, high + box_height, bar_index, low - box_height, border_color = block_col, bgcolor = block_col)

// --- Session Volume Profile ---
var float[] price_levels = array.new_float(0)
var float[] vol_levels   = array.new_float(0)

if new_session
    array.clear(price_levels)
    array.clear(vol_levels)

if is_in_session
    // Simple binning logic - using a larger bin size for performance if needed,
    // but here we use mintick. For highly volatile assets, consider rounding more.
    price_bin = math.round(close / (syminfo.mintick * 10)) * (syminfo.mintick * 10)
    idx = array.indexof(price_levels, price_bin)
    if idx == -1
        array.push(price_levels, price_bin)
        array.push(vol_levels, volume)
    else
        array.set(vol_levels, idx, array.get(vol_levels, idx) + volume)

// --- Session Volume Profile Calculations ---
var int session_start_idx = 0
var line poc_line = na
var box session_box = na
var line[] all_poc_lines = array.new_line(0)
var box[] all_sess_boxes = array.new_box(0)

if new_session
    session_start_idx := bar_index
    poc_line := line.new(bar_index, close, bar_index, close, color = color.new(color.yellow, 30), width = 2, style = line.style_dashed)
    session_box := box.new(bar_index, high, bar_index, low, border_color = color.new(color.gray, 80), bgcolor = color.new(color.gray, 95))

    array.push(all_poc_lines, poc_line)
    array.push(all_sess_boxes, session_box)

    if array.size(all_poc_lines) > past_sess
        line.delete(array.shift(all_poc_lines))
        box.delete(array.shift(all_sess_boxes))

if is_in_session
    if array.size(vol_levels) > 0
        max_vol   = 0.0
        poc_price = 0.0
        for i = 0 to array.size(vol_levels) - 1
            v = array.get(vol_levels, i)
            if v > max_vol
                max_vol   := v
                poc_price := array.get(price_levels, i)

        // Update POC
        line.set_xy1(poc_line, session_start_idx, poc_price)
        line.set_xy2(poc_line, bar_index, poc_price)

        // Update Session Box (S/R Zone)
        float session_high = ta.highest(high, bar_index - session_start_idx + 1)
        float session_low  = ta.lowest(low, bar_index - session_start_idx + 1)
        box.set_lefttop(session_box, session_start_idx, session_high)
        box.set_rightbottom(session_box, bar_index, session_low)
