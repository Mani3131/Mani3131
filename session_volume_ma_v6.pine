//@version=6
indicator("Big Boss Quarterly Volume [LuxAlgo] Clone", overlay = true, max_boxes_count = 500, max_lines_count = 500, format = format.volume)

// --- Inputs ---
group_session = "Quarterly Settings"
// Big Boss/ICT Quarterly starts at 20:00 NY.
// 20:00 NY is 03:00 UTC+3 (typically, depends on DST but user asked for UTC+3).
anchor_hour = input.int(3, "Anchor Hour (UTC+3)", minval = 0, maxval = 23, group = group_session)
quarter_mins = 90

group_svma = "SVMA Settings"
svma_lookback = input.int(20, "SVMA Lookback (Sessions)", minval = 1, maxval = 60, group = group_svma)

group_visuals = "Visuals"
show_gradient = input.bool(true, "Show Gradient Heatmap", group = group_visuals)
show_profile  = input.bool(true, "Show Session Volume Profile", group = group_visuals)
show_box      = input.bool(true, "Show Session Box", group = group_visuals)
show_table    = input.bool(true, "Show 'Who is in Command' Table", group = group_visuals)

// --- Constants & Variables ---
var float cum_vol = 0.0
var float cum_delta = 0.0
var int session_bar_index = 0

// SVMA Logic: Matrix to store [session_bar_index][session_lookback]
// We use a matrix where rows are bar indices and columns are previous sessions.
// Max rows (bars per session) depends on timeframe, let's assume 1440 for 1m.
// Max columns is svma_lookback.
var matrix<float> history_vol = matrix.new<float>(1440, svma_lookback, 0.0)
var int current_session_idx = 0

// --- Logic ---
atr_val = ta.atr(14)

// Quarterly Detection
// We use UTC+3 as requested
h = hour(time, "UTC+3")
m = minute(time, "UTC+3")

// Minutes since midnight UTC+3
mins_since_midnight = (h * 60 + m)
// Minutes since anchor
mins_since_anchor = (mins_since_midnight - (anchor_hour * 60) + 1440) % 1440

// Big Boss Quarterly: 4 sessions of 6 hours, each with 4 quarters of 90 mins
session_idx = int(mins_since_anchor / 360) // 0: Asia, 1: London, 2: NY, 3: PM
quarter_in_session_idx = int((mins_since_anchor % 360) / quarter_mins) // 0-3
quarter_idx = int(mins_since_anchor / quarter_mins) // 0-15 total in a day

new_quarter = quarter_idx != quarter_idx[1] or barstate.isfirst
new_session_bb = session_idx != session_idx[1] or barstate.isfirst

is_in_session = true // Quarterly Theory usually covers the whole 24h cycle

// Volume Delta Calculation
float bar_delta = (close >= open ? volume : -volume)

if new_quarter
    cum_vol := volume
    cum_delta := bar_delta
    session_bar_index := 0
else if is_in_session
    cum_vol += volume
    cum_delta += bar_delta
    session_bar_index += 1

// SVMA Calculation: Average of previous days same quarter bar index?
// For Quarterly Theory, we might just want to compare to average of previous bars or a fixed lookback.
// However, sticking to the user's "SVMA" request:
float svma = 0.0
if is_in_session and session_bar_index < 1440
    // Calculate average from history
    float sum_hist = 0.0
    int count_hist = 0
    for i = 0 to svma_lookback - 1
        // Skip current session slot to only average past sessions
        if i == current_session_idx % svma_lookback
            continue
        float val = history_vol.get(session_bar_index, i)
        if val > 0
            sum_hist += val
            count_hist += 1

    svma := count_hist > 0 ? sum_hist / count_hist : cum_vol

// Update history at the end of session bar (or on each bar to have it live for future)
// We'll update the history for the *previous* session when a new one starts to be clean,
// or update current and use it next time.
// Actually, the requirement usually means comparing *current* cumulative vs *average* of previous sessions at the same bar index.

if is_in_session and session_bar_index < 1440
    // Store current cumulative volume in the matrix for the current session column
    history_vol.set(session_bar_index, current_session_idx % svma_lookback, cum_vol)

if new_quarter
    current_session_idx += 1

// --- Visuals: Quarterly Box ---
var box q_box = na
var label q_label = na
string q_name = switch quarter_in_session_idx
    0 => "Q1: Accumulation"
    1 => "Q2: Manipulation"
    2 => "Q3: Distribution"
    3 => "Q4: Reversal/Cont"

color q_color = switch session_idx
    0 => color.new(color.blue, 90)
    1 => color.new(color.orange, 90)
    2 => color.new(color.green, 90)
    3 => color.new(color.purple, 90)

if show_box
    if new_quarter
        q_box := box.new(bar_index, high, bar_index, low, border_color = color.gray, border_style = line.style_solid, bgcolor = q_color)
        q_label := label.new(bar_index, high, q_name, color = color.new(color.black, 100), textcolor = color.white, style = label.style_label_down, size = size.small)
    else if is_in_session
        box.set_right(q_box, bar_index)
        box.set_top(q_box, math.max(box.get_top(q_box), high))
        box.set_bottom(q_box, math.min(box.get_bottom(q_box), low))
        label.set_xy(q_label, int(math.avg(box.get_left(q_box), bar_index)), box.get_top(q_box))

// --- Visuals: Gradient Heatmap (Who is in Command) ---
// Using plot instead of boxes for historical sustainability
// We plot a series of lines/shapes at the top
float heatmap_relative_vol = svma > 0 ? math.min(1.0, cum_vol / (svma * 1.5)) : 0.5
color heatmap_cmd_color = cum_delta > 0 ? color.green : color.red
color heatmap_color = color.new(heatmap_cmd_color, 100 - int(heatmap_relative_vol * 100))

// Position at the very top using a high offset
float heatmap_top_pos = ta.highest(high, 500) + (atr_val * 15)
plot(show_gradient and is_in_session ? heatmap_top_pos : na, "Gradient Bar Top", color = heatmap_color, style = plot.style_linebr, linewidth = 10)

// --- Visuals: Quarterly Volume Delta Histogram ---
// Using plot instead of boxes for better performance and visibility
plot(is_in_session ? bar_delta : na, "Volume Delta Histogram", color = bar_delta > 0 ? color.new(color.green, 50) : color.new(color.red, 50), style = plot.style_columns, histbase = 0)

// --- Anchored VWAP ---
var float vwap_sum_pv = 0.0
var float vwap_sum_v = 0.0
if new_quarter
    vwap_sum_pv := volume * hlc3
    vwap_sum_v := volume
else if is_in_session
    vwap_sum_pv += volume * hlc3
    vwap_sum_v += volume

plot_vwap = vwap_sum_v > 0 ? vwap_sum_pv / vwap_sum_v : na
plot(is_in_session ? plot_vwap : na, "Session VWAP", color = color.yellow, linewidth = 2)

// --- Plot SVMA ---
// Since SVMA is volume-based cumulative average, we plot it relative to current cumulative volume
// or normalized. The user asked for "moving average that has volume inside".
// We will plot the SVMA line.
plot(is_in_session ? svma : na, "Session Volume MA", color = color.new(color.aqua, 50), style = plot.style_linebr, linewidth = 1)

// --- Visuals: Quarterly Volume Profile ---
// We'll use 40 bins and store bar data to recalculate accurately
int num_bins = 40
var float[] quarter_highs = array.new_float(0)
var float[] quarter_lows = array.new_float(0)
var float[] quarter_vols = array.new_float(0)
var box[] bin_boxes = array.new_box(0)

if show_profile and is_in_session
    if new_quarter
        array.clear(quarter_highs)
        array.clear(quarter_lows)
        array.clear(quarter_vols)
        // We keep previous boxes until they hit max count naturally
        array.clear(bin_boxes)
        for i = 0 to num_bins - 1
            array.push(bin_boxes, box.new(bar_index, high, bar_index, low, border_color = na, bgcolor = color.new(color.aqua, 50)))

    // Store bar data
    array.push(quarter_highs, high)
    array.push(quarter_lows, low)
    array.push(quarter_vols, volume)

    float q_high = array.max(quarter_highs)
    float q_low = array.min(quarter_lows)
    float bin_size = (q_high - q_low) / num_bins

    if bin_size > 0
        float[] current_bins = array.new_float(num_bins, 0.0)
        for i = 0 to array.size(quarter_vols) - 1
            float b_high = array.get(quarter_highs, i)
            float b_low = array.get(quarter_lows, i)
            float b_vol = array.get(quarter_vols, i)
            // Distribute volume across bins hit by the bar
            int start_bin = int((b_low - q_low) / bin_size)
            int end_bin = int((b_high - q_low) / bin_size)
            start_bin := math.max(0, math.min(num_bins - 1, start_bin))
            end_bin := math.max(0, math.min(num_bins - 1, end_bin))
            int span = end_bin - start_bin + 1
            float vol_per_bin = b_vol / span
            for j = start_bin to end_bin
                array.set(current_bins, j, array.get(current_bins, j) + vol_per_bin)

        float max_bin_vol = array.max(current_bins)
        int q_start_bar = bar_index - session_bar_index

        for i = 0 to num_bins - 1
            float bin_vol = array.get(current_bins, i)
            float bin_top = q_low + (i + 1) * bin_size
            float bin_bottom = q_low + i * bin_size
            float vol_ratio = max_bin_vol > 0 ? bin_vol / max_bin_vol : 0

            int box_right = bar_index
            int box_left = int(math.max(q_start_bar, bar_index - (session_bar_index * vol_ratio * 0.7)))

            box.set_lefttop(array.get(bin_boxes, i), box_left, bin_top)
            box.set_rightbottom(array.get(bin_boxes, i), box_right, bin_bottom)

// --- Visuals: 'Who is in Command' Table ---
var table command_table = table.new(position.top_right, 2, 3, border_width = 1)
if show_table and barstate.islast
    string command = cum_delta > 0 ? "Bulls" : "Bears"
    color command_color = cum_delta > 0 ? color.green : color.red

    table.cell(command_table, 0, 0, "Quarter", bgcolor = color.gray, text_color = color.white)
    table.cell(command_table, 1, 0, str.tostring(quarter_idx + 1), bgcolor = color.black, text_color = color.white)
    table.cell(command_table, 0, 1, "In Command", bgcolor = color.gray, text_color = color.white)
    table.cell(command_table, 1, 1, command, bgcolor = command_color, text_color = color.white)
    table.cell(command_table, 0, 2, "Quarter Delta", bgcolor = color.gray, text_color = color.white)
    table.cell(command_table, 1, 2, str.tostring(cum_delta, format.volume), bgcolor = command_color, text_color = color.white)
