//@version=6
indicator("Session Volume Moving Average [LuxAlgo]", shorttitle="LuxAlgo - SVMA", overlay=false, format=format.volume)

//------------------------------------------------------------------------------
// Inputs
//------------------------------------------------------------------------------
int    ma_length  = input.int(10, "MA Length (Sessions)", minval=1)
string session_str = input.session("0930-1600", "Session Time")
string timezone    = input.string("America/New_York", "Timezone")
color  bull_color  = input.color(color.rgb(0, 255, 255), "Above Average Color")
color  bear_color  = input.color(color.rgb(128, 128, 128), "Below Average Color")
bool   show_dash   = input.bool(true, "Show Dashboard")

//------------------------------------------------------------------------------
// Calculation Logic
//------------------------------------------------------------------------------
// Detect session status
bool is_in_session = not na(time(timeframe.period, session_str, timezone))
bool is_new_session = is_in_session and not is_in_session[1]

// Cumulative Volume calculation
var float cum_vol = 0.0
if is_new_session
    cum_vol := volume
else if is_in_session
    cum_vol += volume
else
    cum_vol := na

// Time-based Indexing (Minute of the day)
int minute_index = hour(time, timezone) * 60 + minute(time, timezone)

// Historical Average Calculation
// We use a matrix to store cumulative volume for the last 'ma_length' sessions
// Rows: Minute of the day (0-1439)
// Columns: Session values (0 to ma_length - 1)
var matrix<float> history = matrix.new<float>(1440, ma_length, 0.0)
var int current_col = 0

// Detect end of session to rotate column
if not is_in_session and is_in_session[1]
    current_col := (current_col + 1) % ma_length

// Calculate Average from previous sessions (excluding current_col)
float historical_sum = 0.0
int valid_sessions = 0

if is_in_session
    for i = 0 to ma_length - 1
        // Skip the current session's column to get a true historical average
        if i == current_col
            continue

        float val = history.get(minute_index, i)
        if val > 0
            historical_sum += val
            valid_sessions += 1

float historical_avg = valid_sessions > 0 ? historical_sum / valid_sessions : na

// Update history for the current session
if is_in_session
    history.set(minute_index, current_col, cum_vol)

//------------------------------------------------------------------------------
// Plots
//------------------------------------------------------------------------------
// Plot historical average as circles to simulate a dotted line (plot() does not support dotted styles directly)
plot_avg = plot(historical_avg, "Average Session Volume", color=color.new(color.gray, 50), style=plot.style_circles)
plot_cum = plot(cum_vol, "Current Session Volume", color=cum_vol > historical_avg ? bull_color : bear_color, style=plot.style_linebr, linewidth=2)

fill(plot_cum, plot_avg, color = cum_vol > historical_avg ? color.new(bull_color, 80) : color.new(bear_color, 80), title = "Volume Difference Fill")

//------------------------------------------------------------------------------
// Dashboard
//------------------------------------------------------------------------------
var table dash = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 10), border_width=1, border_color=color.new(color.gray, 50))

if show_dash and barstate.islast
    float rel_vol = historical_avg > 0 ? (cum_vol / historical_avg) * 100 : 0.0

    table.cell(dash, 0, 0, "Session Status", text_color=color.white, text_halign=text.align_left)
    table.cell(dash, 1, 0, is_in_session ? "ACTIVE" : "INACTIVE", text_color=is_in_session ? bull_color : color.gray, text_halign=text.align_right)

    table.cell(dash, 0, 1, "Total Volume", text_color=color.white, text_halign=text.align_left)
    table.cell(dash, 1, 1, str.format("{0,number,#}", cum_vol), text_color=color.white, text_halign=text.align_right)

    table.cell(dash, 0, 2, "Avg Volume", text_color=color.white, text_halign=text.align_left)
    table.cell(dash, 1, 2, str.format("{0,number,#}", historical_avg), text_color=color.white, text_halign=text.align_right)

    table.cell(dash, 0, 3, "Rel. Volume", text_color=color.white, text_halign=text.align_left)
    table.cell(dash, 1, 3, str.format("{0,number,0.0}%", rel_vol), text_color=rel_vol > 100 ? bull_color : color.white, text_halign=text.align_right)
