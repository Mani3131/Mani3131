//@version=6
indicator("Session Volume Moving Average [LuxAlgo]", shorttitle="LuxAlgo - SVMA", overlay=true, max_boxes_count=500)

//------------------------------------------------------------------------------
// Inputs
//------------------------------------------------------------------------------
string session_str = input.session("0930-1600", "Session Time")
string timezone    = input.string("UTC+3", "Timezone")
int    ma_length   = input.int(10, "Historical MA Length (Sessions)", minval=1, maxval=60)

color  bull_color  = input.color(color.rgb(0, 255, 136), "Above Average Color", group="Visuals")
color  bear_color  = input.color(color.rgb(255, 68, 68), "Below Average Color", group="Visuals")
int    bar_offset  = input.int(20, "Heatmap Vertical Offset (Ticks)", minval=0, group="Visuals")
int    bar_height  = input.int(10, "Heatmap Height (Ticks)", minval=1, group="Visuals")
bool   show_vwap   = input.bool(true, "Show Session VWAP", group="Visuals")
bool   show_delta  = input.bool(true, "Show Delta Histogram", group="Visuals")
bool   show_vp     = input.bool(true, "Show Volume Profile", group="Visuals")
bool   show_box    = input.bool(true, "Show Session Box", group="Visuals")

//------------------------------------------------------------------------------
// Calculation Logic
//------------------------------------------------------------------------------
// Detect session status
bool is_in_session = not na(time(timeframe.period, session_str, timezone))
bool is_new_session = is_in_session and not is_in_session[1]
bool is_session_end = not is_in_session and is_in_session[1]

// Volume & Delta
float buy_vol = close > open ? volume : 0.0
float sell_vol = close < open ? volume : 0.0
float delta = buy_vol - sell_vol

var float cum_vol = 0.0
var float cum_delta = 0.0
if is_new_session
    cum_vol := volume
    cum_delta := delta
else if is_in_session
    cum_vol += volume
    cum_delta += delta
else
    cum_vol := na
    cum_delta := na

// Time-based Indexing
int minute_index = hour(time, timezone) * 60 + minute(time, timezone)

// Historical Average Calculation (Matrix)
var matrix<float> history = matrix.new<float>(1440, ma_length, 0.0)
var int current_col = 0
if is_session_end
    current_col := (current_col + 1) % ma_length

float historical_sum = 0.0
int valid_sessions = 0
if is_in_session
    for i = 0 to ma_length - 1
        if i == current_col
            continue
        float val = history.get(minute_index, i)
        if val > 0
            historical_sum += val
            valid_sessions += 1

float historical_avg = valid_sessions > 0 ? historical_sum / valid_sessions : na
if is_in_session
    history.set(minute_index, current_col, cum_vol)

// Session VWAP
var float vwap_sum_pv = 0.0
var float vwap_sum_v = 0.0
if is_new_session
    vwap_sum_pv := (high + low + close) / 3 * volume
    vwap_sum_v := volume
else if is_in_session
    vwap_sum_pv += (high + low + close) / 3 * volume
    vwap_sum_v += volume
float s_vwap = vwap_sum_v > 0 ? vwap_sum_pv / vwap_sum_v : na

// Session Range
var float session_high = 0.0
var float session_low = 0.0
var int session_start_bar = 0
if is_new_session
    session_high := high
    session_low := low
    session_start_bar := bar_index
else if is_in_session
    session_high := math.max(session_high, high)
    session_low := math.min(session_low, low)

// Relative Volume for Heatmap
float rel_vol = historical_avg > 0 ? cum_vol / historical_avg : 1.0
color heatmap_color = color.from_gradient(nz(rel_vol, 1.0), 0.5, 1.5, bear_color, bull_color)

//------------------------------------------------------------------------------
// Volume Profile Logic
//------------------------------------------------------------------------------
var float[] vp_bins = array.new_float(30, 0.0)
if is_new_session
    array.fill(vp_bins, 0.0)

if is_in_session and show_vp
    float session_span = session_high - session_low
    if session_span > 0
        int bin_idx = int(math.min(29, math.max(0, math.floor((close - session_low) / session_span * 30))))
        array.set(vp_bins, bin_idx, array.get(vp_bins, bin_idx) + volume)

//------------------------------------------------------------------------------
// Drawings
//------------------------------------------------------------------------------
var box session_rect = na
var label command_lbl = na
var box[] vp_boxes = array.new_box()

if is_new_session
    if show_box
        session_rect := box.new(bar_index, high, bar_index, low, border_style=line.style_dotted, border_color=color.new(color.gray, 50), bgcolor=color.new(color.gray, 95))

    // Command Label
    command_lbl := label.new(bar_index, high, "Neutral", style=label.style_label_down, color=color.new(color.black, 100), textcolor=color.gray, size=size.small)

    // VP boxes reset
    if array.size(vp_boxes) > 0
        for b in vp_boxes
            box.delete(b)
        array.clear(vp_boxes)
    if show_vp
        for i = 0 to 29
            array.push(vp_boxes, box.new(na, na, na, na, border_color=na, bgcolor=color.new(color.gray, 70)))

if is_in_session
    // Update session box
    if not na(session_rect)
        box.set_right(session_rect, bar_index)
        box.set_top(session_rect, session_high)
        box.set_bottom(session_rect, session_low)

    // Heatmap Bar
    float bar_top = session_high + syminfo.mintick * (bar_offset + bar_height)
    float bar_btm = session_high + syminfo.mintick * bar_offset
    box.new(bar_index - 1, bar_top, bar_index, bar_btm, border_color=na, bgcolor=heatmap_color)

    // Delta Histogram at the bottom
    if show_delta
        float delta_h = (session_high - session_low) * 0.1
        color delta_c = delta > 0 ? color.new(bull_color, 50) : color.new(bear_color, 50)
        box.new(bar_index - 1, session_low + math.abs(delta)/volume * delta_h, bar_index, session_low, border_color=na, bgcolor=delta_c)

    // Update Command Label
    if not na(command_lbl)
        label.set_xy(command_lbl, int(math.round((session_start_bar + bar_index) / 2)), bar_top)
        string cmd_text = cum_delta > 0 ? "Bulls in Command" : "Bears in Command"
        color cmd_color = cum_delta > 0 ? bull_color : bear_color
        label.set_text(command_lbl, cmd_text)
        label.set_textcolor(command_lbl, cmd_color)

    // Volume Profile (Right Side)
    if show_vp
        float vp_range = session_high - session_low
        float max_vp = array.max(vp_bins)
        if vp_range > 0 and max_vp > 0
            for i = 0 to 29
                float bin_vol = array.get(vp_bins, i)
                box b = array.get(vp_boxes, i)
                if bin_vol > 0
                    float y1 = session_low + (i / 30.0) * vp_range
                    float y2 = session_low + ((i + 1) / 30.0) * vp_range
                    float x_width = (bin_vol / max_vp) * (bar_index - session_start_bar) * 0.15
                    box.set_lefttop(b, bar_index, y2)
                    box.set_rightbottom(b, int(bar_index + x_width), y1)

// Plots
plot(show_vwap ? s_vwap : na, "Session Volume MA", color=color.new(color.blue, 50), linewidth=2, style=plot.style_linebr)
