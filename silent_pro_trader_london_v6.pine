//@version=6
indicator("Silent Pro Trader - BBS Strategy", overlay = true, max_bars_back = 5000)

// --- Inputs ---
group_sessions = "Sessions (UTC+3)"
asia_sess    = input.session("0300-1200", "Asian Session", group = group_sessions)
london_sess  = input.session("1000-1900", "London Session", group = group_sessions)
ny_sess      = input.session("1500-2359", "New York Session", group = group_sessions)
timezone     = input.string("GMT+3", "Timezone", group = group_sessions)

group_logic = "Strategy Logic"
ema_len      = input.int(200, "Trend Filter EMA Length", minval = 1, group = group_logic)
show_dashboard = input.bool(true, "Show Status Dashboard", group = group_logic)

// --- Colors ---
color_asia   = color.new(#673ab7, 80) // Purple
color_london = color.new(#26a69a, 80) // Green
color_ny     = color.new(#ef5350, 80) // Red

// --- Session Logic ---
t_asia   = time(timeframe.period, asia_sess, timezone)
t_london = time(timeframe.period, london_sess, timezone)
t_ny     = time(timeframe.period, ny_sess, timezone)

is_asia   = not na(t_asia)
is_london = not na(t_london)
is_ny     = not na(t_ny)

// Start of session detection
asia_start   = is_asia and na(t_asia[1])
london_start = is_london and na(t_london[1])
ny_start     = is_ny and na(t_ny[1])

// --- Asian Range Tracking ---
var float asia_high = na
var float asia_low  = na

if asia_start
    asia_high := high
    asia_low  := low
else if is_asia
    asia_high := math.max(asia_high, high)
    asia_low  := math.min(asia_low, low)

// Persistent Asian Levels for the rest of the day
var float daily_asia_high = na
var float daily_asia_low  = na

if asia_start
    daily_asia_high := na
    daily_asia_low  := na

if is_asia
    daily_asia_high := asia_high
    daily_asia_low  := asia_low

// Plot Asian Range
plot_asia_high = plot(is_asia or is_london or is_ny ? daily_asia_high : na, "Asian High", color = color.new(color.purple, 50), style = plot.style_linebr)
plot_asia_low  = plot(is_asia or is_london or is_ny ? daily_asia_low : na, "Asian Low", color = color.new(color.purple, 50), style = plot.style_linebr)
fill(plot_asia_high, plot_asia_low, color = is_asia ? color_asia : na, title = "Asian Range Fill")

// --- Trend Filter ---
ema_filter = ta.ema(close, ema_len)
plot(ema_filter, "Trend Filter EMA", color = color.gray)
is_bullish = close > ema_filter
is_bearish = close < ema_filter

// --- BBS (Break-Block-Sweep) Logic ---
// Strategy:
// 1. Price wicks above/below Asian Range (Sweep)
// 2. Price closes back inside the range (Reversal/BBS)
// 3. Occurs during London or NY sessions

sweep_high = (is_london or is_ny) and high > daily_asia_high and close < daily_asia_high
sweep_low  = (is_london or is_ny) and low < daily_asia_low and close > daily_asia_low

// Signal Conditions
long_signal  = sweep_low and is_bullish
short_signal = sweep_high and is_bearish

// --- Visual Signals ---
plotshape(long_signal,  "BBS Long",  style = shape.triangleup,   location = location.belowbar, color = color.green, size = size.small)
plotshape(short_signal, "BBS Short", style = shape.triangledown, location = location.abovebar, color = color.red,   size = size.small)

// Alerting
alertcondition(long_signal,  "BBS Long Signal",  "BBS Long Entry at {{close}}")
alertcondition(short_signal, "BBS Short Signal", "BBS Short Entry at {{close}}")

// --- Dashboard ---
if show_dashboard and barstate.islast
    var table status_table = table.new(position.top_right, 2, 5, bgcolor = color.new(color.black, 10), border_width = 1, border_color = color.gray)

    // Header
    table.cell(status_table, 0, 0, "Silent Pro - BBS", text_color = color.white, text_halign = text.align_center)
    table.cell(status_table, 1, 0, "Status",           text_color = color.white, text_halign = text.align_center)

    // Session
    curr_session = is_asia ? "Asian" : is_london ? "London" : is_ny ? "New York" : "Outside"
    table.cell(status_table, 0, 1, "Current Session", text_color = color.lightgray, text_halign = text.align_left)
    table.cell(status_table, 1, 1, curr_session,      text_color = is_asia ? color.purple : is_london ? color.teal : is_ny ? color.red : color.gray, text_halign = text.align_center)

    // Bias
    bias_text = is_bullish ? "BULLISH" : "BEARISH"
    table.cell(status_table, 0, 2, "Trend Bias",      text_color = color.lightgray, text_halign = text.align_left)
    table.cell(status_table, 1, 2, bias_text,        text_color = is_bullish ? color.green : color.red, text_halign = text.align_center)

    // Asian High
    table.cell(status_table, 0, 3, "Asian High",      text_color = color.lightgray, text_halign = text.align_left)
    table.cell(status_table, 1, 3, str.tostring(daily_asia_high, "#.#####"), text_color = color.white, text_halign = text.align_center)

    // Asian Low
    table.cell(status_table, 0, 4, "Asian Low",       text_color = color.lightgray, text_halign = text.align_left)
    table.cell(status_table, 1, 4, str.tostring(daily_asia_low, "#.#####"),  text_color = color.white, text_halign = text.align_center)
