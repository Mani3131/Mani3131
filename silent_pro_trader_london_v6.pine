//@version=6
indicator("The Silent Pro Trader: 15m London Strategy", overlay=true, max_bars_back=5000)

// --- Inputs ---
grp_ses = "Session Settings"
asia_session   = input.session("0000-0500", "Asian Session (UTC)", group=grp_ses)
london_session = input.session("0700-1000", "London Open (UTC)", group=grp_ses)
time_zone      = input.string("UTC", "Timezone", options=["UTC", "America/New_York", "Europe/London"], group=grp_ses)

grp_vis = "Visual Settings"
show_asia_box  = input.bool(true, "Show Asian Range Box", group=grp_vis)
asia_box_col   = input.color(color.new(color.blue, 85), "Asian Box Color", group=grp_vis)
sweep_bear_col = input.color(color.red, "Bearish Sweep Color", group=grp_vis)
sweep_bull_col = input.color(color.green, "Bullish Sweep Color", group=grp_vis)

grp_dash = "Dashboard Settings"
show_dash      = input.bool(true, "Show Dashboard", group=grp_dash)
dash_pos       = input.string("top_right", "Position", options=["top_right", "bottom_right", "top_left", "bottom_left"], group=grp_dash)

// --- Session Logic ---
t_asia   = time(timeframe.period, asia_session, time_zone)
t_london = time(timeframe.period, london_session, time_zone)

is_asia   = not na(t_asia)
is_london = not na(t_london)

// Detect Start of Session (Memory: not na(t) and na(t[1]))
asia_start   = is_asia and not is_asia[1]
london_start = is_london and not is_london[1]

// --- Capture Asian Range ---
// Memory: Explicitly cast na when initializing var variables
var float asia_h = float(na)
var float asia_l = float(na)
var int asia_start_idx = int(na)

if asia_start
    asia_h := high
    asia_l := low
    asia_start_idx := bar_index
else if is_asia
    asia_h := math.max(asia_h, high)
    asia_l := math.min(asia_l, low)

// --- Draw Asian Box ---
var box asia_box = box(na)
if asia_start and show_asia_box
    asia_box := box.new(bar_index, asia_h, bar_index, asia_l, border_color=color.gray, bgcolor=asia_box_col)
else if is_asia and show_asia_box
    box.set_righttop(asia_box, bar_index, asia_h)
    box.set_bottom(asia_box, asia_l)

// --- Sweep Detection (London Open) ---
var bool sweep_h_detected = false
var bool sweep_l_detected = false

if london_start
    sweep_h_detected := false
    sweep_l_detected := false

// Logic: Price wicks through Asia High/Low and closes back inside (BBS logic)
bool bear_sweep = is_london and high > asia_h and close <= asia_h and not sweep_h_detected
bool bull_sweep = is_london and low < asia_l and close >= asia_l and not sweep_l_detected

if bear_sweep
    sweep_h_detected := true
    label.new(bar_index, high, "BEAR SWEEP", color=color.new(sweep_bear_col, 0), textcolor=color.white, style=label.style_label_down)

if bull_sweep
    sweep_l_detected := true
    label.new(bar_index, low, "BULL SWEEP", color=color.new(sweep_bull_col, 0), textcolor=color.white, style=label.style_label_up)

// --- Entry Logic (Displacement Filter) ---
float body_size = math.abs(close - open)
float avg_body  = ta.sma(body_size, 20)
bool is_displaced = body_size > avg_body

plotshape(bear_sweep and is_displaced, "Bear Entry", shape.arrowdown, location.abovebar, color.red, size=size.small)
plotshape(bull_sweep and is_displaced, "Bull Entry", shape.arrowup, location.belowbar, color.green, size=size.small)

// --- Dashboard ---
var table_pos = dash_pos == "top_right" ? position.top_right : dash_pos == "bottom_right" ? position.bottom_right : dash_pos == "top_left" ? position.top_left : position.bottom_left
var table dash = table.new(table_pos, 2, 4, border_width=1, border_color=color.gray, bgcolor=color.new(color.black, 20))

if show_dash and barstate.islast
    table.cell(dash, 0, 0, "Silent Pro Trader", text_color=color.white, text_halign=text.align_center)
    table.merge_cells(dash, 0, 0, 1, 0)

    table.cell(dash, 0, 1, "Phase", text_color=color.gray)
    table.cell(dash, 1, 1, is_asia ? "Asian Range" : is_london ? "London Open" : "Waiting", text_color=color.white)

    table.cell(dash, 0, 2, "Asia High", text_color=color.gray)
    table.cell(dash, 1, 2, str.tostring(asia_h, "#.#####"), text_color=color.white)

    table.cell(dash, 0, 3, "Asia Low", text_color=color.gray)
    table.cell(dash, 1, 3, str.tostring(asia_l, "#.#####"), text_color=color.white)

// --- Plotting Levels (Memory: plot.style_linebr for HTF) ---
plot(asia_h, "Asia High Level", color=color.new(color.gray, 50), style=plot.style_linebr)
plot(asia_l, "Asia Low Level", color=color.new(color.gray, 50), style=plot.style_linebr)
