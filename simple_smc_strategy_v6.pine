//@version=6
strategy("Simple SMC Strategy - @joe_freetrading", overlay = true, max_boxes_count = 500, max_labels_count = 500, initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 10, commission_type = strategy.commission.percent, commission_value = 0.05)

// ==========================================
// --- Inputs ---
// ==========================================
grp_htf = "HTF Settings"
htf_tf = input.timeframe("240", "High Timeframe", group = grp_htf)
htf_pivot_len = input.int(10, "HTF Pivot Length", minval = 1, group = grp_htf)

grp_ltf = "LTF Settings"
ltf_pivot_len = input.int(3, "LTF Pivot Length", minval = 1, group = grp_ltf)
show_bos = input.bool(true, "Show BOS", group = grp_ltf)
show_choch = input.bool(true, "Show CHoCH", group = grp_ltf)

grp_zones = "Zone Settings"
show_ob = input.bool(true, "Show Order Blocks", group = grp_zones)
show_fvg = input.bool(true, "Show FVGs", group = grp_zones)
zone_limit = input.int(20, "Max Active Zones", minval = 1, maxval = 50, group = grp_zones)

// ==========================================
// --- HTF Data Fetching ---
// ==========================================
// Using [1] indexing and lookahead=off to get the PREVIOUS HTF candle data without repainting on the current bar
[htf_high, htf_low, htf_close] = request.security(syminfo.tickerid, htf_tf, [high[1], low[1], close[1]], lookahead = barmerge.lookahead_off)

// HTF Structure Detection
// Function to calculate pivots, returning previous confirmed values to avoid repainting
get_htf_data(len) =>
    ph = ta.pivothigh(high, len, len)
    pl = ta.pivotlow(low, len, len)
    [ph[1], pl[1]]

// Fetching HTF pivots
[htf_ph, htf_pl] = request.security(syminfo.tickerid, htf_tf, get_htf_data(htf_pivot_len), lookahead = barmerge.lookahead_off)

var float last_htf_ph = na
var float last_htf_pl = na
var string htf_bias = "Neutral"

if not na(htf_ph)
    if htf_ph > last_htf_ph
        htf_bias := "Bullish"
    last_htf_ph := htf_ph

if not na(htf_pl)
    if htf_pl < last_htf_pl
        htf_bias := "Bearish"
    last_htf_pl := htf_pl

// Key Levels (Resistance/Support)
plot(last_htf_ph, "HTF Resistance", color.new(color.red, 50), 1, plot.style_linebr)
plot(last_htf_pl, "HTF Support", color.new(color.green, 50), 1, plot.style_linebr)

// ==========================================
// --- LTF Structure (BOS/CHoCH) ---
// ==========================================
var float ltf_ph = na
var float ltf_pl = na
var float ltf_prev_ph = na
var float ltf_prev_pl = na

curr_ph = ta.pivothigh(high, ltf_pivot_len, ltf_pivot_len)
curr_pl = ta.pivotlow(low, ltf_pivot_len, ltf_pivot_len)

if not na(curr_ph)
    ltf_prev_ph := ltf_ph
    ltf_ph := curr_ph

if not na(curr_pl)
    ltf_prev_pl := ltf_pl
    ltf_pl := curr_pl

// Break of Structure (BOS) - Trend Continuation
bool bos_bull = ta.crossover(close, ltf_ph)
bool bos_bear = ta.crossunder(close, ltf_pl)

// Change of Character (CHoCH) - Trend Reversal/Shift
// Simplified: Break of the opposite pivot after a bias is established
bool choch_bull = htf_bias == "Bullish" and ta.crossover(close, ltf_ph) and low[1] < ltf_pl
bool choch_bear = htf_bias == "Bearish" and ta.crossunder(close, ltf_pl) and high[1] > ltf_ph

plotshape(show_bos and bos_bull, "BOS Bull", shape.triangleup, location.belowbar, color.blue, size = size.tiny, text = "BOS")
plotshape(show_bos and bos_bear, "BOS Bear", shape.triangledown, location.abovebar, color.red, size = size.tiny, text = "BOS")
plotshape(show_choch and choch_bull, "CHoCH Bull", shape.triangleup, location.belowbar, color.blue, size = size.small, text = "CHoCH")
plotshape(show_choch and choch_bear, "CHoCH Bear", shape.triangledown, location.abovebar, color.red, size = size.small, text = "CHoCH")

// ==========================================
// --- Zones (Order Blocks & FVGs) ---
// ==========================================
type Zone
    box b
    float top
    float bottom
    string type
    bool is_bull
    int start_bar

var active_zones = array.new<Zone>()

// FVG Detection
is_fvg_bull = low > high[2]
is_fvg_bear = high < low[2]

if show_fvg
    if is_fvg_bull
        active_zones.push(Zone.new(box.new(bar_index - 2, low, bar_index, high[2], bgcolor = color.new(color.green, 85), border_color = na), low, high[2], "FVG", true, bar_index - 2))
    if is_fvg_bear
        active_zones.push(Zone.new(box.new(bar_index - 2, low[2], bar_index, high, bgcolor = color.new(color.red, 85), border_color = na), low[2], high, "FVG", false, bar_index - 2))

// Order Block (OB) Detection
// Last opposite candle before a strong move (breakout)
is_ob_bull = close[1] < open[1] and close > open and close > high[1] and (bos_bull or choch_bull)
is_ob_bear = close[1] > open[1] and close < open and close < low[1] and (bos_bear or choch_bear)

if show_ob
    if is_ob_bull
        active_zones.push(Zone.new(box.new(bar_index - 1, high[1], bar_index, low[1], bgcolor = color.new(color.green, 75), border_color = color.new(color.green, 50)), high[1], low[1], "OB", true, bar_index - 1))
    if is_ob_bear
        active_zones.push(Zone.new(box.new(bar_index - 1, high[1], bar_index, low[1], bgcolor = color.new(color.red, 75), border_color = color.new(color.red, 50)), high[1], low[1], "OB", false, bar_index - 1))

// Cleanup zones
if active_zones.size() > zone_limit
    Zone old_z = active_zones.shift()
    old_z.b.delete()

// Update boxes to extend to current bar
if active_zones.size() > 0
    for i = 0 to active_zones.size() - 1
        Zone z = active_zones.get(i)
        z.b.set_right(bar_index)

// ==========================================
// --- Entry Signal Logic ---
// ==========================================
var bool setup_active = false
var string setup_type = ""

// Setup is active if we have a CHoCH or BOS in the direction of HTF Bias
if (choch_bull or (bos_bull and htf_bias == "Bullish"))
    setup_active := true
    setup_type := "Long"
if (choch_bear or (bos_bear and htf_bias == "Bearish"))
    setup_active := true
    setup_type := "Short"

// Entry when price returns to a valid zone
bool entry_long = false
bool entry_short = false

if setup_active and active_zones.size() > 0
    for i = 0 to active_zones.size() - 1
        // Check from most recent to oldest
        Zone z = active_zones.get(active_zones.size() - 1 - i)
        if setup_type == "Long" and z.is_bull
            if low <= z.top and close >= z.bottom
                entry_long := true
                setup_active := false
                break
        else if setup_type == "Short" and not z.is_bull
            if high >= z.bottom and close <= z.top
                entry_short := true
                setup_active := false
                break

plotshape(entry_long, "Long Entry", shape.labelup, location.belowbar, color.green, size = size.large, text = "BUY SIGNAL", textcolor = color.white)
plotshape(entry_short, "Short Entry", shape.labeldown, location.abovebar, color.red, size = size.large, text = "SELL SIGNAL", textcolor = color.white)

// Strategy Execution
if entry_long
    strategy.entry("Long", strategy.long)
    // Set exit on entry to ensure it's relative to entry price
    strategy.exit("Exit Long", "Long", stop = close * 0.99, limit = close * 1.03)
    alert("Simple SMC: Long Entry Signal at " + str.tostring(close), alert.freq_once_per_bar)

if entry_short
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit Short", "Short", stop = close * 1.01, limit = close * 0.97)
    alert("Simple SMC: Short Entry Signal at " + str.tostring(close), alert.freq_once_per_bar)

// ==========================================
// --- Dashboard ---
// ==========================================
var table dash = table.new(position.bottom_right, 2, 4, bgcolor = color.new(color.black, 20), border_width = 1, border_color = color.gray)

if barstate.islast
    table.cell(dash, 0, 0, "SIMPLE SMC STRATEGY", text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 0, "@joe_freetrading", text_color = color.yellow, text_size = size.small)

    table.cell(dash, 0, 1, "HTF Bias (" + htf_tf + "):", text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 1, htf_bias, text_color = (htf_bias == "Bullish" ? color.green : htf_bias == "Bearish" ? color.red : color.gray), text_size = size.small)

    table.cell(dash, 0, 2, "Setup Status:", text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 2, setup_active ? "Waiting for Retest (" + setup_type + ")" : "Scanning...", text_color = (setup_active ? color.yellow : color.gray), text_size = size.small)

    table.cell(dash, 0, 3, "Active Zones:", text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 3, str.tostring(active_zones.size()), text_color = color.white, text_size = size.small)

// Visual feedback for trend
bgcolor(htf_bias == "Bullish" ? color.new(color.green, 95) : htf_bias == "Bearish" ? color.new(color.red, 95) : na)
