//@version=6
indicator("Smart Money SMC [Mani3131]", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

// --- Inputs ---
grp_vis = "Visibility Settings"
show_ob   = input.bool(true, "Show Order Blocks", group=grp_vis)
show_fvg  = input.bool(true, "Show Fair Value Gaps", group=grp_vis)
show_liq  = input.bool(true, "Show Liquidity Sweeps", group=grp_vis)
show_str  = input.bool(true, "Show Market Structure (BOS/CHoCH)", group=grp_vis)
show_dash = input.bool(true, "Show Dashboard", group=grp_vis)
show_signals = input.bool(true, "Show Trade Signals", group=grp_vis)
show_vp      = input.bool(true, "Show Volume Profile", group=grp_vis)
show_fib     = input.bool(true, "Show Fibonacci Levels", group=grp_vis)
tp_use_fib   = input.bool(false, "Use Fibonacci for TP Targets", group=grp_vis)

grp_vp = "Volume Profile Settings"
vp_lookback = input.int(200, "VP Lookback Bars", minval=50, maxval=500, group=grp_vp)
vp_rows     = input.int(50, "VP Number of Rows", minval=10, maxval=100, group=grp_vp)
vp_width    = input.int(30, "VP Width (%)", minval=5, maxval=100, group=grp_vp)

// --- Color Constants (Modern Palette) ---
color COLOR_BULL      = color.rgb(0, 201, 167)    // Emerald
color COLOR_BEAR      = color.rgb(255, 51, 102)   // Rose
color COLOR_GOLD      = color.rgb(255, 184, 0)    // Gold
color COLOR_BULL_ZONE = color.new(COLOR_BULL, 85)
color COLOR_BEAR_ZONE = color.new(COLOR_BEAR, 85)
color COLOR_TEXT      = color.white

// --- User Defined Types ---
type Pivot
    int   index
    float price
    bool  is_high

type Zone
    int   start_bar
    float top
    float bottom
    bool  is_bullish
    box   box_id
    bool  is_mitigated

type Trade
    float entry_price
    float sl_price
    float tp1_price
    float tp2_price
    float tp3_price
    label entry_label
    label sl_label
    label tp1_label
    label tp2_label
    label tp3_label
    line  entry_line
    line  sl_line
    line  tp1_line
    line  tp2_line
    line  tp3_line
    bool  is_active
    bool  tp1_hit
    bool  tp2_hit

// --- Persistent Variables ---
var Pivot last_high = Pivot.new(na, na, true)
var Pivot last_low  = Pivot.new(na, na, false)
var Pivot prev_high = Pivot.new(na, na, true)
var Pivot prev_low  = Pivot.new(na, na, false)

var array<Zone> ob_zones  = array.new<Zone>()
var array<Zone> fvg_zones = array.new<Zone>()
var array<Trade> active_trades = array.new<Trade>()

var float trend_state = 0 // 1 for Bullish, -1 for Bearish

// --- Pivot Detection ---
ph = ta.pivothigh(high, 5, 5)
pl = ta.pivotlow(low, 5, 5)

if not na(ph)
    prev_high := Pivot.new(last_high.index, last_high.price, true)
    last_high := Pivot.new(bar_index[5], ph, true)

if not na(pl)
    prev_low := Pivot.new(last_low.index, last_low.price, false)
    last_low := Pivot.new(bar_index[5], pl, false)

// --- Market Structure (BOS/CHoCH) ---
float break_high = last_high.price
float break_low  = last_low.price

// Bullish Breakout
if show_str and close > break_high and not na(break_high)
    if trend_state == -1
        label.new(bar_index, high, "CHoCH", color=COLOR_BULL, textcolor=COLOR_TEXT, style=label.style_label_down, size=size.tiny)
        trend_state := 1
    else if trend_state == 1
        label.new(bar_index, high, "BOS", color=COLOR_BULL, textcolor=COLOR_TEXT, style=label.style_label_down, size=size.tiny)
    else if trend_state == 0
        trend_state := 1
    last_high.price := na // Reset to avoid double triggers

// Bearish Breakout
if show_str and close < break_low and not na(break_low)
    if trend_state == 1
        label.new(bar_index, low, "CHoCH", color=COLOR_BEAR, textcolor=COLOR_TEXT, style=label.style_label_up, size=size.tiny)
        trend_state := -1
    else if trend_state == -1
        label.new(bar_index, low, "BOS", color=COLOR_BEAR, textcolor=COLOR_TEXT, style=label.style_label_up, size=size.tiny)
    else if trend_state == 0
        trend_state := -1
    last_low.price := na // Reset to avoid double triggers

// --- Supply & Demand (OB/FVG) ---
// FVG Detection
if show_fvg
    if high[2] < low[0] // Bullish FVG
        box_id = box.new(bar_index[2], low[0], bar_index, high[2], border_color=na, bgcolor=COLOR_BULL_ZONE)
        array.push(fvg_zones, Zone.new(bar_index[2], low[0], high[2], true, box_id, false))
    else if low[2] > high[0] // Bearish FVG
        box_id = box.new(bar_index[2], low[2], bar_index, high[0], border_color=na, bgcolor=COLOR_BEAR_ZONE)
        array.push(fvg_zones, Zone.new(bar_index[2], low[2], high[0], false, box_id, false))

// Order Block (OB) Detection - Simplified: last opposite candle before a move that creates a pivot
if show_ob
    if not na(ph) // Possible Bearish OB
        if close[5] < open[5] // Bearish candle
            box_id = box.new(bar_index[5], high[5], bar_index, low[5], border_color=na, bgcolor=COLOR_BEAR_ZONE)
            array.push(ob_zones, Zone.new(bar_index[5], high[5], low[5], false, box_id, false))

    if not na(pl) // Possible Bullish OB
        if close[5] > open[5] // Bullish candle
            box_id = box.new(bar_index[5], high[5], bar_index, low[5], border_color=na, bgcolor=COLOR_BULL_ZONE)
            array.push(ob_zones, Zone.new(bar_index[5], high[5], low[5], true, box_id, false))

// --- Liquidity Sweep (Stop Hunt) ---
bool sweep_low  = low < last_low.price and close > last_low.price
bool sweep_high = high > last_high.price and close < last_high.price

if show_liq
    if sweep_low
        label.new(bar_index, low, "LIQ SWEEP", color=COLOR_BULL, textcolor=COLOR_TEXT, style=label.style_label_up, size=size.tiny)
    if sweep_high
        label.new(bar_index, high, "LIQ SWEEP", color=COLOR_BEAR, textcolor=COLOR_TEXT, style=label.style_label_down, size=size.tiny)

// --- Zone Mitigation & Cleanup ---
if array.size(ob_zones) > 0
    for i = array.size(ob_zones) - 1 to 0
        Zone z = array.get(ob_zones, i)
        bool mitigated = false
        if z.is_bullish
            if low <= z.bottom
                mitigated := true
        else
            if high >= z.top
                mitigated := true

        if mitigated
            box.delete(z.box_id)
            array.remove(ob_zones, i)
        else
            box.set_right(z.box_id, bar_index)

if array.size(fvg_zones) > 0
    for i = array.size(fvg_zones) - 1 to 0
        Zone z = array.get(fvg_zones, i)
        bool mitigated = false
        if z.is_bullish
            if low <= z.bottom
                mitigated := true
        else
            if high >= z.top
                mitigated := true

        if mitigated
            box.delete(z.box_id)
            array.remove(fvg_zones, i)
        else
            box.set_right(z.box_id, bar_index)

// --- Fibonacci Levels Logic ---
var array<line> fib_lines = array.new<line>()
var array<label> fib_labels = array.new<label>()

if show_fib
    float swing_high = last_high.price
    float swing_low  = last_low.price

    if not na(swing_high) and not na(swing_low)
        // Cleanup old drawings
        if array.size(fib_lines) > 0
            for l in fib_lines
                line.delete(l)
            array.clear(fib_lines)
        if array.size(fib_labels) > 0
            for lb in fib_labels
                label.delete(lb)
            array.clear(fib_labels)

        float diff = swing_high - swing_low
        array<float> fib_ratios = array.from(0.0, 0.236, 0.382, 0.5, 0.618, 0.786, 1.0)

        for ratio in fib_ratios
            float level_price = swing_high - (diff * ratio)
            l = line.new(bar_index - 50, level_price, bar_index + 10, level_price, color=color.new(color.gray, 60), style=line.style_dotted)
            lb = label.new(bar_index + 10, level_price, str.tostring(ratio * 100, "#.#") + "% (" + str.tostring(level_price, format.mintick) + ")", textcolor=color.new(color.gray, 20), style=label.style_label_left, size=size.tiny, color=color.new(color.white, 100))
            array.push(fib_lines, l)
            array.push(fib_labels, lb)

// --- Multi-Timeframe (MTF) Trend ---
htf1 = timeframe.period == "1" ? "5" : timeframe.period == "5" ? "15" : timeframe.period == "15" ? "60" : "D"
htf2 = timeframe.period == "1" ? "15" : timeframe.period == "5" ? "60" : timeframe.period == "15" ? "240" : "W"

[htf1_close, htf1_open] = request.security(syminfo.tickerid, htf1, [close[1], open[1]])
[htf2_close, htf2_open] = request.security(syminfo.tickerid, htf2, [close[1], open[1]])

float htf1_trend = htf1_close > htf1_open ? 1 : -1
float htf2_trend = htf2_close > htf2_open ? 1 : -1

// --- Signal Generation (Advanced Flow) ---
// Trend (HTF) + Zone (OB/FVG) + Sweep + Confirmation
bool bullish_conf = show_signals and sweep_low and htf1_trend == 1 and htf2_trend == 1
bool bearish_conf = show_signals and sweep_high and htf1_trend == -1 and htf2_trend == -1

if bullish_conf
    float entry = close
    float sl    = low[1] < low ? low[1] : low
    float risk  = entry - sl

    float swing_high = last_high.price
    float swing_low  = last_low.price
    float diff = swing_high - swing_low

    float tp1   = tp_use_fib ? swing_high + (diff * 0.27) : entry + risk
    float tp2   = tp_use_fib ? swing_high + (diff * 0.618) : entry + risk * 2
    float tp3   = tp_use_fib ? swing_high + (diff * 1.0) : entry + risk * 3

    l_entry = label.new(bar_index, entry, "ENTRY: " + str.tostring(entry, format.mintick), color=color.new(color.blue, 20), textcolor=COLOR_TEXT, style=label.style_label_left, size=size.small)
    l_sl    = label.new(bar_index, sl, "SL: " + str.tostring(sl, format.mintick), color=color.new(COLOR_BEAR, 20), textcolor=COLOR_TEXT, style=label.style_label_left, size=size.small)
    l_tp1   = label.new(bar_index, tp1, "TP1: " + str.tostring(tp1, format.mintick), color=color.new(COLOR_BULL, 20), textcolor=COLOR_TEXT, style=label.style_label_left, size=size.small)
    l_tp2   = label.new(bar_index, tp2, "TP2: " + str.tostring(tp2, format.mintick), color=color.new(COLOR_BULL, 20), textcolor=COLOR_TEXT, style=label.style_label_left, size=size.small)
    l_tp3   = label.new(bar_index, tp3, "TP3: " + str.tostring(tp3, format.mintick), color=color.new(COLOR_BULL, 20), textcolor=COLOR_TEXT, style=label.style_label_left, size=size.small)

    li_entry = line.new(bar_index, entry, bar_index + 10, entry, color=color.blue, style=line.style_dashed, width=2)
    li_sl    = line.new(bar_index, sl, bar_index + 10, sl, color=COLOR_BEAR, style=line.style_dashed, width=2)
    li_tp1   = line.new(bar_index, tp1, bar_index + 10, tp1, color=COLOR_BULL, style=line.style_dashed, width=2)
    li_tp2   = line.new(bar_index, tp2, bar_index + 10, tp2, color=COLOR_BULL, style=line.style_dashed, width=2)
    li_tp3   = line.new(bar_index, tp3, bar_index + 10, tp3, color=COLOR_BULL, style=line.style_dashed, width=2)

    array.push(active_trades, Trade.new(entry, sl, tp1, tp2, tp3, l_entry, l_sl, l_tp1, l_tp2, l_tp3, li_entry, li_sl, li_tp1, li_tp2, li_tp3, true, false, false))

if bearish_conf
    float entry = close
    float sl    = high[1] > high ? high[1] : high
    float risk  = sl - entry

    float swing_high = last_high.price
    float swing_low  = last_low.price
    float diff = swing_high - swing_low

    float tp1   = tp_use_fib ? swing_low - (diff * 0.27) : entry - risk
    float tp2   = tp_use_fib ? swing_low - (diff * 0.618) : entry - risk * 2
    float tp3   = tp_use_fib ? swing_low - (diff * 1.0) : entry - risk * 3

    l_entry = label.new(bar_index, entry, "ENTRY: " + str.tostring(entry, format.mintick), color=color.new(color.blue, 20), textcolor=COLOR_TEXT, style=label.style_label_left, size=size.small)
    l_sl    = label.new(bar_index, sl, "SL: " + str.tostring(sl, format.mintick), color=color.new(COLOR_BEAR, 20), textcolor=COLOR_TEXT, style=label.style_label_left, size=size.small)
    l_tp1   = label.new(bar_index, tp1, "TP1: " + str.tostring(tp1, format.mintick), color=color.new(COLOR_BULL, 20), textcolor=COLOR_TEXT, style=label.style_label_left, size=size.small)
    l_tp2   = label.new(bar_index, tp2, "TP2: " + str.tostring(tp2, format.mintick), color=color.new(COLOR_BULL, 20), textcolor=COLOR_TEXT, style=label.style_label_left, size=size.small)
    l_tp3   = label.new(bar_index, tp3, "TP3: " + str.tostring(tp3, format.mintick), color=color.new(COLOR_BULL, 20), textcolor=COLOR_TEXT, style=label.style_label_left, size=size.small)

    li_entry = line.new(bar_index, entry, bar_index + 10, entry, color=color.blue, style=line.style_dashed, width=2)
    li_sl    = line.new(bar_index, sl, bar_index + 10, sl, color=COLOR_BEAR, style=line.style_dashed, width=2)
    li_tp1   = line.new(bar_index, tp1, bar_index + 10, tp1, color=COLOR_BULL, style=line.style_dashed, width=2)
    li_tp2   = line.new(bar_index, tp2, bar_index + 10, tp2, color=COLOR_BULL, style=line.style_dashed, width=2)
    li_tp3   = line.new(bar_index, tp3, bar_index + 10, tp3, color=COLOR_BULL, style=line.style_dashed, width=2)

    array.push(active_trades, Trade.new(entry, sl, tp1, tp2, tp3, l_entry, l_sl, l_tp1, l_tp2, l_tp3, li_entry, li_sl, li_tp1, li_tp2, li_tp3, true, false, false))

// --- Drawing Management & Cleanup ---
if array.size(active_trades) > 0
    for i = array.size(active_trades) - 1 to 0
        Trade t = array.get(active_trades, i)
        bool to_remove = false

        // Update line endpoints
        line.set_x2(t.entry_line, bar_index + 5)
        line.set_x2(t.sl_line, bar_index + 5)
        line.set_x2(t.tp1_line, bar_index + 5)
        line.set_x2(t.tp2_line, bar_index + 5)
        line.set_x2(t.tp3_line, bar_index + 5)

        // Check for TP/SL hits
        bool is_bull = t.tp1_price > t.entry_price

        if is_bull
            if low <= t.sl_price
                to_remove := true
            else if high >= t.tp1_price and not t.tp1_hit
                t.tp1_hit := true
                label.new(bar_index, t.tp1_price, "+" + str.tostring(math.abs(t.tp1_price - t.entry_price) / syminfo.mintick / 10, "#.#") + " Pips", color=COLOR_BULL, textcolor=COLOR_TEXT, style=label.style_label_down, size=size.tiny)
                label.delete(t.tp1_label)
                line.delete(t.tp1_line)
            else if high >= t.tp2_price and not t.tp2_hit
                t.tp2_hit := true
                label.new(bar_index, t.tp2_price, "+" + str.tostring(math.abs(t.tp2_price - t.entry_price) / syminfo.mintick / 10, "#.#") + " Pips", color=COLOR_BULL, textcolor=COLOR_TEXT, style=label.style_label_down, size=size.tiny)
                label.delete(t.tp2_label)
                line.delete(t.tp2_line)
            else if high >= t.tp3_price
                label.new(bar_index, t.tp3_price, "+" + str.tostring(math.abs(t.tp3_price - t.entry_price) / syminfo.mintick / 10, "#.#") + " Pips", color=COLOR_BULL, textcolor=COLOR_TEXT, style=label.style_label_down, size=size.tiny)
                to_remove := true
        else
            if high >= t.sl_price
                to_remove := true
            else if low <= t.tp1_price and not t.tp1_hit
                t.tp1_hit := true
                label.new(bar_index, t.tp1_price, "+" + str.tostring(math.abs(t.tp1_price - t.entry_price) / syminfo.mintick / 10, "#.#") + " Pips", color=COLOR_BULL, textcolor=COLOR_TEXT, style=label.style_label_up, size=size.tiny)
                label.delete(t.tp1_label)
                line.delete(t.tp1_line)
            else if low <= t.tp2_price and not t.tp2_hit
                t.tp2_hit := true
                label.new(bar_index, t.tp2_price, "+" + str.tostring(math.abs(t.tp2_price - t.entry_price) / syminfo.mintick / 10, "#.#") + " Pips", color=COLOR_BULL, textcolor=COLOR_TEXT, style=label.style_label_up, size=size.tiny)
                label.delete(t.tp2_label)
                line.delete(t.tp2_line)
            else if low <= t.tp3_price
                label.new(bar_index, t.tp3_price, "+" + str.tostring(math.abs(t.tp3_price - t.entry_price) / syminfo.mintick / 10, "#.#") + " Pips", color=COLOR_BULL, textcolor=COLOR_TEXT, style=label.style_label_up, size=size.tiny)
                to_remove := true

        if to_remove
            label.delete(t.entry_label)
            label.delete(t.sl_label)
            label.delete(t.tp1_label)
            label.delete(t.tp2_label)
            label.delete(t.tp3_label)
            line.delete(t.entry_line)
            line.delete(t.sl_line)
            line.delete(t.tp1_line)
            line.delete(t.tp2_line)
            line.delete(t.tp3_line)
            array.remove(active_trades, i)

// --- Volume Profile Calculation ---
var array<box> vp_boxes = array.new<box>()
if show_vp and barstate.islast
    float vp_max_high = ta.highest(high, vp_lookback)
    float vp_min_low  = ta.lowest(low, vp_lookback)
    float vp_row_size = (vp_max_high - vp_min_low) / vp_rows

    array<float> vp_volumes = array.new_float(vp_rows, 0.0)

    for i = 0 to vp_lookback - 1
        float bar_vol = volume[i]
        float bar_high = high[i]
        float bar_low = low[i]

        int row_start = int(math.max(0, math.min(vp_rows - 1, math.floor((bar_low - vp_min_low) / vp_row_size))))
        int row_end   = int(math.max(0, math.min(vp_rows - 1, math.floor((bar_high - vp_min_low) / vp_row_size))))

        float vol_per_row = bar_vol / (row_end - row_start + 1)
        for r = row_start to row_end
            array.set(vp_volumes, r, array.get(vp_volumes, r) + vol_per_row)

    float max_vol = array.max(vp_volumes)
    int poc_row = array.indexof(vp_volumes, max_vol)
    int vp_start_bar = bar_index + 2

    if array.size(vp_boxes) > 0
        for b in vp_boxes
            box.delete(b)
        array.clear(vp_boxes)

    for r = 0 to vp_rows - 1
        float vol = array.get(vp_volumes, r)
        float row_low = vp_min_low + r * vp_row_size
        float row_high = row_low + vp_row_size
        int box_len = int((vol / max_vol) * vp_width)

        if vol > 0
            color b_color = (r == poc_row) ? color.new(color.orange, 50) : color.new(color.gray, 80)
            b = box.new(vp_start_bar, row_high, vp_start_bar + box_len, row_low, bgcolor=b_color, border_color=na)
            array.push(vp_boxes, b)

// --- Watermark & Branding ---
var table watermark = table.new(position.middle_center, 1, 1)
if barstate.islast
    table.cell(watermark, 0, 0, "SMC PRO [JULES]", text_size=size.huge, text_color=color.new(color.gray, 90))

// --- Dashboard Table ---
var table board = table.new(position.top_right, 2, 4, border_width=1, frame_color=color.new(color.gray, 50), frame_width=1)
if show_dash and barstate.islast
    table.cell(board, 0, 0, "Timeframe", bgcolor=color.new(color.gray, 20), text_color=COLOR_TEXT)
    table.cell(board, 1, 0, "Trend", bgcolor=color.new(color.gray, 20), text_color=COLOR_TEXT)

    table.cell(board, 0, 1, "HTF (" + htf2 + ")", text_color=COLOR_TEXT)
    table.cell(board, 1, 1, htf2_trend == 1 ? "BULLISH" : "BEARISH", bgcolor=htf2_trend == 1 ? color.new(COLOR_BULL, 20) : color.new(COLOR_BEAR, 20), text_color=htf2_trend == 1 ? COLOR_BULL : COLOR_BEAR)

    table.cell(board, 0, 2, "MTF (" + htf1 + ")", text_color=COLOR_TEXT)
    table.cell(board, 1, 2, htf1_trend == 1 ? "BULLISH" : "BEARISH", bgcolor=htf1_trend == 1 ? color.new(COLOR_BULL, 20) : color.new(COLOR_BEAR, 20), text_color=htf1_trend == 1 ? COLOR_BULL : COLOR_BEAR)

    table.cell(board, 0, 3, "LTF (Current)", text_color=COLOR_TEXT)
    table.cell(board, 1, 3, trend_state == 1 ? "BULLISH" : trend_state == -1 ? "BEARISH" : "NEUTRAL", bgcolor=trend_state == 1 ? color.new(COLOR_BULL, 20) : trend_state == -1 ? color.new(COLOR_BEAR, 20) : color.new(color.gray, 20), text_color=trend_state == 1 ? COLOR_BULL : trend_state == -1 ? COLOR_BEAR : color.gray)
