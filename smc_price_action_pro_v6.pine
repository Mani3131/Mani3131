//@version=6
indicator("SMC Price Action Pro", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// --- Colors ---
color EMERALD = color.rgb(0, 201, 167)
color ROSE    = color.rgb(255, 51, 102)
color GOLD    = color.rgb(255, 184, 0)
color SLATE   = color.rgb(47, 54, 64)

// --- Inputs ---
group_ms = "Market Structure"
pivot_len = input.int(5, "Pivot Lookback", minval = 1, group = group_ms)
show_hhll = input.bool(true, "Show HH/HL/LH/LL", group = group_ms)
show_ms   = input.bool(true, "Show BOS/CHoCH", group = group_ms)
ema_filter = input.bool(true, "Use EMA 200 Filter", group = group_ms)

group_zones = "Zones & Gaps"
show_ob   = input.bool(true, "Show Order Blocks", group = group_zones)
show_fvg  = input.bool(true, "Show Fair Value Gaps", group = group_zones)
ob_len    = input.int(5, "OB Lookback", minval = 1, group = group_zones)

group_liq = "Liquidity & Sessions"
show_liq  = input.bool(true, "Show Liquidity Grabs", group = group_liq)
show_sess = input.bool(true, "Show Killzones", group = group_liq)

group_signals = "Signals"
show_signals = input.bool(true, "Show Entry Signals", group = group_signals)
show_pinbars = input.bool(true, "Show Pin Bars", group = group_signals)

group_dash = "Dashboard"
show_dash = input.bool(true, "Show Dashboard", group = group_dash)
dash_loc  = input.string("top_right", "Location", options = ["top_right", "bottom_right", "top_left", "bottom_left"], group = group_dash)

// Sessions (UTC+3 / GMT+3) - As per user preference in memory
asian_sess  = input.session("0300-0900", "Asian Killzone", group = group_liq)
london_sess = input.session("0900-1400", "London Killzone", group = group_liq)
ny_am_sess  = input.session("1500-1900", "NY AM Killzone", group = group_liq)
ny_pm_sess  = input.session("2000-2345", "NY PM Killzone", group = group_liq)

// --- Types ---
type Pivot
    int   index
    float price
    bool  is_high

type Structure
    string label
    float  price
    int    index
    bool   is_bos

type Zone
    float top
    float bottom
    int   start_index
    box   box_id
    bool  is_bullish
    bool  is_mitigated

// --- Global State ---
var Pivot last_ph = na
var Pivot last_pl = na
var Pivot prev_ph = na
var Pivot prev_pl = na

var float hh = na
var float hl = na
var float lh = na
var float ll = na

var string trend = "Neutral"
var bool is_bullish = false

float ema200 = ta.ema(close, 200)
plot(ema_filter ? ema200 : na, "EMA 200", color = color.new(color.gray, 50))

var Zone[] ob_zones = array.new<Zone>()
var Zone[] fvg_zones = array.new<Zone>()

// --- Market Structure Logic ---
ph = ta.pivothigh(pivot_len, pivot_len)
pl = ta.pivotlow(pivot_len, pivot_len)

if not na(ph)
    prev_ph := last_ph
    last_ph := Pivot.new(index = bar_index - pivot_len, price = ph, is_high = true)

    if not na(prev_ph)
        if last_ph.price > prev_ph.price
            hh := last_ph.price
            if show_hhll
                label.new(last_ph.index, last_ph.price, "HH", color = color.new(color.gray, 100), textcolor = EMERALD, style = label.style_label_down, size = size.tiny)
        else
            lh := last_ph.price
            if show_hhll
                label.new(last_ph.index, last_ph.price, "LH", color = color.new(color.gray, 100), textcolor = ROSE, style = label.style_label_down, size = size.tiny)

if not na(pl)
    prev_pl := last_pl
    last_pl := Pivot.new(index = bar_index - pivot_len, price = pl, is_high = false)

    if not na(prev_pl)
        if last_pl.price < prev_pl.price
            ll := last_pl.price
            if show_hhll
                label.new(last_pl.index, last_pl.price, "LL", color = color.new(color.gray, 100), textcolor = ROSE, style = label.style_label_up, size = size.tiny)
        else
            hl := last_pl.price
            if show_hhll
                label.new(last_pl.index, last_pl.price, "HL", color = color.new(color.gray, 100), textcolor = EMERALD, style = label.style_label_up, size = size.tiny)

// BOS / CHoCH Detection
var float top_break = na
var float bot_break = na

if not na(last_ph)
    top_break := last_ph.price
if not na(last_pl)
    bot_break := last_pl.price

bool break_up = ta.crossover(close, top_break)
bool break_dn = ta.crossunder(close, bot_break)

if break_up
    string label_text = is_bullish ? "BOS" : "CHoCH"
    if show_ms
        label.new(bar_index, high, label_text, color = color.new(EMERALD, 80), textcolor = EMERALD, style = label.style_none, size = size.small)
        line.new(last_ph.index, last_ph.price, bar_index, last_ph.price, color = EMERALD, style = line.style_dashed)
    is_bullish := true
    trend := "Bullish"
    top_break := na // Reset to wait for next pivot

if break_dn
    string label_text = not is_bullish ? "BOS" : "CHoCH"
    if show_ms
        label.new(bar_index, low, label_text, color = color.new(ROSE, 80), textcolor = ROSE, style = label.style_none, size = size.small)
        line.new(last_pl.index, last_pl.price, bar_index, last_pl.price, color = ROSE, style = line.style_dashed)
    is_bullish := false
    trend := "Bearish"
    bot_break := na // Reset to wait for next pivot

// --- Supply / Demand (Order Blocks) ---
if show_ob
    // Simple OB: The candle before a strong move that breaks structure or is impulsive
    // Here we'll use a simple version: the candle before a pivot that leads to a BOS
    if break_up and not na(last_pl)
        // Find the lowest candle near last_pl
        float ob_low = low[bar_index - last_pl.index]
        float ob_high = high[bar_index - last_pl.index]
        box b = box.new(last_pl.index, ob_high, bar_index, ob_low, border_color = color.new(EMERALD, 50), bgcolor = color.new(EMERALD, 90))
        array.push(ob_zones, Zone.new(top = ob_high, bottom = ob_low, start_index = last_pl.index, box_id = b, is_bullish = true, is_mitigated = false))

    if break_dn and not na(last_ph)
        float ob_high = high[bar_index - last_ph.index]
        float ob_low = low[bar_index - last_ph.index]
        box b = box.new(last_ph.index, ob_high, bar_index, ob_low, border_color = color.new(ROSE, 50), bgcolor = color.new(ROSE, 90))
        array.push(ob_zones, Zone.new(top = ob_high, bottom = ob_low, start_index = last_ph.index, box_id = b, is_bullish = false, is_mitigated = false))

// --- Fair Value Gaps (FVG) ---
if show_fvg
    // Bullish FVG: Low of candle 1 > High of candle 3
    if low[0] > high[2]
        box b = box.new(bar_index - 2, low[0], bar_index, high[2], border_color = color.new(EMERALD, 70), bgcolor = color.new(EMERALD, 95))
        array.push(fvg_zones, Zone.new(top = low[0], bottom = high[2], start_index = bar_index - 2, box_id = b, is_bullish = true, is_mitigated = false))

    // Bearish FVG: High of candle 1 < Low of candle 3
    if high[0] < low[2]
        box b = box.new(bar_index - 2, low[2], bar_index, high[0], border_color = color.new(ROSE, 70), bgcolor = color.new(ROSE, 95))
        array.push(fvg_zones, Zone.new(top = low[2], bottom = high[0], start_index = bar_index - 2, box_id = b, is_bullish = false, is_mitigated = false))

// Zone Mitigation & Cleanup
update_zones(Zone[] zones) =>
    if array.size(zones) > 0
        for i = array.size(zones) - 1 to 0
            Zone z = array.get(zones, i)
            if not z.is_mitigated
                box.set_right(z.box_id, bar_index)
                if z.is_bullish
                    if low < z.bottom
                        z.is_mitigated := true
                        box.set_bgcolor(z.box_id, color.new(color.gray, 95))
                        box.set_border_color(z.box_id, color.new(color.gray, 80))
                else
                    if high > z.top
                        z.is_mitigated := true
                        box.set_bgcolor(z.box_id, color.new(color.gray, 95))
                        box.set_border_color(z.box_id, color.new(color.gray, 80))

update_zones(ob_zones)
update_zones(fvg_zones)

// --- Liquidity Grabs ---
if show_liq
    if not na(last_ph) and high > last_ph.price and close < last_ph.price
        label.new(bar_index, high, "Liq Grab", color = color.new(ROSE, 80), textcolor = ROSE, style = label.style_label_down, size = size.tiny)

    if not na(last_pl) and low < last_pl.price and close > last_pl.price
        label.new(bar_index, low, "Liq Grab", color = color.new(EMERALD, 80), textcolor = EMERALD, style = label.style_label_up, size = size.tiny)

// --- Session Killzones ---
in_session(sess) =>
    not na(time(timeframe.period, sess, "GMT+3"))

is_asian  = in_session(asian_sess)
is_london = in_session(london_sess)
is_ny_am  = in_session(ny_am_sess)
is_ny_pm  = in_session(ny_pm_sess)

if show_sess
    bgcolor(is_asian  ? color.new(GOLD, 90)    : na, title = "Asian Session")
    bgcolor(is_london ? color.new(EMERALD, 90) : na, title = "London Session")
    bgcolor(is_ny_am  ? color.new(ROSE, 90)    : na, title = "NY AM Session")
    bgcolor(is_ny_pm  ? color.new(SLATE, 90)   : na, title = "NY PM Session")

// --- Signal Confluence ---
if show_signals
    // Check for confluence: CHoCH/MSS after Liquidity Grab OR after tapping S/D zone
    bool confluence_bull = false
    bool confluence_bear = false

    // Check if we tapped a bullish zone recently
    bool tapped_bull_zone = false
    for z in ob_zones
        if not z.is_mitigated and z.is_bullish and low <= z.top and high >= z.bottom
            tapped_bull_zone := true
            break
    for z in fvg_zones
        if not z.is_mitigated and z.is_bullish and low <= z.top and high >= z.bottom
            tapped_bull_zone := true
            break

    bool tapped_bear_zone = false
    for z in ob_zones
        if not z.is_mitigated and not z.is_bullish and high >= z.bottom and low <= z.top
            tapped_bear_zone := true
            break
    for z in fvg_zones
        if not z.is_mitigated and not z.is_bullish and high >= z.bottom and low <= z.top
            tapped_bear_zone := true
            break

    // Bullish Entry: CHoCH after tapping Bull zone or Liquidity Grab
    if break_up and tapped_bull_zone
        label.new(bar_index, low, "BUY\n(SMC Confluence)", color = color.new(EMERALD, 0), textcolor = color.white, style = label.style_label_up, size = size.normal)

    // Bearish Entry: CHoCH after tapping Bear zone or Liquidity Grab
    if break_dn and tapped_bear_zone
        label.new(bar_index, high, "SELL\n(SMC Confluence)", color = color.new(ROSE, 0), textcolor = color.white, style = label.style_label_down, size = size.normal)

    // Double Bottom / Triple Bottom detection (Simplified)
    if not na(pl) and not na(prev_pl)
        if math.abs(pl - prev_pl.price) < (ta.atr(14) * 0.1)
            label.new(bar_index - pivot_len, low[pivot_len], "Equal Lows", color = color.new(EMERALD, 80), textcolor = EMERALD, style = label.style_label_up, size = size.tiny)

    if not na(ph) and not na(prev_ph)
        if math.abs(ph - prev_ph.price) < (ta.atr(14) * 0.1)
            label.new(bar_index - pivot_len, high[pivot_len], "Equal Highs", color = color.new(ROSE, 80), textcolor = ROSE, style = label.style_label_down, size = size.tiny)

    // Fibo Retest 0.618 (Simplified: check if price is near 0.618 of last major leg)
    if not na(last_ph) and not na(last_pl)
        float range = last_ph.price - last_pl.price
        float fib_618 = is_bullish ? last_ph.price - (range * 0.618) : last_pl.price + (range * 0.618)
        if math.abs(close - fib_618) < (ta.atr(14) * 0.05)
            label.new(bar_index, is_bullish ? low : high, "Fib 0.618", color = color.new(GOLD, 80), textcolor = GOLD, style = is_bullish ? label.style_label_up : label.style_label_down, size = size.tiny)

// --- Pin Bars ---
if show_pinbars
    float body = math.abs(close - open)
    float total_range = high - low
    bool is_bull_pin = (total_range > 0) and (low < open and low < close) and (math.min(open, close) - low > total_range * 0.6) and (body < total_range * 0.3)
    bool is_bear_pin = (total_range > 0) and (high > open and high > close) and (high - math.max(open, close) > total_range * 0.6) and (body < total_range * 0.3)

    if is_bull_pin
        label.new(bar_index, low, "Pin Bar", color = color.new(EMERALD, 80), textcolor = EMERALD, style = label.style_label_up, size = size.tiny)
    if is_bear_pin
        label.new(bar_index, high, "Pin Bar", color = color.new(ROSE, 80), textcolor = ROSE, style = label.style_label_down, size = size.tiny)

// --- Dashboard ---
if show_dash and barstate.islast
    var table_pos = dash_loc == "top_right" ? position.top_right : dash_loc == "bottom_right" ? position.bottom_right : dash_loc == "top_left" ? position.top_left : position.bottom_left
    var table dash = table.new(table_pos, 2, 5, bgcolor = color.new(SLATE, 10), border_width = 1, border_color = color.new(color.gray, 50))

    table.cell(dash, 0, 0, "SMC Price Action Pro", text_color = color.white, bgcolor = SLATE, text_size = size.small)
    table.merge_cells(dash, 0, 0, 1, 0)

    table.cell(dash, 0, 1, "Trend", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 1, trend, text_color = is_bullish ? EMERALD : ROSE, text_size = size.small)

    table.cell(dash, 0, 2, "Market Bias", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 2, is_bullish ? "Bullish" : "Bearish", text_color = is_bullish ? EMERALD : ROSE, text_size = size.small)

    table.cell(dash, 0, 3, "Killzone", text_color = color.gray, text_size = size.small)
    string current_sess = is_asian ? "Asian" : is_london ? "London" : is_ny_am ? "NY AM" : is_ny_pm ? "NY PM" : "None"
    table.cell(dash, 1, 3, current_sess, text_color = color.white, text_size = size.small)

    table.cell(dash, 0, 4, "Version", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 4, "v1.0", text_color = GOLD, text_size = size.small)

plot(na)
