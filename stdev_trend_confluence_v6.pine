// @version=6
strategy("Standard Deviation Trend Confluence Strategy", overlay=true, max_labels_count=500, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// --- Inputs ---
ema_len = input.int(200, "EMA Length", minval=1)
rsi_len = input.int(14, "RSI Length", minval=1)
stdev_len = input.int(20, "Stdev Length", minval=1)
stdev_sma_len = input.int(20, "Stdev SMA Length", minval=1)

// Risk Management
atr_len = input.int(14, "ATR Length for SL")
sl_mult = input.float(2.0, "SL ATR Multiplier")
tp_ratio = input.float(1.5, "Risk:Reward Ratio")

// --- Calculations ---
ema_val = ta.ema(close, ema_len)
rsi_val = ta.rsi(close, rsi_len)
atr_val = ta.atr(atr_len)

// Trend Logic
is_bullish_trend = close > ema_val
is_bearish_trend = close < ema_val

// Momentum Logic
is_bullish_mom = rsi_val > 50
is_bearish_mom = rsi_val < 50

// Volatility Logic
stdev_val = ta.stdev(close, stdev_len)
stdev_sma = ta.sma(stdev_val, stdev_sma_len)
vol_breakout = ta.crossover(stdev_val, stdev_sma)

// --- Signals ---
long_signal = vol_breakout and is_bullish_trend and is_bullish_mom
short_signal = vol_breakout and is_bearish_trend and is_bearish_mom

// --- Strategy Execution ---
var float sl_price = na
var float tp_price = na

if long_signal and strategy.position_size == 0
    sl_price := low - atr_val * sl_mult
    risk = close - sl_price
    tp_price := close + risk * tp_ratio
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit Long", "Long", stop=sl_price, limit=tp_price, comment_loss="SL", comment_profit="TP")

if short_signal and strategy.position_size == 0
    sl_price := high + atr_val * sl_mult
    risk = sl_price - close
    tp_price := close - risk * tp_ratio
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit Short", "Short", stop=sl_price, limit=tp_price, comment_loss="SL", comment_profit="TP")

// Reset levels when flat and no signal (delayed by 1 bar to show exit)
if strategy.position_size == 0 and not long_signal and not short_signal and strategy.position_size[1] == 0
    sl_price := na
    tp_price := na

// --- Visuals ---
plot(ema_val, "200 EMA", color.new(color.gray, 50), 2)

// Plot Entry, SL and TP for active trades
plot(strategy.position_size != 0 ? strategy.position_avg_price : na, "Entry Price", color.new(color.white, 50), 1, plot.style_linebr)
plot(sl_price, "Stop Loss", color.new(color.red, 30), 2, plot.style_linebr)
plot(tp_price, "Take Profit", color.new(color.green, 30), 2, plot.style_linebr)

if long_signal and barstate.isconfirmed
    label.new(bar_index, low, "BUY Entry", color=color.green, textcolor=color.white, style=label.style_label_up, size=size.small)

if short_signal and barstate.isconfirmed
    label.new(bar_index, high, "SELL Entry", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.small)

// --- Dashboard ---
var table main_table = table.new(position.top_right, 2, 4, border_width=1, border_color=color.gray)

if barstate.islast
    table.cell(main_table, 0, 0, "Metric", bgcolor=color.gray, text_color=color.white)
    table.cell(main_table, 1, 0, "Value", bgcolor=color.gray, text_color=color.white)

    table.cell(main_table, 0, 1, "Trend (EMA 200)", text_halign=text.align_left)
    table.cell(main_table, 1, 1, is_bullish_trend ? "BULLISH" : is_bearish_trend ? "BEARISH" : "NEUTRAL",
               bgcolor=is_bullish_trend ? color.new(color.green, 70) : is_bearish_trend ? color.new(color.red, 70) : color.new(color.gray, 70))

    table.cell(main_table, 0, 2, "Momentum (RSI)", text_halign=text.align_left)
    table.cell(main_table, 1, 2, str.tostring(rsi_val, "#.##"),
               bgcolor=is_bullish_mom ? color.new(color.green, 70) : is_bearish_mom ? color.new(color.red, 70) : color.new(color.gray, 70))

    table.cell(main_table, 0, 3, "Volatility", text_halign=text.align_left)
    table.cell(main_table, 1, 3, stdev_val > stdev_sma ? "EXPANDING" : "CONTRACTING",
               bgcolor=stdev_val > stdev_sma ? color.new(color.aqua, 70) : color.new(color.orange, 70))
