//@version=6
indicator("Ultimate Gold Strategy 2026 [Trade with Pat]", overlay = true, max_boxes_count = 500, max_labels_count = 500)

// --- Inputs ---
pivot_len = input.int(5, "Pivot Length", minval = 1)
fvg_min_size_perc = input.float(0.01, "FVG Min Size (%)", minval = 0.0, step = 0.01)
show_pd_levels = input.bool(true, "Show Previous Day Levels")
show_fvgs = input.bool(true, "Show FVGs")

// --- Support & Resistance (Pivots) ---
ph = ta.pivothigh(pivot_len, pivot_len)
pl = ta.pivotlow(pivot_len, pivot_len)

var float last_resistance = na
var float last_support = na

if not na(ph)
    last_resistance := ph

if not na(pl)
    last_support := pl

// --- Fair Value Gaps (FVG) ---
is_bullish_fvg = low > high[2] and (low - high[2]) > close * (fvg_min_size_perc / 100)
is_bearish_fvg = high < low[2] and (low[2] - high) > close * (fvg_min_size_perc / 100)

if show_fvgs
    if is_bullish_fvg
        box.new(bar_index[2], low, bar_index, high[2], bgcolor = color.new(color.green, 80), border_color = na)
    if is_bearish_fvg
        box.new(bar_index[2], low[2], bar_index, high, bgcolor = color.new(color.red, 80), border_color = na)

// --- Premium/Discount Zones (PDH/PDL) ---
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
equilibrium = (pdh + pdl) / 2

is_in_discount = close < equilibrium
is_in_premium = close > equilibrium

// --- Signal Confluence logic ---
// Buy = Price in Discount + Support retest within 5 bars + Bullish FVG
// Sell = Price in Premium + Resistance retest within 5 bars + Bearish FVG

support_retest = low <= last_support and close > last_support
resistance_retest = high >= last_resistance and close < last_resistance

var int last_support_retest_bar = -100
var int last_resistance_retest_bar = -100

if support_retest
    last_support_retest_bar := bar_index
if resistance_retest
    last_resistance_retest_bar := bar_index

support_retested_recently = (bar_index - last_support_retest_bar) <= 5
resistance_retested_recently = (bar_index - last_resistance_retest_bar) <= 5

buy_signal = is_in_discount and support_retested_recently and is_bullish_fvg
sell_signal = is_in_premium and resistance_retested_recently and is_bearish_fvg

// --- Visuals ---
plot(show_pd_levels ? pdh : na, "PDH", color = color.new(color.gray, 50), style = plot.style_linebr)
plot(show_pd_levels ? pdl : na, "PDL", color = color.new(color.gray, 50), style = plot.style_linebr)
plot(show_pd_levels ? equilibrium : na, "Equilibrium", color = color.new(color.blue, 50), style = plot.style_linebr)

plotshape(buy_signal, "Buy Signal", shape.labelup, location.belowbar, color.green, text = "BUY", textcolor = color.white, size = size.small)
plotshape(sell_signal, "Sell Signal", shape.labeldown, location.abovebar, color.red, text = "SELL", textcolor = color.white, size = size.small)

// Alerts
alertcondition(buy_signal, "Buy Signal", "Ultimate Gold Strategy: BUY Signal")
alertcondition(sell_signal, "Sell Signal", "Ultimate Gold Strategy: SELL Signal")
