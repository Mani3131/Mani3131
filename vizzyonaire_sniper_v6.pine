//@version=6
indicator("Vizzyonaire Sniper Indicator", "Viz Sniper", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// --- Inputs ---
group_signals = "Signal Settings"
sensitivity = input.int(2, "Signal Sensitivity", minval = 1, maxval = 5, group = group_signals)
cleanup_on_tp = input.bool(true, "Cleanup Signals After TP", group = group_signals)

group_visuals = "Visual Settings"
show_watermark = input.bool(true, "Show Watermark", group = group_visuals)
watermark_text = input.string("XAUUSD", "Watermark Text", group = group_visuals)
watermark_col = input.color(color.new(color.gray, 85), "Watermark Color", group = group_visuals)
long_col      = input.color(color.green, "Long Signal Color", group = group_visuals)
short_col     = input.color(color.red, "Short Signal Color", group = group_visuals)
tp_col        = input.color(color.new(color.orange, 20), "TP Line Color", group = group_visuals)

// --- Watermark ---
var table watermark_table = table.new(position.middle_center, 1, 1)
if barstate.isfirst and show_watermark
    table.cell(watermark_table, 0, 0, watermark_text, text_color = watermark_col, text_size = size.huge)

// --- Supply & Demand Logic ---
// Definitions based on memory: ERC (Exciting) body >= 50% of span, Boring < 50%.
candle_span = high - low
candle_body = math.abs(close - open)
is_erc      = candle_span > 0 and candle_body >= (0.5 * candle_span)
is_boring   = not is_erc

// ATR for normalization
atr_val = ta.atr(14)

// Zone Variables
var float demand_proximal = float(na)
var float demand_distal   = float(na)
var float supply_proximal = float(na)
var float supply_distal   = float(na)

// Detection logic for DBR (Drop-Base-Rally)
// We look for: Leg-in (optional but good), 1-3 boring candles (base), then ERC leg-out (bullish)
is_leg_out_bull = is_erc and close > open
is_base_1       = is_boring[1]
is_base_2       = is_boring[1] and is_boring[2]
is_base_3       = is_boring[1] and is_boring[2] and is_boring[3]

bool is_dbr = false
if is_leg_out_bull and barstate.isconfirmed
    if is_base_1 and not is_boring[2]
        is_dbr := true
        demand_proximal := high[1]
        demand_distal   := low[1]
    else if is_base_2 and not is_boring[3]
        is_dbr := true
        demand_proximal := math.max(high[1], high[2])
        demand_distal   := math.min(low[1], low[2])
    else if is_base_3 and not is_boring[4]
        is_dbr := true
        demand_proximal := math.max(high[1], math.max(high[2], high[3]))
        demand_distal   := math.min(low[1], math.min(low[2], low[3]))

// Detection logic for RBD (Rally-Base-Drop)
is_leg_out_bear = is_erc and close < open
bool is_rbd = false
if is_leg_out_bear and barstate.isconfirmed
    if is_base_1 and not is_boring[2]
        is_rbd := true
        supply_proximal := low[1]
        supply_distal   := high[1]
    else if is_base_2 and not is_boring[3]
        is_rbd := true
        supply_proximal := math.min(low[1], low[2])
        supply_distal   := math.max(high[1], high[2])
    else if is_base_3 and not is_boring[4]
        is_rbd := true
        supply_proximal := math.min(low[1], math.min(low[2], low[3]))
        supply_distal   := math.max(high[1], math.max(high[2], high[3]))

// --- Signal Logic ---
// Signals are generated when an ERC leg-out confirms a zone.
// To avoid repaint, we check 'is_dbr' and 'is_rbd' which are based on confirmed bars.

bool signal_long  = is_dbr
bool signal_short = is_rbd

// --- Active Trade Tracking ---
var float active_sl  = na
var float active_tp1 = na
var float active_tp2 = na
var float active_tp3 = na
var int   active_dir = 0 // 1 for Long, -1 for Short

var label[] active_labels = array.new_label()
var line[]  active_lines  = array.new_line()

// Helper to clear active drawings
clear_drawings() =>
    if array.size(active_labels) > 0
        for i = 0 to array.size(active_labels) - 1
            label.delete(array.get(active_labels, i))
        array.clear(active_labels)
    if array.size(active_lines) > 0
        for i = 0 to array.size(active_lines) - 1
            line.delete(array.get(active_lines, i))
        array.clear(active_lines)

// Monitor active trade
if cleanup_on_tp and active_dir != 0
    tp_hit = (active_dir == 1 and high >= active_tp1) or (active_dir == -1 and low <= active_tp1)
    sl_hit = (active_dir == 1 and low <= active_sl) or (active_dir == -1 and high >= active_sl)

    if tp_hit or sl_hit
        clear_drawings()
        active_dir := 0
        active_sl  := na
        active_tp1 := na
        active_tp2 := na
        active_tp3 := na

// --- Signal Labels ---
if signal_long and barstate.isconfirmed
    // Reset previous if needed (optional, here we only allow one active signal for cleanup)
    if cleanup_on_tp
        clear_drawings()

    lbl = label.new(bar_index, low, "SNIPER LONG", color = long_col, textcolor = color.white, style = label.style_label_up, yloc = yloc.belowbar)
    vln = line.new(bar_index, low, bar_index, high, color = color.new(color.yellow, 50), style = line.style_dashed, extend = extend.both)

    if cleanup_on_tp
        array.push(active_labels, lbl)
        array.push(active_lines, vln)

if signal_short and barstate.isconfirmed
    if cleanup_on_tp
        clear_drawings()

    lbl = label.new(bar_index, high, "SNIPER SHORT", color = short_col, textcolor = color.white, style = label.style_label_down, yloc = yloc.abovebar)
    vln = line.new(bar_index, high, bar_index, low, color = color.new(color.yellow, 50), style = line.style_dashed, extend = extend.both)

    if cleanup_on_tp
        array.push(active_labels, lbl)
        array.push(active_lines, vln)

// --- TP / SL Logic & Visuals ---
if signal_long and barstate.isconfirmed
    sl = demand_distal
    risk = close - sl
    if risk > 0
        tp1 = close + risk * 1.0
        tp2 = close + risk * 2.0
        tp3 = close + risk * 4.0

        l1 = line.new(bar_index, tp1, bar_index + 10, tp1, color = tp_col, width = 2)
        lb1 = label.new(bar_index + 10, tp1, "TP1", style = label.style_none, textcolor = tp_col, size = size.small)

        l2 = line.new(bar_index, tp2, bar_index + 10, tp2, color = tp_col, width = 2)
        lb2 = label.new(bar_index + 10, tp2, "TP2", style = label.style_none, textcolor = tp_col, size = size.small)

        l3 = line.new(bar_index, tp3, bar_index + 10, tp3, color = tp_col, width = 2)
        lb3 = label.new(bar_index + 10, tp3, "TP3", style = label.style_none, textcolor = tp_col, size = size.small)

        if cleanup_on_tp
            active_dir := 1
            active_sl  := sl
            active_tp1 := tp1
            active_tp2 := tp2
            active_tp3 := tp3
            array.push(active_lines, l1)
            array.push(active_lines, l2)
            array.push(active_lines, l3)
            array.push(active_labels, lb1)
            array.push(active_labels, lb2)
            array.push(active_labels, lb3)

// --- Zone Visuals ---
if is_dbr and barstate.isconfirmed
    z1 = line.new(bar_index - 5, demand_proximal, bar_index, demand_proximal, color = long_col, width = 2)
    z2 = line.new(bar_index - 5, demand_distal,   bar_index, demand_distal,   color = long_col, width = 2)
    if cleanup_on_tp
        array.push(active_lines, z1)
        array.push(active_lines, z2)

if is_rbd and barstate.isconfirmed
    z1 = line.new(bar_index - 5, supply_proximal, bar_index, supply_proximal, color = short_col, width = 2)
    z2 = line.new(bar_index - 5, supply_distal,   bar_index, supply_distal,   color = short_col, width = 2)
    if cleanup_on_tp
        array.push(active_lines, z1)
        array.push(active_lines, z2)

if signal_short and barstate.isconfirmed
    sl = supply_distal
    risk = sl - close
    if risk > 0
        tp1 = close - risk * 1.0
        tp2 = close - risk * 2.0
        tp3 = close - risk * 4.0

        l1 = line.new(bar_index, tp1, bar_index + 10, tp1, color = tp_col, width = 2)
        lb1 = label.new(bar_index + 10, tp1, "TP1", style = label.style_none, textcolor = tp_col, size = size.small)

        l2 = line.new(bar_index, tp2, bar_index + 10, tp2, color = tp_col, width = 2)
        lb2 = label.new(bar_index + 10, tp2, "TP2", style = label.style_none, textcolor = tp_col, size = size.small)

        l3 = line.new(bar_index, tp3, bar_index + 10, tp3, color = tp_col, width = 2)
        lb3 = label.new(bar_index + 10, tp3, "TP3", style = label.style_none, textcolor = tp_col, size = size.small)

        if cleanup_on_tp
            active_dir := -1
            active_sl  := sl
            active_tp1 := tp1
            active_tp2 := tp2
            active_tp3 := tp3
            array.push(active_lines, l1)
            array.push(active_lines, l2)
            array.push(active_lines, l3)
            array.push(active_labels, lb1)
            array.push(active_labels, lb2)
            array.push(active_labels, lb3)
