//@version=6
indicator("Wyckoff Accumulation & Distribution Phases [Mani3131]", overlay=true, max_labels_count=500, max_boxes_count=500)

// --- Inputs ---
pivot_len = input.int(5, "Pivot Length", minval=1)
vol_ma_len = input.int(20, "Volume MA Length", minval=1)
vol_threshold = input.float(1.5, "High Volume Threshold (x MA)", minval=1.0, step=0.1)

// --- Styling ---
color_phase_a = input.color(color.new(color.gray, 50), "Phase A Color")
color_phase_b = input.color(color.new(color.blue, 50), "Phase B Color")
color_phase_c = input.color(color.new(color.yellow, 50), "Phase C Color")
color_phase_d = input.color(color.new(color.green, 50), "Phase D Color")
color_sc = input.color(color.red, "Selling Climax Label")
color_ar = input.color(color.green, "Automatic Rally Label")
color_sos = input.color(color.lime, "Sign of Strength Label")

// --- Technical Calculations ---
vol_ma = ta.sma(volume, vol_ma_len)
is_high_volume = volume > vol_ma * vol_threshold

pivot_high = ta.pivothigh(high, pivot_len, pivot_len)
pivot_low = ta.pivotlow(low, pivot_len, pivot_len)

// --- State Variables ---
var string current_phase = "None"
var float range_high = na
var float range_low = na
var float range_mid = na

var int sc_index = na
var float sc_price = na
var int ar_index = na
var float ar_price = na
var int st_index = na
var float st_price = na

var int spring_index = na
var float spring_price = na
var bool phase_c_triggered = false
var bool phase_d_triggered = false

// --- Phase A: Stopping Action Detection ---
// 1. Detect Selling Climax (SC)
// Typically a sharp drop with high volume followed by a pivot low
if na(sc_price) and pivot_low
    // Check if the preceding move was a markdown (simple check: lower highs/lows or RSI oversold)
    // For simplicity, we look for a significant pivot low with high volume in the vicinity
    if is_high_volume or is_high_volume[pivot_len]
        sc_price := pivot_low
        sc_index := bar_index[pivot_len]
        current_phase := "A"
        label.new(sc_index, sc_price, "SC", style=label.style_label_up, color=color_sc, textcolor=color.white)

// 2. Detect Automatic Rally (AR)
// The first significant high after SC
if not na(sc_price) and na(ar_price) and pivot_high and bar_index[pivot_len] > sc_index
    ar_price := pivot_high
    ar_index := bar_index[pivot_len]
    range_high := ar_price
    range_low := sc_price
    range_mid := (range_high + range_low) / 2
    label.new(ar_index, ar_price, "AR", style=label.style_label_down, color=color_ar, textcolor=color.white)

// 3. Detect Secondary Test (ST)
// Price returning to sc_price area
if not na(ar_price) and na(st_price) and pivot_low and bar_index[pivot_len] > ar_index
    if low[pivot_len] <= sc_price * 1.1 // within 10% of SC
        st_price := pivot_low
        st_index := bar_index[pivot_len]
        label.new(st_index, st_price, "ST", style=label.style_label_up, color=color_phase_a, textcolor=color.white)
        current_phase := "B"

// --- Phase B: Building a Cause ---
// Phase B is mostly sideways. We can transition to Phase C if we see a significant test of the low.

// --- Phase C: The Final Test (Spring) ---
if current_phase == "B" and not phase_c_triggered and pivot_low
    // A spring often dips below SC/ST and recovers
    if low[pivot_len] < range_low * 1.05 // Near or below range low
        spring_price := pivot_low
        spring_index := bar_index[pivot_len]
        phase_c_triggered := true
        current_phase := "C"
        label.new(spring_index, spring_price, "Spring/Test", style=label.style_label_up, color=color_phase_c, textcolor=color.black)

// --- Phase D: Trend Action ---
if current_phase == "C" and not phase_d_triggered
    // Transition to Phase D when price breaks range_mid or shows Sign of Strength
    if close > range_mid and ta.crossover(close, range_mid)
        phase_d_triggered := true
        current_phase := "D"
        label.new(bar_index, high, "Phase D Start", style=label.style_label_down, color=color_phase_d, textcolor=color.white)

// Visualizing the range once established
var box trading_range_box = na
if not na(range_high) and not na(range_low)
    if na(trading_range_box)
        trading_range_box := box.new(sc_index, range_high, bar_index, range_low, border_color=color_phase_a, bgcolor=color.new(color_phase_a, 90))
    else
        box.set_right(trading_range_box, bar_index)
        // Update color based on phase
        box.set_border_color(trading_range_box, current_phase == "A" ? color_phase_a : current_phase == "B" ? color_phase_b : current_phase == "C" ? color_phase_c : color_phase_d)
        box.set_bgcolor(trading_range_box, color.new(current_phase == "A" ? color_phase_a : current_phase == "B" ? color_phase_b : current_phase == "C" ? color_phase_c : color_phase_d, 90))

// Background coloring for phases
phase_bg_color = current_phase == "A" ? color.new(color_phase_a, 95) :
                 current_phase == "B" ? color.new(color_phase_b, 95) :
                 current_phase == "C" ? color.new(color_phase_c, 95) :
                 current_phase == "D" ? color.new(color_phase_d, 95) :
                 na
bgcolor(phase_bg_color)

plot(range_high, "Range High", color=color.new(color_phase_a, 50), style=plot.style_linebr)
plot(range_low, "Range Low", color=color.new(color_phase_a, 50), style=plot.style_linebr)
plot(range_mid, "Equilibrium", color=color.new(color.gray, 80), style=plot.style_linebr)

// --- Tactical Entry Signals ---

// 1. Phase C: Low Test Reversal
// Spotting a successful test of the low in Phase C
is_phase_c_entry = current_phase == "C" and pivot_low and low[pivot_len] >= spring_price
if is_phase_c_entry
    label.new(bar_index[pivot_len], low[pivot_len], "Entry: Phase C Test", style=label.style_label_up, color=color.new(color_phase_c, 0), textcolor=color.black)

// 2. Phase D: Sign of Strength (SOS)
// Elongated bars with high volume breaking local resistance
is_sos = current_phase == "D" and close > open and (high - low) > ta.atr(14) * 1.5 and volume > vol_ma
if is_sos
    label.new(bar_index, low, "SOS", style=label.style_label_up, color=color_sos, textcolor=color.black)

// 3. Backing-Up (BU) Action
// Retest of the old range high as support
var bool breakout_occurred = false
if current_phase == "D" and ta.crossover(close, range_high)
    breakout_occurred := true

is_bu_action = breakout_occurred and ta.crossunder(low, range_high * 1.02) and close > range_high and pivot_low
if is_bu_action
    label.new(bar_index[pivot_len], low[pivot_len], "Entry: BU Retest", style=label.style_label_up, color=color.new(color_phase_d, 0), textcolor=color.white)
    breakout_occurred := false // Reset after detection
