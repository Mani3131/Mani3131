//@version=6
// This indicator implements a non-repainting Heatmap and Volume Profile based on market consolidation zones.
// It identifies periods of price consolidation, calculates the volume distribution (heatmap) within those periods,
// and displays metadata such as total volume value, price bins, and percentage of the global profile.
indicator("[UAlgo] XAUUSD Heatmap v6", shorttitle="[UAlgo] Heatmap", overlay = true, max_boxes_count = 500, max_labels_count = 500)

// ==========================================
// Custom Functions (Fallbacks for compatibility)
// ==========================================
f_array_argmax(float[] arr) =>
    int best_idx = 0
    float max_val = -1.0e30
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            float val = array.get(arr, i)
            if val > max_val
                max_val := val
                best_idx := i
    best_idx

// ==========================================
// Inputs
// ==========================================
grp_zones = "Consolidation Zones"
min_bars = input.int(20, "Min Consolidation Bars", minval = 5, group = grp_zones)
range_atr_mult = input.float(1.5, "Range Multiplier (ATR)", step = 0.1, group = grp_zones)

grp_visuals = "Visuals"
heatmap_bins = input.int(20, "Heatmap Bins per Zone", minval = 5, maxval = 50, group = grp_visuals)
global_lookback = input.int(500, "Global Profile Lookback", minval = 100, group = grp_visuals)
hot_color = input.color(#ff5252, "Hot Color (Highest Vol)", group = grp_visuals)
mid_color = input.color(#ffd700, "Mid Color", group = grp_visuals)
cold_color = input.color(#4caf50, "Cold Color (Lowest Vol)", group = grp_visuals)
show_labels = input.bool(true, "Show Metadata Labels", group = grp_visuals)
poc_color = input.color(color.yellow, "POC Line Color", group = grp_visuals)

// ==========================================
// Calculations (Must be executed on every bar)
// ==========================================
float atr = ta.atr(14)
float threshold = (nz(atr) != 0 ? atr : close * 0.001) * range_atr_mult

float hi_min = ta.highest(high, min_bars)
float lo_min = ta.lowest(low, min_bars)
float current_range = hi_min - lo_min
bool is_consolidating = current_range < threshold

float g_hi = ta.highest(high, global_lookback)
float g_lo = ta.lowest(low, global_lookback)
float g_vol_sum = ta.sum(volume, global_lookback)
float vol_sum_min = ta.sum(volume, min_bars)

// POC Calculation logic
float global_poc = na
if bar_index > global_lookback
    float s = (g_hi - g_lo) / 50
    if s > 0
        float[] v_array = array.new_float(50, 0.0)
        for i = 0 to global_lookback - 1
            float p = close[i]
            int idx = math.max(0, math.min(49, math.floor((p - g_lo) / s)))
            array.set(v_array, idx, array.get(v_array, idx) + volume[i])
        int p_idx = f_array_argmax(v_array)
        global_poc := g_lo + (p_idx + 0.5) * s

plot(global_poc, "Global POC", color = color.new(poc_color, 20), linewidth = 2, style = plot.style_stepline)

// ==========================================
// Variables & State
// ==========================================
var int z_start_idx = na
var float z_hi = na
var float z_lo = na
var float z_vol = 0.0
var box active_zone_box = na

// ==========================================
// Zone & Heatmap Logic
// ==========================================
if is_consolidating
    if na(z_start_idx)
        z_start_idx := bar_index - min_bars + 1
        z_hi := hi_min
        z_lo := lo_min
        z_vol := vol_sum_min
    else
        z_hi := math.max(z_hi, high)
        z_lo := math.min(z_lo, low)
        z_vol += volume

    // Update or create active zone box for visual feedback
    if barstate.islast
        if na(active_zone_box)
            active_zone_box := box.new(z_start_idx, z_hi, bar_index, z_lo, border_color = color.new(color.gray, 50), bgcolor = color.new(color.gray, 90))
        else
            box.set_lefttop(active_zone_box, z_start_idx, z_hi)
            box.set_rightbottom(active_zone_box, bar_index, z_lo)
else
    // Consolidation broken
    if not na(z_start_idx)
        int z_end_idx = bar_index - 1
        int duration = z_end_idx - z_start_idx + 1

        if duration >= min_bars and barstate.isconfirmed
            float z_range = z_hi - z_lo
            if z_range > 0
                float bin_size = z_range / heatmap_bins
                float[] zone_vols = array.new_float(heatmap_bins, 0.0)

                for i = 0 to duration - 1
                    int target_bar = z_start_idx + i
                    int offset = bar_index - target_bar
                    float p = close[offset]
                    float v = volume[offset]
                    int b_idx = math.max(0, math.min(heatmap_bins - 1, math.floor((p - z_lo) / bin_size)))
                    array.set(zone_vols, b_idx, array.get(zone_vols, b_idx) + v)

                float max_zv = array.max(zone_vols)
                float zone_v_pct = (z_vol / (g_vol_sum > 0 ? g_vol_sum : 1.0)) * 100

                for j = 0 to heatmap_bins - 1
                    float v_val = array.get(zone_vols, j)
                    if v_val > 0
                        float b_lo = z_lo + j * bin_size
                        float b_hi = b_lo + bin_size
                        float ratio = v_val / (max_zv > 0 ? max_zv : 1.0)
                        color c = ratio > 0.6 ? color.from_gradient(ratio, 0.6, 1.0, mid_color, hot_color) : color.from_gradient(ratio, 0.0, 0.6, cold_color, mid_color)
                        box.new(z_start_idx, b_hi, z_end_idx, b_lo, bgcolor = color.new(c, 50), border_color = color.new(color.white, 100))

                box.new(z_start_idx, z_hi, z_end_idx, z_lo, bgcolor = color.new(color.gray, 100), border_color = color.new(color.yellow, 70), border_width = 1)

                if show_labels
                    int tick_bins = math.round(z_range / (syminfo.mintick > 0 ? syminfo.mintick : 0.01))
                    string label_text = str.format("${0}B\n{1} bins · {2}% of profile\n{3} - {4}", str.tostring(z_vol * close / 1e9, "#.###"), tick_bins, str.tostring(zone_v_pct, "#.##"), str.tostring(z_lo, "#.##"), str.tostring(z_hi, "#.##"))
                    label.new(z_start_idx, z_hi, label_text, textcolor = color.white, color = color.new(color.black, 20), style = label.style_label_down, size = size.small, textalign = text.align_left)

        // Cleanup active box and reset state
        if not na(active_zone_box)
            box.delete(active_zone_box)
            active_zone_box := na
        z_start_idx := na
        z_vol := 0.0
        z_hi := na
        z_lo := na
